---
// The frame around every page: the <head>, the shared styles and the footer.
// A page uses it like:  <BaseLayout title="About"> ...page content... </BaseLayout>
import '../styles/global.css';
import '../styles/motion.css';
import SiteFooter from '../components/SiteFooter.astro';
import Arrival from '../components/Arrival.astro';

interface Props { title?: string; description?: string; footer?: boolean; noindex?: boolean; image?: string; arrival?: boolean }
const {
  title,
  footer = true,
  noindex = false,
  arrival = true,
  image = '/images/folios-photo-2-1200.jpg',
  description = 'An independent journal of craft, discernment and the reclaimed hearth.',
} = Astro.props;
const fullTitle = title ? `${title} · Overgrown Altar` : 'Overgrown Altar';
const site = Astro.site ?? new URL('https://overgrownaltar.com');
const pageUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />

    <!-- How the page looks when shared in messages and on social media -->
    <meta property="og:site_name" content="Overgrown Altar" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title ?? 'Overgrown Altar'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- The OA monogram in browser tabs and on phone home screens -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#060806" />

    <link rel="preload" href="/fonts/cormorant-500.ttf" as="font" type="font/ttf" crossorigin />
    {Astro.url.pathname === '/' && (
      <!-- Members arriving at the front door (typed, bookmarked, or from another site) go straight to their Desk,
           before anything is drawn. Coming from inside the site, or with ?home, the homepage shows as usual. -->
      <script is:inline>
        try {
          var t = JSON.parse(localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token') || 'null');
          var fromSite = document.referrer && new URL(document.referrer).origin === location.origin;
          if (t && t.refresh_token && !fromSite && !/[?&]home\b/.test(location.search)) location.replace('/guild/desk/');
        } catch (e) {}
      </script>
    )}
    {arrival && (
      <script is:inline>
        try {
          if (!localStorage.getItem('oa_arrived') && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.arrive = '1';
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    {arrival && <Arrival />}
    <a class="skip" href="#main">Skip to content</a>
    <main id="main">
      <slot />  <!-- the page's own content goes here -->
    </main>
    {footer && <SiteFooter />}

    <script>
      // Share buttons: the phone's share sheet, or copy the link on a computer.
      document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
        const data = { title: document.title, url: location.href };
        try {
          if (navigator.share) await navigator.share(data);
          else { await navigator.clipboard.writeText(location.href); const el = b.querySelector('span') ?? b; const t = el.textContent; el.textContent = 'Link copied'; setTimeout(() => (el.textContent = t), 1800); }
        } catch {}
      }));

      // Pull to refresh, on touch screens: pull down at the very top of a page, and let go once the ring is full.
      // The site's own version replaces the browser's, so it behaves the same everywhere (including Home Screen apps).
      // It stays out of the way while writing or typing, so a stray pull can never lose words.
      if (matchMedia('(pointer: coarse)').matches) {
        document.documentElement.classList.add('ptr-on');
        const ring = document.createElement('div');
        ring.className = 'ptr'; ring.setAttribute('aria-hidden', 'true');
        ring.innerHTML = '<svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="15" class="ptr-track"/><circle cx="20" cy="20" r="15" class="ptr-fill" pathLength="1"/><path d="M20 12v16M14.5 17.5h11" class="ptr-cross"/></svg>';
        document.body.append(ring);
        const FULL = 90;
        let startY = 0, pull = 0, active = false;
        const busy = () => {
          const el = document.activeElement as HTMLElement | null;
          return document.documentElement.classList.contains('menu-open') || !!document.querySelector('.d-room.writing, .pv')
            || !!(el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)));
        };
        const draw = () => {
          const k = Math.min(pull / FULL, 1);
          ring.style.transform = `translate(-50%, ${Math.min(pull, FULL + 20) * 0.9 - 56}px)`;
          ring.style.opacity = String(Math.min(1, pull / 40));
          ring.style.setProperty('--k', String(k));
          ring.classList.toggle('ready', k >= 1);
        };
        addEventListener('touchstart', (e) => {
          active = scrollY <= 0 && e.touches.length === 1 && !busy();
          startY = e.touches[0].clientY; pull = 0;
        }, { passive: true });
        addEventListener('touchmove', (e) => {
          if (!active) return;
          const d = e.touches[0].clientY - startY;
          if (d <= 0 || scrollY > 0) { pull = 0; draw(); return; }
          pull = d * 0.55; draw();
        }, { passive: true });
        addEventListener('touchend', () => {
          if (!active) return; active = false;
          if (pull >= FULL) { ring.classList.add('spin'); setTimeout(() => location.reload(), 250); return; }
          pull = 0; ring.style.transition = 'transform .35s cubic-bezier(.16,1,.3,1), opacity .25s'; draw();
          setTimeout(() => (ring.style.transition = ''), 400);
        });
      }

      // Filter rows scroll sideways on phones: a round arrow at the end shows there is more, and moves the row along.
      // It goes once the row is at its end (or everything fits). Rows the page draws later (the Guild pages) get one too.
      const hintRows = () => document.querySelectorAll<HTMLElement>('.filters').forEach((row) => {
        let wrap = row.parentElement!;
        if (!wrap.classList.contains('filters-wrap')) {
          if (row.closest('[data-reactroot], .m-page')) return;   // React draws its own wrapper
          wrap = document.createElement('div'); wrap.className = 'filters-wrap';
          row.replaceWith(wrap); wrap.append(row);
        }
        let more = wrap.querySelector<HTMLButtonElement>(':scope > .filters-more');
        if (!more) {
          more = document.createElement('button'); more.type = 'button'; more.className = 'filters-more'; more.setAttribute('aria-label', 'More choices');
          more.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
          wrap.append(more);
        }
        if (!wrap.dataset.ready) {
          wrap.dataset.ready = '1';
          const check = () => { wrap.dataset.end = String(row.scrollLeft + row.clientWidth >= row.scrollWidth - 8); };
          row.addEventListener('scroll', check, { passive: true }); addEventListener('resize', check);
          more.addEventListener('click', () => row.scrollBy({ left: row.clientWidth * 0.7, behavior: 'smooth' }));
          check();
        }
      });
      hintRows();
      let hintQueued = false;
      new MutationObserver(() => { if (hintQueued) return; hintQueued = true; requestAnimationFrame(() => { hintQueued = false; hintRows(); }); })
        .observe(document.body, { childList: true, subtree: true });

      // A photograph opens full size: links marked data-zoom (a photography piece's smaller photographs).
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-zoom]');
        if (!link || e.metaKey || e.ctrlKey) return;
        e.preventDefault();
        const box = document.createElement('div'); box.className = 'zoom'; box.setAttribute('role', 'dialog'); box.setAttribute('aria-modal', 'true');
        const img = document.createElement('img'); img.src = link.href; img.alt = link.dataset.caption || '';
        const close = document.createElement('button'); close.type = 'button'; close.setAttribute('aria-label', 'Close'); close.textContent = '×';
        box.append(img); if (link.dataset.caption) { const p = document.createElement('p'); p.textContent = link.dataset.caption; box.append(p); }
        box.append(close);
        const shut = () => { box.remove(); removeEventListener('keydown', key); link.focus(); };
        const key = (k: KeyboardEvent) => { if (k.key === 'Escape') shut(); };
        box.addEventListener('click', shut); addEventListener('keydown', key);
        document.body.append(box); close.focus();
      });

      // Writers' pictures stay current: pages are built ahead of time, so when a writer changes their portrait,
      // each picture marked data-author-id asks Supabase for the latest one as the page opens (one small request).
      const marked = [...document.querySelectorAll<HTMLElement>('[data-author-id]')].filter((el) => el.dataset.authorId);
      if (marked.length) {
        const ids = [...new Set(marked.map((el) => el.dataset.authorId!))];
        const base = 'https://zblgggifysohxqtgvgxs.supabase.co', key = 'sb_publishable_84SLMdb_AiDAbaiz1eitbw_DRMx38lH';
        fetch(`${base}/rest/v1/profiles?select=id,portrait_path&id=in.(${ids.join(',')})`, { headers: { apikey: key } })
          .then((r) => (r.ok ? r.json() : []))
          .then((rows: { id: string; portrait_path: string | null }[]) => {
            for (const row of rows) {
              if (!row.portrait_path) continue;
              const src = `${base}/storage/v1/object/public/portraits/${row.portrait_path.split('/').map(encodeURIComponent).join('/')}`;
              for (const el of marked.filter((m) => m.dataset.authorId === row.id)) {
                const img = el.querySelector('img');
                if (img) { if (img.src !== src) img.src = src; }
                else { const n = new Image(); n.src = src; n.alt = ''; el.textContent = ''; el.append(n); }
              }
            }
          })
          .catch(() => {});
      }

      // Motion that needs to know where things are on screen. Styles live in src/styles/motion.css.
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!calm) {
        // Sections fade up as they scroll into view. Only things below the fold are hidden first,
        // so nothing you can already see ever blinks.
        const picks = document.querySelectorAll(
          'main .sec > :not(.g2, .g3, .g4, .side, .hin, .glass-light, .glow, .narrow), main .g2 > *, main .g3 > *, main .g4 > *, main .side > *, main .narrow > *, main .hin > *, main .mx'
        );
        const seen = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        picks.forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight || el.closest('.reveal')) return;
          const i = [...el.parentElement!.children].indexOf(el);
          (el as HTMLElement).style.setProperty('--d', `${(i % 4) * 80}ms`);
          el.classList.add('reveal');
          seen.observe(el);
        });
      }
    </script>
  </body>
</html>
