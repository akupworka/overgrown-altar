---
// The frame around every page: the <head>, the shared styles and the footer.
// A page uses it like:  <BaseLayout title="About"> ...page content... </BaseLayout>
import '../styles/global.css';
import '../styles/motion.css';
import SiteFooter from '../components/SiteFooter.astro';
import Arrival from '../components/Arrival.astro';

interface Props { title?: string; description?: string; footer?: boolean; noindex?: boolean; image?: string; arrival?: boolean }
const {
  title,
  footer = true,
  noindex = false,
  arrival = true,
  image = '/images/share.jpg',   // the site's own share card (src/pages/images/share.jpg.ts)
  description = 'An independent journal of craft, discernment and the reclaimed hearth.',
} = Astro.props;
const fullTitle = title ? `${title} · Overgrown Altar` : 'Overgrown Altar';
const site = Astro.site ?? new URL('https://overgrownaltar.com');
const pageUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={pageUrl} />

    <!-- How the page looks when shared in messages and on social media -->
    <meta property="og:site_name" content="Overgrown Altar" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title ?? 'Overgrown Altar'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- The OA monogram in browser tabs and on phone home screens -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#060806" />
    <!-- Added to a phone's home screen, the site opens full-screen like an app -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Browsers that can (Chrome) get the Desk and the Guild's pages ready the moment the pointer heads for them -->
    <!-- The Guild's rooms are made ready when the mouse rests on their links, but never a conversation, a thread or a
         piece: opening those marks them read, and that must wait for a real click. -->
    <script type="speculationrules" is:inline>{"prerender":[{"where":{"and":[{"href_matches":["/guild/desk/*","/guild/members/*"]},{"not":{"href_matches":"/*\\?*(^|&)(dm|t|p)=*"}}]},"eagerness":"moderate"}]}</script>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="The Guild" />

    <link rel="preload" href="/fonts/cormorant-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/alte-haas-400.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Signed in to the Guild? Known before anything is drawn, so members never see the visitors' header flash by. -->
    <script is:inline>
      try {
        var oaT = JSON.parse(localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token') || 'null');
        if (oaT && oaT.refresh_token) {
          document.documentElement.setAttribute('data-member', '');
          var oaM = JSON.parse(localStorage.getItem('oa_member') || '{}');
          var oaV = localStorage.getItem('oa_view_as');   // the editor, seeing the site as a member or the Fellowship
          if (oaM.editor && !oaV) document.documentElement.setAttribute('data-editor', '');
          if (oaM.fellow || (oaM.editor && oaV === 'fellow')) document.documentElement.setAttribute('data-fellow', '');
          if (oaM.editor && oaV) document.documentElement.setAttribute('data-view-as', oaV);
        }
        // Reading comfort chosen on a piece (text size, night reading), before anything is drawn
        var oaR = JSON.parse(localStorage.getItem('oa_read') || '{}');
        if (oaR.size) document.documentElement.setAttribute('data-rs', String(oaR.size));
        if (oaR.night) document.documentElement.setAttribute('data-night', '');
      } catch (e) {}
    </script>
    {Astro.url.pathname === '/' && (
      <!-- Members arriving at the front door (typed, bookmarked, or from another site) go straight to their Desk,
           before anything is drawn. Coming from inside the site, or with ?home, the homepage shows as usual. -->
      <script is:inline>
        try {
          var t = JSON.parse(localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token') || 'null');
          var fromSite = document.referrer && new URL(document.referrer).origin === location.origin;
          if (t && t.refresh_token && !fromSite && !/[?&]home\b/.test(location.search)) location.replace('/guild/desk/');
        } catch (e) {}
      </script>
    )}
    {arrival && (
      <script is:inline>
        try {
          if (!localStorage.getItem('oa_arrived') && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.arrive = '1';
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    {arrival && <Arrival />}
    <a class="skip" href="#main">Skip to content</a>
    <main id="main">
      <slot />  <!-- the page's own content goes here -->
    </main>
    {footer && <SiteFooter />}

    <script>
      // Share buttons: the phone's share sheet, or copy the link on a computer.
      document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
        const data = { title: document.title, url: location.href };
        try {
          if (navigator.share) await navigator.share(data);
          else { await navigator.clipboard.writeText(location.href); const el = b.querySelector('span') ?? b; const t = el.textContent; el.textContent = 'Link copied'; setTimeout(() => (el.textContent = t), 1800); }
        } catch {}
      }));

      // Pull to refresh, on touch screens: pull down at the very top of a page, and let go once the ring is full.
      // The site's own version replaces the browser's, so it behaves the same everywhere (including Home Screen apps).
      // It stays out of the way while writing or typing, so a stray pull can never lose words.
      if (matchMedia('(pointer: coarse)').matches) {
        document.documentElement.classList.add('ptr-on');
        const ring = document.createElement('div');
        ring.className = 'ptr'; ring.setAttribute('aria-hidden', 'true');
        ring.innerHTML = '<svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="15" class="ptr-track"/><circle cx="20" cy="20" r="15" class="ptr-fill" pathLength="1"/><path d="M20 12v16M14.5 17.5h11" class="ptr-cross"/></svg>';
        document.body.append(ring);
        const FULL = 90;
        let startY = 0, startX = 0, pull = 0, active = false, decided = false;
        // Rows that scroll sideways (the members' bar, filters, the formatting tools…): a swipe there is never a pull.
        const SIDEWAYS = '.inner, .filters, .filters-wrap, .d-paper-tools, .d-tools-wrap, .ga-filters, .shelf-filters, .pager, .home-plates-row, .d-tabbar';
        const busy = () => {
          const el = document.activeElement as HTMLElement | null;
          return document.documentElement.classList.contains('menu-open') || !!document.querySelector('.d-room.writing, .pv, .ib-thread')
            || !!(el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)));
        };
        const draw = () => {
          const k = Math.min(pull / FULL, 1);
          ring.style.transform = `translate(-50%, ${Math.min(pull, FULL + 20) * 0.9 - 56}px)`;
          ring.style.opacity = String(Math.min(1, pull / 40));
          ring.style.setProperty('--k', String(k));
          ring.classList.toggle('ready', k >= 1);
        };
        addEventListener('touchstart', (e) => {
          const onSideways = !!(e.target as Element | null)?.closest?.(SIDEWAYS);
          active = scrollY <= 0 && e.touches.length === 1 && !busy() && !onSideways;
          startY = e.touches[0].clientY; startX = e.touches[0].clientX; pull = 0; decided = false;
        }, { passive: true });
        addEventListener('touchmove', (e) => {
          if (!active) return;
          const d = e.touches[0].clientY - startY, dx = Math.abs(e.touches[0].clientX - startX);
          // Decide once, after the finger has moved a little: only a clearly downward pull counts; a sideways swipe never does.
          if (!decided && (d > 12 || dx > 12)) {
            decided = true;
            if (dx > d * 0.6) { active = false; pull = 0; draw(); return; }
          }
          if (!decided) return;
          if (d <= 0 || scrollY > 0) { pull = 0; draw(); return; }
          pull = (d - 12) * 0.55; draw();
        }, { passive: true });
        addEventListener('touchend', () => {
          if (!active) return; active = false;
          const settle = () => { pull = 0; ring.style.transition = 'transform .35s cubic-bezier(.16,1,.3,1), opacity .25s'; draw(); setTimeout(() => (ring.style.transition = ''), 400); };
          if (pull >= FULL) {
            ring.classList.add('spin');
            // A page may answer the pull itself (Explore reshuffles); otherwise the page is loaded afresh.
            const own = !dispatchEvent(new CustomEvent('oa:pull', { cancelable: true }));
            if (own) setTimeout(() => { ring.classList.remove('spin'); settle(); }, 650);
            else setTimeout(() => location.reload(), 250);
            return;
          }
          settle();
        });
      }

      // Filter rows scroll sideways on phones: a round arrow at the end shows there is more, and moves the row along.
      // It goes once the row is at its end (or everything fits). Rows the page draws later (the Guild pages) get one too.
      const hintRows = () => document.querySelectorAll<HTMLElement>('.filters').forEach((row) => {
        let wrap = row.parentElement!;
        if (!wrap.classList.contains('filters-wrap')) {
          if (row.closest('[data-reactroot], .m-page')) return;   // React draws its own wrapper
          wrap = document.createElement('div'); wrap.className = 'filters-wrap';
          row.replaceWith(wrap); wrap.append(row);
        }
        let more = wrap.querySelector<HTMLButtonElement>(':scope > .filters-more');
        if (!more) {
          more = document.createElement('button'); more.type = 'button'; more.className = 'filters-more'; more.setAttribute('aria-label', 'More choices');
          more.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
          wrap.append(more);
        }
        if (!wrap.dataset.ready) {
          wrap.dataset.ready = '1';
          const check = () => { wrap.dataset.end = String(row.scrollLeft + row.clientWidth >= row.scrollWidth - 8); };
          row.addEventListener('scroll', check, { passive: true }); addEventListener('resize', check);
          more.addEventListener('click', () => row.scrollBy({ left: row.clientWidth * 0.7, behavior: 'smooth' }));
          check();
        }
      });
      hintRows();
      let hintQueued = false;
      new MutationObserver(() => { if (hintQueued) return; hintQueued = true; requestAnimationFrame(() => { hintQueued = false; hintRows(); }); })
        .observe(document.body, { childList: true, subtree: true });

      // A photograph opens full size: links marked data-zoom (a photography piece's photographs). With more than one
      // on the page, swipe (or the arrow keys) moves between them, like a phone's photo app; a tap or Escape closes.
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-zoom]');
        if (!link || e.metaKey || e.ctrlKey) return;
        e.preventDefault();
        const set = [...document.querySelectorAll<HTMLAnchorElement>('a[data-zoom]')];
        let at = Math.max(0, set.indexOf(link));
        const box = document.createElement('div'); box.className = 'zoom'; box.setAttribute('role', 'dialog'); box.setAttribute('aria-modal', 'true');
        const img = document.createElement('img');
        const cap = document.createElement('p');
        const count = document.createElement('span'); count.className = 'zoom-n';
        const close = document.createElement('button'); close.type = 'button'; close.setAttribute('aria-label', 'Close'); close.textContent = '×';
        const show = () => {
          const l = set[at]; img.src = l.href; img.alt = l.dataset.caption || '';
          cap.textContent = l.dataset.caption || ''; cap.hidden = !l.dataset.caption;
          count.textContent = set.length > 1 ? `${at + 1} / ${set.length}` : ''; count.hidden = set.length < 2;
        };
        const step = (d: number) => { if (set.length < 2) return; at = (at + d + set.length) % set.length; show(); };
        box.append(img, cap, count, close); show();
        const shut = () => { box.remove(); removeEventListener('keydown', key); set[at]?.focus(); };
        const key = (k: KeyboardEvent) => { if (k.key === 'Escape') shut(); else if (k.key === 'ArrowRight') step(1); else if (k.key === 'ArrowLeft') step(-1); };
        let x0 = 0, y0 = 0, swiped = false;
        box.addEventListener('touchstart', (t) => { x0 = t.touches[0].clientX; y0 = t.touches[0].clientY; swiped = false; }, { passive: true });
        box.addEventListener('touchend', (t) => {
          const dx = t.changedTouches[0].clientX - x0, dy = t.changedTouches[0].clientY - y0;
          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.4) { swiped = true; step(dx < 0 ? 1 : -1); }
        }, { passive: true });
        box.addEventListener('click', () => { if (swiped) { swiped = false; return; } shut(); });
        addEventListener('keydown', key);
        document.body.append(box); close.focus();
      });

      // Writers' pictures stay current: pages are built ahead of time, so when a writer changes their portrait,
      // each picture marked data-author-id asks Supabase for the latest one as the page opens (one small request).
      const marked = [...document.querySelectorAll<HTMLElement>('[data-author-id]')].filter((el) => el.dataset.authorId);
      if (marked.length) {
        const ids = [...new Set(marked.map((el) => el.dataset.authorId!))];
        const base = 'https://zblgggifysohxqtgvgxs.supabase.co', key = 'sb_publishable_84SLMdb_AiDAbaiz1eitbw_DRMx38lH';
        fetch(`${base}/rest/v1/profiles?select=id,portrait_path&id=in.(${ids.join(',')})`, { headers: { apikey: key } })
          .then((r) => (r.ok ? r.json() : []))
          .then((rows: { id: string; portrait_path: string | null }[]) => {
            for (const row of rows) {
              if (!row.portrait_path) continue;
              const src = `${base}/storage/v1/object/public/portraits/${row.portrait_path.split('/').map(encodeURIComponent).join('/')}`;
              for (const el of marked.filter((m) => m.dataset.authorId === row.id)) {
                const img = el.querySelector('img');
                if (img) { if (img.src !== src) img.src = src; }
                else { const n = new Image(); n.src = src; n.alt = ''; el.textContent = ''; el.append(n); }
              }
            }
          })
          .catch(() => {});
      }

      // Motion that needs to know where things are on screen. Styles live in src/styles/motion.css.
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!calm) {
        // Sections fade up as they scroll into view. Only things below the fold are hidden first,
        // so nothing you can already see ever blinks.
        const picks = document.querySelectorAll(
          'main .sec > :not(.g2, .g3, .g4, .side, .hin, .glass-light, .glow, .narrow), main .g2 > *, main .g3 > *, main .g4 > *, main .side > *, main .narrow > *, main .hin > *, main .mx'
        );
        const seen = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        picks.forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight || el.closest('.reveal')) return;
          const i = [...el.parentElement!.children].indexOf(el);
          (el as HTMLElement).style.setProperty('--d', `${(i % 4) * 80}ms`);
          el.classList.add('reveal');
          seen.observe(el);
        });
      }
    </script>
    <script>
      // Read ticks: reaching the end of a piece marks it read (on this device only; nothing is sent anywhere), and
      // wherever that piece is listed (the rooms, the Gallery, the Archive, Explore, writers' pages) a small tick shows.
      const KEY = 'oa_read';
      const load = (): string[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
      const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
      let read = new Set(load());
      const markRead = (el?: Element) => {
        const here = norm((el as HTMLElement | undefined)?.dataset.readEnd || location.pathname);   // (a piece read inside the Guild names its own page)
        if (read.has(here)) return;
        read.add(here);
        try { localStorage.setItem(KEY, JSON.stringify([...read].slice(-1500))); } catch {}
      };
      const watched = new WeakSet<Element>();
      const end = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { markRead(e.target); end.unobserve(e.target); } }));
      // Belt and braces (some phones never report the marker): the foot of the page counts as the end too.
      addEventListener('scroll', () => {
        const m = document.querySelector('[data-read-end]');
        if (m && innerHeight + scrollY >= document.documentElement.scrollHeight - 300) markRead(m);
      }, { passive: true });
      const tick = () => {
        document.querySelectorAll('[data-read-end]').forEach((el) => { if (!watched.has(el)) { watched.add(el); end.observe(el); } });
        if (!read.size) return;
        const here = norm(location.pathname);
        document.querySelectorAll<HTMLAnchorElement>('a[href]:not([data-read-done])').forEach((a) => {
          a.setAttribute('data-read-done', '');
          if (a.getAttribute('aria-hidden') === 'true' || a.closest('nav, header, footer, .gbar, [data-no-tick]')) return;
          let path = ''; try { const u = new URL(a.href); if (u.origin !== location.origin) return; path = norm(u.pathname); } catch { return; }
          if (path === here || !read.has(path) || path === '/' || path.split('/').filter(Boolean).length < 2) return;
          // A card with both a picture and a title for the same piece: one tick, on the title
          const card = a.closest('li, article, .item') ?? a.parentElement;
          if (a.querySelector('img') && card && [...card.querySelectorAll<HTMLAnchorElement>('a[href]')].some((o) => o !== a && !o.querySelector('img') && o.getAttribute('aria-hidden') !== 'true' && (() => { try { return norm(new URL(o.href).pathname) === path; } catch { return false; } })())) return;
          const mark = document.createElement('span');
          mark.className = 'read-tick'; mark.setAttribute('role', 'img'); mark.setAttribute('aria-label', 'Read');
          a.classList.add(a.querySelector('img') ? 'has-read-tile' : 'has-read');
          a.append(mark);
        });
      };
      let wait: number | undefined;
      const soon = () => { clearTimeout(wait); wait = window.setTimeout(tick, 250); };
      tick();
      new MutationObserver(soon).observe(document.body, { childList: true, subtree: true });
      addEventListener('pageshow', () => { read = new Set(load()); document.querySelectorAll('[data-read-done]').forEach((a) => a.removeAttribute('data-read-done')); document.querySelectorAll('.read-tick').forEach((t) => t.remove()); tick(); });
    </script>
  </body>
</html>
