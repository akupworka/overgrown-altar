---
// A writer's small round picture. Shows their portrait when there is one,
// otherwise their initials in a fine brass ring.
//   <Avatar name="Ainslie Willson" size={28} />
//   <Avatar name="…" src="/images/portrait.jpg" />
interface Props { name: string; src?: string; size?: number; id?: string }
const { name, src, size = 28, id } = Astro.props;
const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<span class="avatar" style={`--s:${size}px`} aria-hidden="true" data-author-id={id}>
  {src ? <img src={src} alt="" loading="lazy" /> : <span>{initials}</span>}
</span>
<style>
  .avatar {
    flex: none; width: var(--s); height: var(--s); border-radius: 50%; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center;
    background: #1B201A; box-shadow: 0 0 0 1px var(--brass), 0 0 0 3px rgba(159, 148, 94, .18);
    color: var(--ember); font-family: var(--serif); font-weight: 500; font-size: calc(var(--s) * .4); letter-spacing: .04em;
  }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .avatar:has(img) { background: #E9E2D4; }   /* a light ground, so a transparent portrait still shows */
</style>
