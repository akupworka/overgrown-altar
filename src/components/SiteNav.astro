---
// The site header. It stays with you:
//  - over a header photo it is clear, with a soft shade behind it;
//  - once you scroll, it becomes a dark bar;
//  - scrolling down tucks it away, scrolling up brings it back.
// Desktop shows the sections; smaller screens show Menu. The glowing Sign in is always there.
import Monogram from './Monogram.astro';
import MenuPanel from './MenuPanel.astro';

const links = [
  { href: '/watchtower', label: 'The Watchtower' },
  { href: '/hearth', label: 'The Hearth' },
  { href: '/perimeter', label: 'The Perimeter' },
  { href: '/folios', label: 'Folios' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname;
---
<div class="nav-shade" aria-hidden="true"></div>
<header class="site-header" data-header>
  <div class="bar" aria-hidden="true"></div>
  <nav class="nav lab" aria-label="Main">
    <a href="/" class="nav-home" aria-label="Overgrown Altar, home">
      <Monogram size={42} color="#F3ECDC" />
    </a>

    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>

    <div class="nav-right">
      <a href="/archive" class="icon-link" aria-label="Search the archive">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href="/guild" class="join" data-guest>Join the Guild</a>
      <a href="/guild/members/" class="join" data-member hidden aria-current={current.startsWith('/guild/members') ? 'page' : undefined}>The Guild</a>
      <a href="/guild/desk" class="signin" data-guest aria-current={current.startsWith('/guild/desk') ? 'page' : undefined}>Sign in</a>
      <a href="/guild/desk/" class="member" data-member hidden aria-current={current.startsWith('/guild/desk') ? 'page' : undefined}>
        <span class="member-av" aria-hidden="true"></span><span class="member-label">My Desk</span>
      </a>
      <a href="/menu" class="menu-link" aria-label="Menu">
        <span class="menu-word">Menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </a>
    </div>
  </nav>
</header>
<MenuPanel />

<script>
  // Signed in to the Guild? Show the member's portrait (or initials) and "My Desk" instead of
  // "Sign in". Reads only what this device already remembers, so nothing extra is loaded.
  try {
    const token = localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token');
    if (token && JSON.parse(token)?.refresh_token) {
      const me = JSON.parse(localStorage.getItem('oa_member') || '{}');
      const name: string = me.name || '';
      document.querySelectorAll<HTMLElement>('[data-guest]').forEach((el) => (el.hidden = true));
      document.querySelectorAll<HTMLElement>('[data-member]').forEach((el) => (el.hidden = false));
      document.querySelectorAll<HTMLElement>('.member-av').forEach((av) => {
        if (me.portrait) { const img = new Image(); img.src = me.portrait; img.alt = ''; av.append(img); }
        else av.textContent = name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '·';
      });
      document.querySelector('.member')?.setAttribute('aria-label', name ? `My Desk, signed in as ${name}` : 'My Desk');
    }
  } catch {}

  // Turns the header into a dark bar after you scroll, and tucks it away while you
  // scroll down. Only flips a class when something changes, so scrolling stays smooth.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let lastY = scrollY, solid = false, hidden = false, ticking = false;
    const update = () => {
      const y = scrollY;
      const nowSolid = y > 40;
      const nowHidden = y > 320 && y > lastY + 4 && !header.contains(document.activeElement);
      const showing = y < lastY - 4;
      if (nowSolid !== solid) { solid = nowSolid; header.classList.toggle('solid', solid); }
      if (nowHidden && !hidden) { hidden = true; header.classList.add('tucked'); }
      else if ((showing || y < 320) && hidden) { hidden = false; header.classList.remove('tucked'); }
      lastY = y; ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    header.addEventListener('focusin', () => { hidden = false; header.classList.remove('tucked'); });
    update();
  }
</script>

<style>
  .nav-shade {
    position: absolute; left: 0; right: 0; top: 0; height: 170px; z-index: 1;
    background: linear-gradient(180deg, rgba(6,8,6,.85), rgba(6,8,6,0));
    pointer-events: none;
  }
  .site-header {
    position: fixed; left: 0; right: 0; top: 0; z-index: 50; color: var(--bone);
    transition: transform .5s cubic-bezier(.16, 1, .3, 1);
    will-change: transform;
  }
  .site-header.tucked { transform: translateY(-110%); }
  /* The dark bar fades in (opacity only, so it is smooth). */
  .bar {
    position: absolute; inset: 0; opacity: 0; transition: opacity .4s ease;
    background: rgba(6, 8, 6, .92); box-shadow: 0 1px 0 rgba(243, 236, 220, .08), 0 10px 30px rgba(0, 0, 0, .35);
  }
  .site-header.solid .bar { opacity: 1; }

  .nav {
    position: relative; height: 84px; padding: 0 56px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
  }
  .nav-home { width: 28px; height: 42px; display: block; }
  .nav-links { display: flex; gap: 30px; }
  .nav a { white-space: nowrap; }
  .nav-links a, .join, .menu-link, .icon-link { transition: color .25s; }
  .nav-links a[aria-current='page'] { border-bottom: 1px solid var(--ember); padding-bottom: 4px; }
  .nav-links a:hover, .join:hover, .menu-link:hover, .icon-link:hover { color: var(--ember); }
  .nav-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
  .icon-link, .menu-link { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; }
  .menu-link { gap: 10px; }
  .burger { display: none; flex-direction: column; gap: 6px; width: 24px; }
  .burger span { display: block; height: 1.5px; background: currentColor; }

  /* Sign in: the brand's own outlined button, with a single sliver of glass light
     along its threshold. Colour enters only through glass. */
  .signin {
    position: relative; display: inline-flex; align-items: center; height: 40px; padding: 0 20px;
    border: 1px solid rgba(243, 236, 220, .38); color: var(--bone);
    transition: border-color .35s, color .35s, box-shadow .5s, background-color .35s;
  }
  .signin::after {
    content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 1px;
    background: linear-gradient(90deg, rgba(62,123,255,0), #3E7BFF 15%, #B05BFF 32%, #FF3B4E 50%, #FFC44D 68%, #3DE0A0 85%, rgba(61,224,160,0));
    opacity: .85; transition: opacity .35s, left .5s var(--ease), right .5s var(--ease);
  }
  .signin:hover, .signin[aria-current='page'] {
    border-color: rgba(255, 227, 163, .7); color: var(--ember); background-color: rgba(255, 227, 163, .04);
    box-shadow: 0 6px 24px -10px rgba(255, 214, 140, .45);
  }
  .signin:hover::after { left: 0; right: 0; opacity: 1; }
  [data-member][hidden], [data-guest][hidden] { display: none !important; }

  /* Signed in: the member's portrait and "My Desk". */
  .member { display: inline-flex; align-items: center; gap: 10px; height: 40px; padding: 0 16px 0 5px; border-radius: 999px;
    border: 1px solid rgba(243, 236, 220, .25); transition: border-color .35s, color .35s, background-color .35s; }
  .member:hover, .member[aria-current='page'] { border-color: rgba(255, 227, 163, .6); color: var(--ember); background-color: rgba(255, 227, 163, .04); }
  .member-av { width: 30px; height: 30px; border-radius: 50%; overflow: hidden; flex: none; display: inline-flex; align-items: center; justify-content: center;
    background: #14180F; box-shadow: 0 0 0 1px rgba(159, 148, 94, .8); color: var(--ember); font-family: var(--serif); font-size: 12px; letter-spacing: .04em; text-transform: none; }
  .member-av img { width: 100%; height: 100%; object-fit: cover; }

  /* Medium screens: sections move into the Menu. */
  @media (max-width: 1320px) {
    .nav { grid-template-columns: auto 1fr; }
    .nav-links { display: none; }
  }
  /* Phones: monogram, Sign in, and the menu button. */
  @media (max-width: 760px) {
    .nav { height: 60px; padding: 0 14px 0 20px; }
    .nav-right { gap: 6px; }
    .join, .menu-word, .icon-link { display: none; }
    .burger { display: flex; }
    .signin { height: 32px; padding: 0 13px; font-size: 9px; letter-spacing: .2em; }
    .signin::after { left: 8px; right: 8px; }
    .member { height: 32px; padding: 0 12px 0 3px; font-size: 9px; letter-spacing: .2em; gap: 7px; }
    .member-av { width: 24px; height: 24px; font-size: 10px; }
    .burger { width: 20px; gap: 5px; }
    .burger span { height: 1.25px; }
    .nav-home { width: 24px; height: 36px; }
    .nav-home :global(svg) { width: 24px; height: 36px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>
