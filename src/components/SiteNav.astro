---
// The site header. It stays with you:
//  - over a header photo it is clear, with a soft shade behind it;
//  - once you scroll, it becomes a dark bar;
//  - scrolling down tucks it away, scrolling up brings it back.
// Desktop shows the sections; smaller screens show Menu. The glowing Sign in is always there.
import Monogram from './Monogram.astro';
import MenuPanel from './MenuPanel.astro';

const links = [
  { href: '/watchtower', label: 'The Watchtower' },
  { href: '/hearth', label: 'The Hearth' },
  { href: '/perimeter', label: 'The Perimeter' },
  { href: '/folios', label: 'Folios' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname;
// Inside the members' area (the Desk and the Guild's pages) the header is always the solid bar, never see-through,
// and leaves out Folios (the members' bar carries the Guild's own rooms instead). Signed in anywhere, About steps aside too.
const inside = current.startsWith('/guild/desk') || current.startsWith('/guild/members');
---
<div class="nav-shade" aria-hidden="true"></div>
<header class:list={['site-header', { solid: inside }]} data-header data-always-solid={inside ? '' : undefined}>
  <div class="bar" aria-hidden="true"></div>
  <nav class="nav lab" aria-label="Main">
    <a href="/" class="nav-home" aria-label="Overgrown Altar, home">
      <Monogram size={42} color="#F3ECDC" />
    </a>

    <div class="nav-links">
      {links.filter((l) => !(inside && l.href === '/folios')).map((l) => (
        <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined} data-guest={l.href === '/about' ? '' : undefined}>{l.label}</a>
      ))}
    </div>

    <div class="nav-right">
      <a href="/archive" class="icon-link" aria-label="Search the archive">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href="/guild" class="join" data-guest>Join the Guild</a>
      <a href="/guild/members/" class="join" data-member hidden aria-current={current.startsWith('/guild/members') ? 'page' : undefined}>The Guild</a>
      <a href="/guild/desk" class="signin" data-guest aria-current={current.startsWith('/guild/desk') ? 'page' : undefined}>Sign in</a>
      <a href="/guild/desk/" class="member" data-member hidden aria-current={current.startsWith('/guild/desk') ? 'page' : undefined}>
        <span class="member-av" aria-hidden="true"></span><span class="member-label">My Desk</span>
      </a>
      <a href="/menu" class="menu-link" aria-label="Menu">
        <span class="menu-word">Menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </a>
    </div>
  </nav>
  {inside && (
    <!-- Inside the members' area: the Guild's own rooms, which the public header doesn't carry. -->
    <nav class="inner lab" aria-label="The Guild" data-inner>
      <span class="inner-mark" aria-hidden="true">The Guild</span>
      <a href="/guild/desk/" data-match="desk">My Desk</a>
      <a href="/guild/members/?view=forum" data-match="forum" data-spa>The Forum</a>
      <a href="/guild/members/" data-match="members" data-spa>Members</a>
      <a href="/guild/members/?view=prestige" data-match="prestige" data-spa>Prestiges</a>
      <a href="/guild/members/" data-match="me" data-spa data-my-page>My page</a>
      <a href="/guild/desk/#write" data-match="write" class="inner-write">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M14 6l4 4" /></svg>
        Write</a>
    </nav>
  )}
</header>
{inside && (
    <!-- Phones: one bar at the foot of every Guild page, the same for every member. Write sits in the middle.
         (The editor's Desk tab carries a gold dot when pieces or arrivals are waiting.) -->
    <nav class="d-tabbar gbar" aria-label="The Guild" data-gbar data-member hidden>
      <a href="/guild/desk/" data-match="desk"><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9" /></svg><span class="gbar-dot" data-gbar-dot hidden></span></span><span>Desk</span></a>
      <a href="/guild/members/?view=forum" data-match="forum" data-spa><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h12v8H9l-4 3v-3H4zM18 9h2v8h-1v3l-4-3h-5v-2" /></svg></span><span>Forum</span></a>
      <a href="/guild/desk/#write" data-match="write" class="t-write"><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M14 6l4 4" /></svg></span><span>Write</span></a>
      <a href="/guild/members/" data-match="members" data-spa><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20v-7a2.5 2.5 0 0 1 5 0v7M9.5 20v-9a2.5 2.5 0 0 1 5 0v9M16 20v-7a2.5 2.5 0 0 1 5 0v7M2 20h20" /></svg></span><span>Guild</span></a>
      <a href="/guild/members/" data-match="me" data-spa data-my-page><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c1.2-3.6 4-5 7-5s5.8 1.4 7 5" /></svg></span><span>Me</span></a>
    </nav>
)}
<MenuPanel />

<script>
  // Signed in to the Guild? Show the member's portrait (or initials) and "My Desk" instead of
  // "Sign in". Reads only what this device already remembers, so nothing extra is loaded.
  try {
    const token = localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token');
    if (token && JSON.parse(token)?.refresh_token) {
      const me = JSON.parse(localStorage.getItem('oa_member') || '{}');
      const name: string = me.name || '';
      document.querySelectorAll<HTMLElement>('[data-guest]').forEach((el) => (el.hidden = true));
      document.querySelectorAll<HTMLElement>('[data-member]').forEach((el) => (el.hidden = false));
      document.querySelectorAll<HTMLElement>('.member-av').forEach((av) => {
        if (me.portrait) { const img = new Image(); img.src = me.portrait; img.alt = ''; av.append(img); }
        else av.textContent = name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '·';
      });
      document.querySelector('.member')?.setAttribute('aria-label', name ? `My Desk, signed in as ${name}` : 'My Desk');
      // Members: the mark takes you home to the Guild (About stays in the menu and the footer).
      const home = document.querySelector<HTMLAnchorElement>('.nav-home');
      if (home) { home.href = '/guild/members/'; home.setAttribute('aria-label', 'The Guild, home for members'); }
    }
  } catch {}

  // The members' bar: which room you are in (it follows the Desk and the Guild's pages as they change),
  // your own page, the editor's Review, and moving between the Guild's pages without reloading.
  const inner = document.querySelector<HTMLElement>('[data-inner]');
  if (inner) {
    try {
      const me = JSON.parse(localStorage.getItem('oa_member') || '{}');
      const uid = JSON.parse(localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token') || '{}')?.user?.id;
      if (uid) document.querySelectorAll<HTMLAnchorElement>('[data-my-page]').forEach((a) => (a.href = `/guild/members/?m=${uid}`));
      // The editor's gold dot on Desk: pieces waiting for review, or new arrivals (the Desk keeps this count fresh).
      if (me.editor && Number(localStorage.getItem('oa_desk_waiting') || 0) > 0) document.querySelectorAll<HTMLElement>('[data-gbar-dot]').forEach((d) => (d.hidden = false));
    } catch {}
    const here = () => {
      const q = new URLSearchParams(location.search), path = location.pathname, h = location.hash;
      const uid = inner.querySelector<HTMLAnchorElement>('[data-my-page]')!.href.split('m=')[1];
      return path.startsWith('/guild/desk')
        ? (h.startsWith('#write') ? 'write' : h === '#my-page' ? 'me' : 'desk')
        : q.get('view') === 'forum' || q.get('board') || q.get('t') ? 'forum'
        : q.get('view') === 'prestige' ? 'prestige'
        : q.get('m') && q.get('m') === uid ? 'me' : 'members';
    };
    const gbar = document.querySelector<HTMLElement>('[data-gbar]');
    const mark = () => {
      const now = here();
      inner.querySelectorAll<HTMLElement>('[data-match]').forEach((a) => a.toggleAttribute('aria-current', a.dataset.match === now));
      // The phone bar has no Prestiges tab: the prestiges are one of the Guild's rooms.
      const tab = now === 'prestige' ? 'members' : now;
      gbar?.querySelectorAll<HTMLElement>('[data-match]').forEach((a) => { a.classList.toggle('on', a.dataset.match === tab); a.toggleAttribute('aria-current', a.dataset.match === tab); });
    };
    mark();
    addEventListener('popstate', mark); addEventListener('hashchange', mark);
    for (const k of ['pushState', 'replaceState'] as const) {
      const orig = history[k].bind(history);
      history[k] = (...args: Parameters<History['pushState']>) => { orig(...args); queueMicrotask(mark); };
    }
    const onNav = (e: MouseEvent) => {
      if (e.metaKey || e.ctrlKey) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!a) return;
      const to = new URL(a.href);
      // Within the Guild's pages: change page without reloading.
      if (a.matches('[data-spa]') && location.pathname.startsWith('/guild/members')) {
        e.preventDefault();
        history.pushState(null, '', a.href); dispatchEvent(new PopStateEvent('popstate')); scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      // Within the Desk: switch rooms in place (the Desk follows the address).
      if (location.pathname.startsWith('/guild/desk') && to.pathname.startsWith('/guild/desk')) {
        e.preventDefault();
        if (to.hash === location.hash) return;
        history.pushState(to.hash.startsWith('#write') ? { desk: 'write' } : null, '', to.pathname + to.hash);
        dispatchEvent(new PopStateEvent('popstate'));
      }
    };
    inner.addEventListener('click', onNav);
    gbar?.addEventListener('click', onNav);
  }

  // Turns the header into a dark bar after you scroll, and tucks it away while you
  // scroll down. Only flips a class when something changes, so scrolling stays smooth.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let lastY = scrollY, solid = header.classList.contains('solid'), hidden = false, ticking = false;
    const update = () => {
      const y = scrollY;
      const nowSolid = y > 40 || header.hasAttribute('data-always-solid');
      // Inside the members' area the header stays put (sticky); elsewhere it tucks away while you scroll down.
      const nowHidden = !header.hasAttribute('data-always-solid') && y > 320 && y > lastY + 4 && !header.contains(document.activeElement);
      const showing = y < lastY - 4;
      if (nowSolid !== solid) { solid = nowSolid; header.classList.toggle('solid', solid); }
      if (nowHidden && !hidden) { hidden = true; header.classList.add('tucked'); }
      else if ((showing || y < 320) && hidden) { hidden = false; header.classList.remove('tucked'); }
      lastY = y; ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    header.addEventListener('focusin', () => { hidden = false; header.classList.remove('tucked'); });
    update();
  }
</script>

<style>
  .nav-shade {
    position: absolute; left: 0; right: 0; top: 0; height: 170px; z-index: 1;
    background: linear-gradient(180deg, rgba(6,8,6,.85), rgba(6,8,6,0));
    pointer-events: none;
  }
  .site-header {
    position: fixed; left: 0; right: 0; top: 0; z-index: 50; color: var(--bone);
    transition: transform .5s cubic-bezier(.16, 1, .3, 1);
    will-change: transform;
  }
  .site-header.tucked { transform: translateY(-110%); }
  /* The dark bar fades in (opacity only, so it is smooth). */
  .bar {
    position: absolute; inset: 0; opacity: 0; transition: opacity .4s ease;
    background: rgba(6, 8, 6, .92); box-shadow: 0 1px 0 rgba(243, 236, 220, .08), 0 10px 30px rgba(0, 0, 0, .35);
  }
  .site-header.solid .bar { opacity: 1; }

  .nav {
    position: relative; height: 84px; padding: 0 56px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
  }
  .nav-home { width: 28px; height: 42px; display: block; }
  .nav-links { display: flex; gap: 30px; }
  .nav a { white-space: nowrap; }
  .nav-links a, .join, .menu-link, .icon-link { transition: color .25s; }
  .nav-links a[aria-current='page'] { border-bottom: 1px solid var(--ember); padding-bottom: 4px; }
  .nav-links a:hover, .join:hover, .menu-link:hover, .icon-link:hover { color: var(--ember); }
  .nav-right { justify-self: end; display: flex; align-items: center; gap: 18px; }
  .icon-link, .menu-link { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; }
  .menu-link { gap: 10px; }
  .burger { display: none; flex-direction: column; gap: 6px; width: 24px; }
  .burger span { display: block; height: 1.5px; background: currentColor; }

  /* Sign in: the brand's own outlined button, with a single sliver of glass light
     along its threshold. Color enters only through glass. */
  .signin {
    position: relative; display: inline-flex; align-items: center; height: 40px; padding: 0 20px;
    border: 1px solid rgba(243, 236, 220, .38); color: var(--bone);
    transition: border-color .35s, color .35s, box-shadow .5s, background-color .35s;
  }
  .signin::after {
    content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 1px;
    background: linear-gradient(90deg, rgba(62,123,255,0), #3E7BFF 15%, #B05BFF 32%, #FF3B4E 50%, #FFC44D 68%, #3DE0A0 85%, rgba(61,224,160,0));
    opacity: .85; transition: opacity .35s, left .5s var(--ease), right .5s var(--ease);
  }
  .signin:hover, .signin[aria-current='page'] {
    border-color: rgba(255, 227, 163, .7); color: var(--ember); background-color: rgba(255, 227, 163, .04);
    box-shadow: 0 6px 24px -10px rgba(255, 214, 140, .45);
  }
  .signin:hover::after { left: 0; right: 0; opacity: 1; }
  [data-member][hidden], [data-guest][hidden] { display: none !important; }

  /* Signed in: the member's portrait and "My Desk". */
  .member { display: inline-flex; align-items: center; gap: 10px; height: 40px; padding: 0 16px 0 5px; border-radius: 999px;
    border: 1px solid rgba(243, 236, 220, .25); transition: border-color .35s, color .35s, background-color .35s; }
  .member:hover, .member[aria-current='page'] { border-color: rgba(255, 227, 163, .6); color: var(--ember); background-color: rgba(255, 227, 163, .04); }
  .member-av { width: 30px; height: 30px; border-radius: 50%; overflow: hidden; flex: none; display: inline-flex; align-items: center; justify-content: center;
    background: #14180F; box-shadow: 0 0 0 1px rgba(159, 148, 94, .8); color: var(--ember); font-family: var(--serif); font-size: 12px; letter-spacing: .04em; text-transform: none; }
  .member-av img { width: 100%; height: 100%; object-fit: cover; }

  /* Medium screens: sections move into the Menu. */
  @media (max-width: 1320px) {
    .nav { grid-template-columns: auto 1fr; }
    .nav-links { display: none; }
  }
  /* Phones: monogram, Sign in, and the menu button. */
  @media (max-width: 760px) {
    .nav { height: 60px; padding: 0 14px 0 20px; }
    .nav-right { gap: 6px; }
    .join, .menu-word, .icon-link { display: none; }
    .burger { display: flex; }
    .signin { height: 32px; padding: 0 13px; font-size: 9px; letter-spacing: .2em; }
    .signin::after { left: 8px; right: 8px; }
    .member { height: 32px; padding: 0 12px 0 3px; font-size: 9px; letter-spacing: .2em; gap: 7px; }
    .member-av { width: 24px; height: 24px; font-size: 10px; }
    .burger { width: 20px; gap: 5px; }
    .burger span { height: 1.25px; }
    .nav-home { width: 24px; height: 36px; }
    .nav-home :global(svg) { width: 24px; height: 36px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
</style>
<style>
  /* The members' bar, under the main header, inside the Desk and the Guild's pages */
  .inner { position: relative; display: flex; align-items: center; gap: 6px; padding: 0 120px; height: 46px; border-top: 1px solid rgba(243, 236, 220, .08);
    overflow-x: auto; scrollbar-width: none; font-size: 10px; letter-spacing: .2em; }
  .inner::-webkit-scrollbar { display: none; }
  .inner-mark { flex: none; color: var(--ember); margin-right: 14px; font-family: var(--serif); letter-spacing: .3em; }
  .inner a { flex: none; padding: 8px 12px; border-radius: 999px; color: #CFC8B8; transition: color .25s, background-color .25s; white-space: nowrap; }
  .inner a:hover { color: var(--ember); }
  .inner a[aria-current] { color: #12160F; background: var(--bone); }
  .inner a[hidden] { display: none; }
  .inner .inner-write { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; color: var(--ember);
    box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .45); }
  .inner .inner-write:hover { background: rgba(255, 227, 163, .08); color: var(--ember); }
  .inner .inner-write[aria-current] { color: #12160F; background: var(--ember); box-shadow: none; }
  @media (max-width: 1320px) { .inner { padding: 0 48px; } }
  /* Phones: the bar at the foot of the page does this job. */
  @media (max-width: 700px) { .inner { display: none !important; } }
  @media (max-width: 760px) {
    .inner { padding: 0 16px; height: 42px; gap: 2px; font-size: 9px; letter-spacing: .16em;
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); }
    .inner-mark { display: none; }
    .inner a { padding: 7px 10px; }
    .inner .inner-quiet { margin-left: 0; }
  }
</style>
<style>
  /* Inside the members' area the header is a solid bar: nothing written beneath it shows through. */
  .site-header[data-always-solid] .bar { background: #070906; }
</style>
