---
// The top navigation bar. It sits over the hero photo at the top of a page.
import Monogram from './Monogram.astro';

// The links, in one list, so adding a page means editing one line.
const links = [
  { href: '/watchtower', label: 'The Watchtower' },
  { href: '/hearth', label: 'The Hearth' },
  { href: '/perimeter', label: 'The Perimeter' },
  { href: '/folios', label: 'Folios' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname;
---
<div class="nav-shade" aria-hidden="true"></div>
<nav class="nav lab" aria-label="Main">
  <a href="/" class="nav-home" aria-label="Overgrown Altar, home">
    <Monogram size={42} color="#F3ECDC" />
  </a>

  <div class="nav-links">
    {links.map((l) => (
      <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </div>

  <div class="nav-right">
    <a href="/archive">Search</a>
    <a href="/menu">Menu</a>
    <a class="ghost" href="/guild" style="padding:11px 20px">Join the Guild</a>
  </div>

  <a href="/menu" class="burger" aria-label="Open menu">
    <span></span><span></span><span></span>
  </a>
</nav>

<style>
  /* Styles written inside a component only affect that component. */
  .nav-shade {
    position: absolute; left: 0; right: 0; top: 0; height: 170px; z-index: 1;
    background: linear-gradient(180deg, rgba(6,8,6,.85), rgba(6,8,6,0));
    pointer-events: none;
  }
  .nav {
    position: absolute; left: 56px; right: 56px; top: 30px; z-index: 2;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    color: var(--bone);
  }
  .nav-home { width: 28px; height: 42px; display: block; }
  .nav-links { display: flex; gap: 40px; }
  .nav-links a[aria-current='page'] { border-bottom: 1px solid var(--ember); padding-bottom: 4px; }
  .nav-links a:hover, .nav-right > a:not(.ghost):hover { color: var(--ember); }
  .nav-right { justify-self: end; display: flex; align-items: center; gap: 28px; }
  .burger {
    display: none; justify-self: end; flex-direction: column; gap: 6px;
    width: 44px; height: 44px; justify-content: center; padding: 0 9px;
  }
  .burger span { display: block; height: 1.5px; background: var(--bone); }

  @media (max-width: 1100px) {
    .nav-links { gap: 24px; }
  }
  @media (max-width: 960px) {
    .nav { left: 20px; right: 20px; top: 20px; grid-template-columns: 1fr auto; }
    .nav-links, .nav-right { display: none; }
    .burger { display: flex; }
  }
</style>
