---
// The site header. It stays with you:
//  - over a header photo it is clear, with a soft shade behind it;
//  - once you scroll, it becomes a dark bar;
//  - scrolling down tucks it away, scrolling up brings it back.
// Desktop shows the sections; smaller screens show Menu. The glowing Sign in is always there.
import Monogram from './Monogram.astro';
import MenuPanel from './MenuPanel.astro';
import '../styles/gbar.css';

const links = [
  { href: '/watchtower', label: 'The Watchtower' },
  { href: '/hearth', label: 'The Hearth' },
  { href: '/perimeter', label: 'The Perimeter' },
  { href: '/gallery', label: 'The Gallery' },
  { href: '/folios', label: 'Folios' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname;
// Inside the members' area (the Desk and the Guild's pages) the header is always the solid bar, never see-through,
// and leaves out Folios (the members' bar carries the Guild's own rooms instead). Signed in anywhere, About steps aside too.
const inside = current.startsWith('/guild/desk') || current.startsWith('/guild/members');
---
<div class="nav-shade" aria-hidden="true"></div>
<header class:list={['site-header', { solid: inside }]} data-header data-always-solid={inside ? '' : undefined}>
  <div class="bar" aria-hidden="true"></div>
  <nav class="nav lab" aria-label="Main">
    <a href="/" class="nav-home" aria-label="Overgrown Altar, home">
      <Monogram size={42} color="#F3ECDC" />
    </a>

    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined} data-guest={l.href === '/about' || l.href === '/folios' ? '' : undefined}>{l.label}</a>
      ))}
    </div>

    <div class="nav-right">
      <a href="/search/" class="icon-link" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href="/join/" class="join" data-guest aria-current={current.startsWith('/join') ? 'page' : undefined}>Join</a>
      <a href="/guild/desk" class="signin" data-guest aria-current={current.startsWith('/guild/desk') ? 'page' : undefined}>Sign in</a>
      <a href="/guild/members/" class="online" data-member data-online hidden aria-label="Members online now"><i aria-hidden="true"></i><b data-online-n>1</b><span class="online-w">online</span></a>
      <a href="/guild/desk/" class="member" data-member aria-current={current.startsWith('/guild/desk') ? 'page' : undefined}>
        <span class="member-av" aria-hidden="true"></span><span class="member-label">Profile</span>
      </a>
      <a href="/menu" class="menu-link" aria-label="Menu">
        <span class="menu-word">Menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </a>
    </div>
  </nav>
  {(
    <!-- The Guild's own rooms: for members, on every page of the site (the html data-member flag shows it). -->
    <nav class="inner lab" aria-label="The Guild" data-inner data-member>
      <span class="inner-mark" aria-hidden="true">The Guild</span>
      <div class="inner-rooms">
        <a href="/guild/desk/" data-match="desk"><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9" /></svg>My Desk<span class="inner-dot" data-gbar-dot hidden></span></a>
        <a href="/guild/members/?view=forum" data-match="forum" data-spa><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h12v8H9l-4 3v-3H4zM18 9h2v8h-1v3l-4-3h-5v-2" /></svg>The Forum</a>
        <a href="/guild/members/" data-match="members" data-spa class="for-guild"><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20v-7a2.5 2.5 0 0 1 5 0v7M9.5 20v-9a2.5 2.5 0 0 1 5 0v9M16 20v-7a2.5 2.5 0 0 1 5 0v7M2 20h20" /></svg>The Guild</a>
        <a href="/guild/members/?view=inbox" data-match="inbox" data-spa><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12.5" rx="1.5" /><path d="M4 7l8 6 8-6" /></svg>Inbox<span class="inner-n" data-inbox-dot hidden></span></a>
        <a href="/guild/members/?view=prestige" data-match="prestige" data-spa class="for-guild"><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" /><path d="M12 8l2 3-2 3-2-3z" /></svg>Prestiges</a>
        <a href="/guild/members/?view=way" data-match="way" data-spa class="for-fellow"><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 18c-4 0-6.5-3.5-6.5-7 0 0 2.5-4 6.5-4s6.5 4 6.5 4c0 3.5-2.5 7-6.5 7z" /><path d="M12 18V7.5M9 17l-1.5-8M15 17l1.5-8" /></svg>The Way</a>
        <a href="/search/" data-match="explore" class="for-fellow inner-explore"><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4-4" /></svg>Explore</a>
        <a href="/guild/members/" data-match="me" data-spa data-my-page class="inner-me" aria-hidden="true" tabindex="-1"><svg class="inner-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c1.2-3.6 4-5 7-5s5.8 1.4 7 5" /></svg>My page</a>
      </div>
      <a href="/guild/desk/#photograph" data-match="photograph" class="inner-photo">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
        Photograph</a>
      <a href="/guild/desk/#write" data-match="write" class="inner-write">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M14 6l4 4" /></svg>
        Write</a>
    </nav>
  )}
</header>
{(
    <!-- Phones: one bar at the foot of every page for members, the same for every member. Write sits in the middle.
         (The editor's Desk tab carries a gold dot when pieces or arrivals are waiting.) -->
    <nav class="d-tabbar gbar" aria-label="The Guild" data-gbar data-member>
      <a href="/guild/desk/" data-match="desk"><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9" /></svg><span class="gbar-dot" data-gbar-dot hidden></span></span><span>Desk</span></a>
      <a href="/guild/members/?view=forum" data-match="forum" data-spa><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h12v8H9l-4 3v-3H4zM18 9h2v8h-1v3l-4-3h-5v-2" /></svg></span><span>Forum</span></a>
      <a href="/guild/desk/#write" data-match="write" class="t-write" aria-haspopup="true" aria-expanded="false"><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M14 6l4 4" /></svg></span><span>Write</span></a>
      <!-- The Fellowship doesn't write: their centre button explores instead -->
      <a href="/search/" data-match="explore" class="t-write t-explore"><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4-4" /></svg></span><span>Explore</span></a>
      <a href="/guild/members/?view=inbox" data-match="inbox" data-spa><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12.5" rx="1.5" /><path d="M4 7l8 6 8-6" /></svg><span class="gbar-n" data-inbox-dot hidden></span></span><span>Inbox</span></a>
      <a href="/guild/members/?view=way" data-match="way" data-spa class="for-fellow"><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19c-4.6 0-7.5-4-7.5-8 0 0 2.9-4.6 7.5-4.6s7.5 4.6 7.5 4.6c0 4-2.9 8-7.5 8z" /><path d="M12 19V7M8.6 18l-1.8-9M15.4 18l1.8-9" /></svg></span><span>The Way</span></a>
      <a href="/guild/members/" data-match="members" data-spa class="for-guild"><span class="d-tabbar-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20v-7a2.5 2.5 0 0 1 5 0v7M9.5 20v-9a2.5 2.5 0 0 1 5 0v9M16 20v-7a2.5 2.5 0 0 1 5 0v7M2 20h20" /></svg></span><span>Guild</span></a>
      
    </nav>
    <div class="gbar-choose" data-gbar-choose hidden>
      <a href="/guild/desk/#write" class="gbar-opt"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M14 6l4 4" /></svg><span><b>Write a piece</b><i>Prose, poetry, essays, testimony</i></span></a>
      <a href="/guild/desk/#photograph" class="gbar-opt"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg><span><b>Submit a photograph</b><i>For the Gallery</i></span></a>
    </div>
)}
<MenuPanel />

<script>
  import { seatFor } from '../lib/seats';
  // Members online now: everyone signed in with a page of the site open joins one presence room; the pill counts them.
  try {
    const tok = JSON.parse(localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token') || 'null');
    const uid: string | undefined = tok?.user?.id;
    if (tok?.refresh_token && uid) {
      import('../lib/supabase').then(({ supabase }) => {
        const pill = document.querySelector<HTMLElement>('[data-online]');
        const n = document.querySelector<HTMLElement>('[data-online-n]');
        const room = supabase.channel('guild-online', { config: { presence: { key: uid } } });
        // Unread messages: the count on Inbox, now and as messages arrive.
        const dot = () => supabase.rpc('dm_unread').then(({ data }) => {
          const n = typeof data === 'number' ? data : 0;
          document.querySelectorAll<HTMLElement>('[data-inbox-dot]').forEach((d) => { d.hidden = n === 0; d.textContent = n > 9 ? '9+' : String(n); });
        });
        dot();
        supabase.channel('inbox-dot').on('postgres_changes', { event: '*', schema: 'public', table: 'dm_threads' }, () => dot()).subscribe();
        room.on('presence', { event: 'sync' }, () => {
          const count = Object.keys(room.presenceState()).length;
          if (n) n.textContent = String(Math.max(1, count));
          if (pill) pill.hidden = false;
        }).subscribe((st) => { if (st === 'SUBSCRIBED') room.track({ at: Date.now() }); });
      }).catch(() => {});
    }
  } catch {}
  // Signed in to the Guild? Show the member's portrait (or initials) and "My Desk" instead of
  // "Sign in". Reads only what this device already remembers, so nothing extra is loaded.
  try {
    const token = localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token');
    if (token && JSON.parse(token)?.refresh_token) {
      const me = JSON.parse(localStorage.getItem('oa_member') || '{}');
      const name: string = me.name || '';
      document.querySelectorAll<HTMLElement>('[data-guest]').forEach((el) => (el.hidden = true));
      document.querySelectorAll<HTMLElement>('[data-member]').forEach((el) => (el.hidden = false));
      document.querySelectorAll<HTMLElement>('.member-av').forEach((av) => {
        const img = new Image(); img.src = me.portrait || seatFor(name); img.alt = ''; av.append(img);
      });
      document.querySelector('.member')?.setAttribute('aria-label', name ? `My Desk, signed in as ${name}` : 'My Desk');
      // The picture pill is your Profile everywhere: it opens your page (the Desk is in the Guild bar and on the Guild page).
      const uid0 = JSON.parse(token)?.user?.id;
      if (uid0) {
        const pill = document.querySelector<HTMLAnchorElement>('.member');
        const label = pill?.querySelector('.member-label');
        if (pill && label) { label.textContent = 'Profile'; pill.href = `/guild/members/?m=${uid0}`; pill.setAttribute('aria-label', name ? `My profile, signed in as ${name}` : 'My profile'); pill.removeAttribute('aria-current'); }
      }
      // The editor seeing the site as someone else: a small reminder on every page, with the way back.
      const va = localStorage.getItem('oa_view_as');
      if (me.editor && (va === 'member' || va === 'fellow') && !document.querySelector('.see-as-pill')) {
        const pill = document.createElement('button'); pill.type = 'button'; pill.className = 'see-as-pill';
        pill.innerHTML = `<span>Seeing as ${va === 'member' ? 'a Guild member' : 'the Fellowship'}</span><b>Back to editor</b>`;
        pill.addEventListener('click', () => { localStorage.removeItem('oa_view_as'); location.reload(); });
        document.body.append(pill);
      }
      // Members: the mark takes you home to the Guild (About stays in the menu and the footer).
      const home = document.querySelector<HTMLAnchorElement>('.nav-home');
      if (home) { const f = !!me.fellow; home.href = f ? '/guild/desk/' : '/guild/members/'; home.setAttribute('aria-label', f ? 'Your Desk' : 'The Guild, home for members'); }
    }
  } catch {}

  // The members' bar: which room you are in (it follows the Desk and the Guild's pages as they change),
  // your own page, the editor's Review, and moving between the Guild's pages without reloading.
  const inner = document.querySelector<HTMLElement>('[data-inner]');
  if (inner) {
    try {
      const me = JSON.parse(localStorage.getItem('oa_member') || '{}');
      const uid = JSON.parse(localStorage.getItem('sb-zblgggifysohxqtgvgxs-auth-token') || '{}')?.user?.id;
      if (uid) document.querySelectorAll<HTMLAnchorElement>('[data-my-page]').forEach((a) => (a.href = `/guild/members/?m=${uid}`));
      // The editor's gold dot on Desk: pieces waiting for review, or new arrivals (the Desk keeps this count fresh).
      if (me.editor && Number(localStorage.getItem('oa_desk_waiting') || 0) > 0) document.querySelectorAll<HTMLElement>('[data-gbar-dot]').forEach((d) => (d.hidden = false));
    } catch {}
    const here = () => {
      const q = new URLSearchParams(location.search), path = location.pathname, h = location.hash;
      const uid = inner.querySelector<HTMLAnchorElement>('[data-my-page]')!.href.split('m=')[1];
      if (path.startsWith('/search')) return 'explore';
      if (!path.startsWith('/guild/')) return '';   // a public page: no room is lit
      return path.startsWith('/guild/desk')
        ? (h.startsWith('#write') ? 'write' : h === '#my-page' ? 'me' : 'desk')
        : q.get('view') === 'inbox' || q.get('dm') ? 'inbox'
        : q.get('view') === 'forum' || q.get('view') === 'rules' || q.get('view') === 'mine' || q.get('board') || q.get('t') ? 'forum'
        : q.get('view') === 'prestige' || q.get('view') === 'trophies' ? 'prestige'
        : q.get('view') === 'way' || (document.documentElement.hasAttribute('data-fellow') && !q.get('m') && !q.get('p')) ? 'way'
        : q.get('m') && q.get('m') === uid ? 'me' : 'members';
    };
    const gbar = document.querySelector<HTMLElement>('[data-gbar]');
    // Pinned to the screen: move the bar (and its Write choice) to the page's outermost level, so no section it was
    // written inside (a header photograph, a moving reveal) can carry it along as you scroll (iPhone Safari does).
    if (gbar && gbar.parentElement !== document.body) document.body.append(gbar);
    const chooser = document.querySelector<HTMLElement>('[data-gbar-choose]');
    if (chooser && chooser.parentElement !== document.body) document.body.append(chooser);
    // iPhone fault: after the keyboard has been up, the phone can keep measuring the screen as if it still were, and
    // anything pinned to the bottom floats up by the keyboard's height. Measure the real visible screen and, when the
    // phone has it wrong, pull the bar back down to the true bottom. (It only ever moves down, never above a keyboard.)
    const vv = window.visualViewport;
    const anchor = () => {
      if (!vv || !gbar) return;
      const gap = Math.max(0, Math.round(vv.offsetTop + vv.height - window.innerHeight));
      document.documentElement.style.setProperty('--gbar-shift', gap + 'px');
    };
    anchor();
    vv?.addEventListener('resize', anchor); vv?.addEventListener('scroll', anchor);
    addEventListener('scroll', anchor, { passive: true }); addEventListener('resize', anchor); addEventListener('pageshow', anchor);
    addEventListener('orientationchange', () => setTimeout(anchor, 300));
    // ?barcheck: show what the phone measures, so a fault can be diagnosed from a screenshot.
    if (/[?&]barcheck\b/.test(location.search) && gbar) {
      const box = document.createElement('pre');
      box.style.cssText = 'position:fixed;z-index:999;top:70px;left:8px;right:8px;margin:0;padding:10px;font:12px/1.5 monospace;color:#FFE3A3;background:rgba(0,0,0,.85);border:1px solid #FFE3A3;border-radius:8px;white-space:pre-wrap';
      document.body.append(box);
      const show = () => { const r = gbar.getBoundingClientRect(); box.textContent =
        `innerHeight ${innerHeight}\nclientHeight ${document.documentElement.clientHeight}\nvisual ${vv ? Math.round(vv.height) + ' @' + Math.round(vv.offsetTop) + ' scale ' + vv.scale.toFixed(2) : 'none'}\nscreen ${screen.height}\nbar top ${Math.round(r.top)} bottom ${Math.round(r.bottom)}\nshift ${getComputedStyle(document.documentElement).getPropertyValue('--gbar-shift')}\nposition ${getComputedStyle(gbar).position}\nparent ${gbar.parentElement?.tagName}\nstandalone ${(navigator as any).standalone ?? matchMedia('(display-mode: standalone)').matches}`; };
      show(); addEventListener('scroll', show, { passive: true }); vv?.addEventListener('resize', show); vv?.addEventListener('scroll', show);
    }
    // When the keyboard closes, ask the phone to measure again.
    addEventListener('focusout', () => setTimeout(() => { scrollTo(scrollX, scrollY); anchor(); }, 120));
    const mark = () => {
      const now = here();
      inner.querySelectorAll<HTMLElement>('[data-match]').forEach((a) => a.toggleAttribute('aria-current', a.dataset.match === now));
      // The phone bar has no Prestiges tab: the prestiges are one of the Guild's rooms.
      const tab = now === 'prestige' ? 'members' : now;
      gbar?.querySelectorAll<HTMLElement>('[data-match]').forEach((a) => { a.classList.toggle('on', a.dataset.match === tab); a.toggleAttribute('aria-current', a.dataset.match === tab); });
    };
    mark();
    addEventListener('popstate', mark); addEventListener('hashchange', mark);
    for (const k of ['pushState', 'replaceState'] as const) {
      const orig = history[k].bind(history);
      history[k] = (...args: Parameters<History['pushState']>) => { orig(...args); queueMicrotask(mark); };
    }
    const onNav = (e: MouseEvent) => {
      if (e.metaKey || e.ctrlKey) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
      if (!a) return;
      const to = new URL(a.href);
      // Within the Guild's pages: change page without reloading.
      if (a.matches('[data-spa]') && location.pathname.startsWith('/guild/members')) {
        e.preventDefault();
        history.pushState(null, '', a.href); dispatchEvent(new PopStateEvent('popstate')); scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }
      // Within the Desk: switch rooms in place (the Desk follows the address).
      if (location.pathname.startsWith('/guild/desk') && to.pathname.startsWith('/guild/desk')) {
        e.preventDefault();
        if (to.hash === location.hash) return;
        history.pushState(to.hash.startsWith('#write') ? { desk: 'write' } : null, '', to.pathname + to.hash);
        dispatchEvent(new PopStateEvent('popstate'));
      }
    };
    const choose = document.querySelector<HTMLElement>('[data-gbar-choose]');
    const writeTab = gbar?.querySelector<HTMLAnchorElement>('.t-write:not(.t-explore)');
    const shut = () => { if (choose) choose.hidden = true; writeTab?.setAttribute('aria-expanded', 'false'); };
    writeTab?.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const open = !!choose?.hidden; if (choose) choose.hidden = !open; writeTab.setAttribute('aria-expanded', String(open));
    }, true);
    choose?.addEventListener('click', (e) => { shut(); onNav(e as MouseEvent); });
    document.addEventListener('click', (e) => { if (choose && !choose.hidden && !choose.contains(e.target as Node)) shut(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape') shut(); });
    inner.addEventListener('click', onNav);
    gbar?.addEventListener('click', onNav);
  }

  // Turns the header into a dark bar after you scroll, and tucks it away while you
  // scroll down. Only flips a class when something changes, so scrolling stays smooth.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    let lastY = scrollY, solid = header.classList.contains('solid'), hidden = false, ticking = false;
    const update = () => {
      const y = scrollY;
      const nowSolid = y > 40 || header.hasAttribute('data-always-solid');
      // Inside the members' area the header stays put (sticky); elsewhere it tucks away while you scroll down.
      const nowHidden = !header.hasAttribute('data-always-solid') && y > 320 && y > lastY + 4 && !header.contains(document.activeElement);
      const showing = y < lastY - 4;
      if (nowSolid !== solid) { solid = nowSolid; header.classList.toggle('solid', solid); }
      if (nowHidden && !hidden) { hidden = true; header.classList.add('tucked'); }
      else if ((showing || y < 320) && hidden) { hidden = false; header.classList.remove('tucked'); }
      lastY = y; ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    header.addEventListener('focusin', () => { hidden = false; header.classList.remove('tucked'); });
    update();
  }
</script>

<style>
  .nav-shade {
    position: absolute; left: 0; right: 0; top: 0; height: 170px; z-index: 1;
