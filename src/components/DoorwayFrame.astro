---
// The doorway, as a section of a page (the same look as the Guild Desk sign-in and the password page).
// It draws itself when it scrolls into view. Put the form in the slot; use .dw-field / .dw-line-row
// for single-line fields and .dw-go for the "Send ->" button. Styles: src/styles/doorway.css.
import '../styles/doorway.css';
import Cross from './Cross.astro';
interface Props { kicker: string; title: string; lead?: string; image?: string; id?: string }
const { kicker, title, lead, image = '/images/folios-photo-2-1200.jpg', id } = Astro.props;
const motes = Array.from({ length: 12 }, (_, i) => {
  const r = (n: number) => ((Math.sin(i * 12.9898 + n * 78.233) * 43758.5453) % 1 + 1) % 1;
  return `left:${(16 + r(1) * 68).toFixed(1)}%;bottom:${(r(2) * 40).toFixed(1)}%;--s:${(1 + r(3) * 2.2).toFixed(1)}px;--t:${(14 + r(4) * 14).toFixed(1)}s;--d:-${(r(5) * 20).toFixed(1)}s;--x:${((r(6) - .5) * 60).toFixed(0)}px`;
});
---
<section class="dw dw-inline" id={id}>
  <div class="dw-backdrop" aria-hidden="true">
    <div class="dw-nave"><img src={image} alt="" loading="lazy" /></div>
    <div class="dw-shaft"></div>
    <div class="dw-vignette"></div>
    <div class="dw-motes">{motes.map((s) => <i style={s}></i>)}</div>
  </div>
  <div class="dw-arch-wrap">
    <svg class="dw-arch" viewBox="0 0 600 1000" preserveAspectRatio="none" aria-hidden="true">
      <path class="dw-line" pathLength="1" d="M0,1000 L0,430 C0,190 150,60 300,0 C450,60 600,190 600,430 L600,1000" />
      <path class="dw-line inner" pathLength="1" d="M18,1000 L18,436 C18,206 160,82 300,24 C440,82 582,206 582,436 L582,1000" />
    </svg>
    <div class="dw-glow" aria-hidden="true"></div>
    <div class="dw-threshold">
      <span class="dw-cross-wrap"><Cross width={26} color="#FFE3A3" /></span>
      <span class="eb dw-kicker">{kicker}</span>
      <h2 class="dw-title">{title}</h2>
      {lead && <p class="dw-lead">{lead}</p>}
      <div class="dw-body"><slot /></div>
    </div>
  </div>
  <div class="dw-foot"><slot name="foot" /></div>
</section>
<script>
  // Draw each doorway as it comes into view.
  const seen = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('dw-in'); seen.unobserve(e.target); } }), { threshold: 0.25 });
  document.querySelectorAll('.dw-inline').forEach((el) => seen.observe(el));
</script>
