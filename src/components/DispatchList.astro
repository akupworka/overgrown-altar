---
// A compact list of dispatches, newest first. Each row: a small photo, the title,
// a short summary, and the writer's picture, name and date.
// Sorting by date happens here, so whatever order the pieces arrive in, readers see the newest first.
import Avatar from './Avatar.astro';

export interface DispatchItem {
  href: string; title: string; kicker?: string; standfirst?: string;
  date: string;              // ISO date, e.g. "2026-11-03"
  author: { name: string; portrait?: string; href?: string; id?: string };
  image?: string; imagePos?: string; minutes?: number;
  tag?: string;              // optional: lets a page filter the list (e.g. by kind of piece)
}
// live: fill in pieces approved since the site was built (see lib/live.ts). pillar narrows it; max keeps the list short.
// paged: show this many rows a page, with numbered pages below (works alongside a page's own search and filters,
// which hide rows with the hidden attribute; paging uses its own class so the two never fight).
interface Props { items: DispatchItem[]; tone?: 'paper' | 'dark'; live?: { pillar?: string; max?: number; kicker?: 'full' | 'kind' }; paged?: number }
const tone = Astro.props.tone ?? 'paper';
const live = Astro.props.live;
const BUILT = new Date().toISOString();
const items = [...Astro.props.items].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string, month: 'long' | 'short' = 'long') => new Date(d).toLocaleDateString('en-US', { month, day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<ol class:list={['dispatches', { dark: tone === 'dark' }]} data-live={live ? '' : undefined} data-built={live ? BUILT : undefined}
  data-pillar={live?.pillar} data-max={live?.max} data-kicker={live?.kicker ?? 'full'} data-paged={Astro.props.paged || undefined}>
  {items.map((d) => (
    <li data-tag={d.tag}>
      <div class="row-link">
        {d.image && (
          <span class="thumb"><img src={d.image} alt="" style={d.imagePos ? `object-position:${d.imagePos}` : undefined} loading="lazy" /></span>
        )}
        <span class="text">
          {d.kicker && <span class="lab kicker">{d.kicker}</span>}
          {/* The title is the link; it stretches over the whole row, so the row stays one big tap target. */}
          <a class="h3 title" href={d.href}>{d.title}</a>
          {d.standfirst && <span class="it mut summary">{d.standfirst}</span>}
          <span class="byline">
            {d.author.href
              ? <a class="author" href={d.author.href}><Avatar name={d.author.name} src={d.author.portrait} size={26} id={d.author.id} /><span class="lab mut who">{d.author.name}</span></a>
              : <span class="author"><Avatar name={d.author.name} src={d.author.portrait} size={26} id={d.author.id} /><span class="lab mut who">{d.author.name}</span></span>}
            <span class="lab mut by"><span class="dot">· </span><time datetime={d.date}><span class="long">{fmt(d.date)}</span><span class="short">{fmt(d.date, 'short')}</span></time>{d.minutes ? <span class="mins"> · {d.minutes} min</span> : null}</span>
          </span>
        </span>
      </div>
    </li>
  ))}
</ol>
{Astro.props.paged && <nav class:list={['pager', 'dl-pager', { 'fo-pager': tone === 'dark' }]} aria-label="Pages of stories" hidden></nav>}

<script>
  import { freshSince } from '../lib/live';
  import { pagerHtml } from '../lib/pager';
  // Pages: rows a filter or search has hidden are skipped; any change to those starts again at page one.
  document.querySelectorAll<HTMLOListElement>('ol.dispatches[data-paged]').forEach((list) => {
    const per = Number(list.dataset.paged), pager = list.nextElementSibling as HTMLElement | null;
    if (!pager?.classList.contains('dl-pager')) return;
    let page = 1;
    const draw = (scroll = false) => {
      const rows = [...list.children].filter((r) => !(r as HTMLElement).hidden) as HTMLElement[];
      const pages = Math.max(1, Math.ceil(rows.length / per)); page = Math.min(page, pages);
      [...list.children].forEach((r) => r.classList.remove('pg-off'));
      rows.forEach((r, i) => r.classList.toggle('pg-off', i < (page - 1) * per || i >= page * per));
      pager.hidden = pages < 2; pager.innerHTML = pagerHtml(page, pages, 'Newer', 'Older');
      if (scroll) list.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    pager.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-go]');
      if (!b || b.disabled) return; page = Number(b.dataset.go); draw(true);
    });
    new MutationObserver(() => { page = 1; draw(); }).observe(list, { subtree: true, childList: true, attributes: true, attributeFilter: ['hidden'] });
    draw();
  });
  // New pieces approved since this page was built join the top of the list, drawn from its own first row.
  const fmtLong = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
  const fmtShort = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
  document.querySelectorAll<HTMLOListElement>('ol.dispatches[data-live]').forEach(async (list) => {
    const model = list.querySelector<HTMLLIElement>(':scope > li');
    if (!model) return;
    const have = new Set([...list.querySelectorAll<HTMLAnchorElement>('a.title')].map((a) => new URL(a.href).pathname));
    const fresh = (await freshSince(list.dataset.built!, list.dataset.pillar)).filter((p) => p.medium !== 'photograph' && !have.has(p.href));
    for (const p of [...fresh].reverse()) {
      const li = model.cloneNode(true) as HTMLLIElement;
      li.dataset.tag = p.medium;
      const t = li.querySelector<HTMLAnchorElement>('a.title'); if (t) { t.href = p.href; t.textContent = p.title; }
      const k = li.querySelector('.kicker'); if (k) k.textContent = list.dataset.kicker === 'kind' ? p.kind : `${p.room} · ${p.kind}`;
      const s = li.querySelector('.summary'); if (s) { s.textContent = p.standfirst; (s as HTMLElement).hidden = !p.standfirst; }
      const img = li.querySelector<HTMLImageElement>('.thumb img'); if (img && p.image) { img.src = p.image; img.style.objectPosition = p.imagePos; }
      li.querySelectorAll<HTMLElement>('.who').forEach((w) => (w.textContent = p.author));
      li.querySelectorAll<HTMLAnchorElement>('a.author').forEach((a) => a.removeAttribute('href'));
      const av = li.querySelector<HTMLElement>('.avatar');
      if (av) { av.dataset.authorId = p.authorId; av.innerHTML = ''; if (p.portrait) { const i = new Image(); i.src = p.portrait; i.alt = ''; av.append(i); } else { const sp = document.createElement('span'); sp.textContent = p.author.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase(); av.append(sp); } }
      const time = li.querySelector('time'); if (time) time.setAttribute('datetime', p.date);
      const l = li.querySelector('.long'); if (l) l.textContent = fmtLong(p.date);
      const sh = li.querySelector('.short'); if (sh) sh.textContent = fmtShort(p.date);
      const m = li.querySelector('.mins'); if (m) m.textContent = ` · ${p.minutes} min`;
      li.classList.add('is-fresh');
      list.prepend(li);
    }
    const max = Number(list.dataset.max); if (max) [...list.children].slice(max).forEach((c) => c.remove());
    if (fresh.length) list.dispatchEvent(new CustomEvent('oa:fresh', { bubbles: true }));
  });
</script>

<style>
  .dispatches { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(42, 32, 23, .25); }
  .dispatches :global(li.is-fresh) { animation: fresh-in .6s ease both; }
  @keyframes fresh-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .dispatches :global(li.pg-off) { display: none; }
  .dispatches { scroll-margin-top: 110px; }
  .dl-pager { margin-top: 44px; }
  .dispatches li { border-bottom: 1px solid rgba(42, 32, 23, .18); position: relative; }
  .title::after { content: ''; position: absolute; inset: 0; }   /* the whole row opens the piece */
  .author { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 10px; min-width: 0; transition: color .25s; }
  a.author:hover .who { color: var(--oxblood); }
  .dark a.author:hover .who { color: var(--ember); }
  .who { white-space: nowrap; }
  .row-link { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 32px; align-items: center; padding: 28px 0; }
  .thumb { display: block; aspect-ratio: 3 / 2; overflow: hidden; background: #DDD5C6; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease, ease); }
  .text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .kicker { color: var(--oxblood); }
  .title { font-size: 30px; transition: color .3s; }
  .summary {
    font-size: 19px; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .byline { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
  .byline .lab { font-size: 10px; letter-spacing: .2em; }
  .byline { flex-wrap: nowrap; min-width: 0; }
  .by { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .short { display: none; }
  .dispatches li:hover .title { color: var(--oxblood); }
  .dispatches li:hover .thumb img { transform: scale(1.05); }

  /* Dark sections */
  .dispatches.dark { border-top-color: rgba(243, 236, 220, .14); }
  .dispatches.dark li { border-bottom-color: rgba(243, 236, 220, .1); }
  .dark .kicker { color: var(--ember); }
  .dark .summary { color: var(--muted-dark); }
  .dark .byline .lab { color: #A9A294; }
  .dark .thumb { background: #14180F; }
  .dispatches.dark li:hover .title { color: var(--ember); }

  /* Phones: text first, a small square photo on the right, one tidy row per dispatch. */
  @media (max-width: 700px) {
    .row-link { grid-template-columns: minmax(0, 1fr) 84px; gap: 16px; align-items: start; padding: 20px 0; }
    .thumb { order: 2; aspect-ratio: 1; margin-top: 4px; }
    .title { font-size: 21px !important; line-height: 1.2; }
    .kicker { font-size: 9px; }
    .summary { font-size: 16px; }
    .byline { margin-top: 4px; gap: 8px; }
    .author { gap: 8px; }
    .byline .lab { font-size: 9px; letter-spacing: .14em; }
    .long, .mins { display: none; }
    .short { display: inline; }
    /* Each dispatch its own card, like the forum's threads: rounded, padded, easy to tap */
    .dispatches { border-top: 0; display: flex; flex-direction: column; gap: 10px; }
    .dispatches li { border-bottom: 0; border-radius: 14px; background: rgba(42, 32, 23, .045); box-shadow: inset 0 0 0 1px rgba(42, 32, 23, .12); overflow: hidden; }
    .dispatches.dark li { background: rgba(243, 236, 220, .035); box-shadow: inset 0 0 0 1px rgba(243, 236, 220, .1); }
    .dispatches li:active { background: rgba(98, 55, 45, .07); }
    .dispatches.dark li:active { background: rgba(255, 227, 163, .06); }
    .row-link { padding: 14px 14px 14px 16px; gap: 14px; }
    .thumb { border-radius: 10px; margin-top: 2px; }
  }
</style>
