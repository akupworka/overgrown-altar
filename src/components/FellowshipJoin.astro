---
// The Fellowship sign-up card (name, email): used on /join/. Sends to netlify/functions/join-fellowship.mts.
---
<div class="fs-card">
  <span class="eb">Join</span>
  <h2 class="h2 fs-h">Take your place.</h2>
  <p class="it mut fs-sub">It’s free. We’ll email you a link to choose your password.</p>
  <form class="fs-form" novalidate>
    <label class="fs-lbl"><span class="lab">Your name</span><input class="field" name="name" autocomplete="name" required maxlength="80" /><span class="fs-taken" role="alert" hidden>Taken · please choose another name</span></label>
    <label class="fs-lbl"><span class="lab">Email</span><input class="field" name="email" type="email" autocomplete="email" inputmode="email" required /></label>
    <label class="fs-trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
    <label class="fs-rule"><input type="checkbox" name="keep-rule" value="yes" required /><span>I have read <a href="/rule/" target="_blank" rel="noopener">the Rule of the House</a>, and will keep it.</span></label>
    <button type="submit" class="btn fs-go">Join the Fellowship</button>
    <p class="it fs-msg" role="status"></p>
  </form>
  <div class="fs-done" hidden>
    <p class="fs-done-h">Check your email.</p>
    <p class="it mut">A welcome letter is on its way to <b class="fs-to"></b>. Open it and choose your password to take your place.</p>
    <p class="fs-wait"><b>Give it up to ten minutes,</b> and look in your junk or spam folder if it isn’t in your inbox.</p>
  </div>
  <p class="lab mut fs-alt">Already one of us? <a href="/guild/desk/">Sign in</a> · Writers: <a href="/guild/">apply to the Guild</a></p>
</div>

<script>
  import { supabase } from '../lib/supabase';
  const form = document.querySelector<HTMLFormElement>('.fs-form')!;
  const msg = form.querySelector<HTMLElement>('.fs-msg')!, go = form.querySelector<HTMLButtonElement>('.fs-go')!;
  const since = Date.now();
  // An editor's name can't be taken: say so as it is typed, and hold the button until the name changes.
  const nameBox = form.querySelector<HTMLInputElement>('input[name="name"]')!, takenMsg = form.querySelector<HTMLElement>('.fs-taken')!;
  let wait = 0, asked = '';
  const isTaken = async (n: string) => { const { data } = await supabase.rpc('name_taken', { n }); return data === true; };
  const showTaken = (on: boolean) => { takenMsg.hidden = !on; go.disabled = on; if (on) nameBox.setAttribute('aria-invalid', 'true'); else nameBox.removeAttribute('aria-invalid'); };
  nameBox.addEventListener('input', () => {
    clearTimeout(wait); const n = nameBox.value.trim(); asked = n;
    if (!n) return showTaken(false);
    wait = window.setTimeout(async () => { const t = await isTaken(n).catch(() => false); if (asked === n) showTaken(t); }, 250);
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form), name = String(f.get('name') ?? '').trim(), email = String(f.get('email') ?? '').trim();
    if (!name) { msg.textContent = 'Please tell us your name.'; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'That email address doesn’t look right.'; return; }
    if (!f.get('keep-rule')) { msg.textContent = 'Please read the Rule of the House, and tick the box to say you will keep it.'; return; }
    go.disabled = true; go.textContent = 'One moment…'; msg.textContent = '';
    if (await isTaken(name).catch(() => false)) { go.textContent = 'Join the Fellowship'; showTaken(true); return; }
    const res = await fetch('/.netlify/functions/join-fellowship', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, email, website: f.get('website'), since }) }).catch(() => null);
    const out = res ? await res.json().catch(() => ({})) : {};
    go.disabled = false; go.textContent = 'Join the Fellowship';
    if (!res || !res.ok || !out.ok) { msg.textContent = out.error || 'Something went wrong. Please try again.'; return; }
    form.hidden = true;
    const done = document.querySelector<HTMLElement>('.fs-done')!; done.hidden = false;
    done.querySelector('.fs-to')!.textContent = out.email;
  });
</script>

<style>
  .fs-card { width: 100%; max-width: 520px; display: flex; flex-direction: column; gap: 14px; padding: 40px 36px; border-radius: 20px;
      background: linear-gradient(180deg, #171B13, #0E110C); box-shadow: inset 0 1px 0 rgba(255, 236, 190, .1), inset 0 0 0 1px rgba(255, 227, 163, .3); }
  .fs-h { margin: 0; }
  .fs-sub { margin: 0 0 8px; font-size: 18px; }
  .fs-form { display: flex; flex-direction: column; gap: 18px; }
  .fs-lbl { display: flex; flex-direction: column; gap: 8px; }
  .fs-lbl .field { color-scheme: dark; }
  .fs-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .fs-go { margin-top: 6px; }
  .fs-go:disabled { opacity: .6; }
  .fs-taken { font-family: var(--sans); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #E8A091; }
  .fs-taken[hidden] { display: none; }
  .fs-lbl .field[aria-invalid='true'] { box-shadow: inset 0 0 0 1px rgba(232, 160, 145, .7); }
  .fs-msg { margin: 0; min-height: 1.2em; font-size: 17px; color: var(--ember); }
  .fs-rule { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 12px; align-items: start; padding: 14px 16px; border-radius: 12px; cursor: pointer;
    font-family: var(--serif); font-size: 17px; line-height: 1.4; color: #E6DFD0; background: rgba(255, 227, 163, .07); box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .45); }
  .fs-rule input { width: 18px; height: 18px; margin: 3px 0 0; accent-color: #E2B84E; }
  .fs-rule a { color: var(--ember); border-bottom: 1px solid rgba(255, 227, 163, .45); }
  .fs-done[hidden], .fs-form[hidden] { display: none; }
  .fs-done-h { margin: 0 0 8px; font-family: var(--serif); font-size: 28px; color: var(--ember); }
  .fs-done p { margin: 0; font-size: 18px; line-height: 1.5; }
  .fs-done .fs-wait { margin-top: 16px; padding: 14px 16px; border-radius: 12px; font-family: var(--serif); font-size: 17px; color: var(--bone); background: rgba(255, 227, 163, .07); box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .45); }
  .fs-done .fs-wait b { font-weight: 500; color: var(--ember); }
  .fs-alt { margin-top: 10px; font-size: 9.5px; line-height: 2; }
  .fs-alt a { color: var(--ember); border-bottom: 1px solid rgba(255, 227, 163, .35); }
  @media (max-width: 700px) { .fs-card { padding: 28px 20px; } }
</style>
