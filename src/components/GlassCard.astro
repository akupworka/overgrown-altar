---
// The glowing glass card from the Guild Desk, ready to use anywhere:
//   <GlassCard> ...anything... </GlassCard>
//
// Layers, back to front:
//   1. a halo: a turning ring of the five glass colours, softly blurred around the card;
//   2. the edge: the same ring, seen through a thin gap around the pane;
//   3. the pane: frosted glass that blurs and lifts whatever is behind it,
//      with a sheen across the top and a fine grain, like real glass.
//
// Smoothness: the colour rings are drawn once and only rotated, and the blur on the halo
// is applied by the graphics card, so nothing is repainted while it moves.
import '../styles/glass.css';
interface Props { class?: string; style?: string }
const { class: cls = '', style = '' } = Astro.props;
---
<div class:list={['glass-card', cls]} style={style}>
  <div class="gc-halo" aria-hidden="true"><div class="gc-clip"><span></span></div></div>
  <div class="gc-edge" aria-hidden="true"><span></span></div>
  <div class="gc-pane"><slot /></div>
</div>

