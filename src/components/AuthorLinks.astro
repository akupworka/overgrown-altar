---
// A writer's website and Instagram as two small hairline pills, each with a drawn icon
// (never an emoji, which phones would turn into colored boxes).
interface Props { website?: string; instagram?: string; email?: string; tone?: 'paper' | 'dark' }
const { website = '', instagram = '', email = '', tone = 'paper' } = Astro.props;
// Only a real web address becomes a link (the form adds https://; anything else, such as a script, is never shown).
const site = /^https?:\/\//i.test(website) ? website.replace(/^https?:\/\//i, '').replace(/^www\./, '').replace(/\/$/, '') : '';
const handle = instagram.replace(/^@/, '');
---
{(site || handle || email) && (
  <span class:list={['al', `al-${tone}`]}>
    {site && (
      <a href={website} target="_blank" rel="noopener noreferrer" aria-label={`Website: ${site} (opens in a new tab)`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.8 3.8 5.8 3.8 9s-1.2 6.2-3.8 9c-2.6-2.8-3.8-5.8-3.8-9S9.4 5.8 12 3z"/></svg>
        <span>{site}</span>
      </a>
    )}
    {handle && (
      <a href={`https://instagram.com/${handle}`} target="_blank" rel="noopener noreferrer" aria-label={`Instagram: @${handle} (opens in a new tab)`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"/></svg>
        <span>@{handle}</span>
      </a>
    )}
    {email && (
      <a href={`mailto:${email}`} aria-label={`Email ${email}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
        <span class="al-mail">{email}</span>
      </a>
    )}
  </span>
)}
<style>
  .al { display: flex; flex-wrap: wrap; gap: 10px; }
  .al a { display: inline-flex; align-items: center; gap: 9px; max-width: 100%; padding: 9px 15px 9px 13px; border-radius: 999px;
    font-family: var(--sans); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap;
    box-shadow: inset 0 0 0 1px rgba(42, 32, 23, .22); color: var(--ink); transition: box-shadow .3s, color .3s, background-color .3s; }
  .al a span { overflow: hidden; text-overflow: ellipsis; }
  .al-mail { text-transform: none; letter-spacing: .06em; font-size: 12px; }
  .al a svg { flex: none; color: var(--oxblood); }
  .al a:hover { color: var(--oxblood); box-shadow: inset 0 0 0 1px rgba(98, 55, 45, .55); background: rgba(98, 55, 45, .04); }
  .al.al-dark a { color: var(--bone); box-shadow: inset 0 0 0 1px rgba(243, 236, 220, .25); }
  .al.al-dark a svg { color: var(--ember); }
  .al.al-dark a:hover { color: var(--ember); box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .55); background: rgba(255, 227, 163, .04); }
</style>
