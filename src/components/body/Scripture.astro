---
const { node } = Astro.props;
---
<blockquote class="scripture">
  <span class="it" style="font-size:24px;line-height:1.3">{node.text}</span>
  {node.reference && <cite class="eb" style="display:block;margin-top:10px;font-size:11px;font-style:normal">{node.reference}</cite>}
</blockquote>
<style>.scripture { margin: 0; padding: 22px 0 22px 26px; border-left: 2px solid var(--brass); }</style>
