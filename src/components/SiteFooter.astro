---
// The footer at the bottom of every page: the mark on one side, three small labelled groups of links on the other,
// and one quiet line at the very bottom. On phones the groups sit side by side, so the footer stays short.
import Wordmark from './Wordmark.astro';

const groups = [
  { title: 'Read', links: [
    { href: '/watchtower', label: 'The Watchtower' },
    { href: '/hearth', label: 'The Hearth' },
    { href: '/perimeter', label: 'The Perimeter' },
    { href: '/gallery/', label: 'The Gallery' },
    { href: '/folios', label: 'Folios' },
    { href: '/archive', label: 'Archive' },
    { href: '/crafts/', label: 'The Crafts' },
  ] },
  { title: 'The House', links: [
    { href: '/start-here', label: 'Start Here' },
    { href: '/about', label: 'About' },
    { href: '/manifesto', label: 'Manifesto' },
    { href: '/beliefs', label: 'What We Believe' },
    { href: '/contact', label: 'Contact' },
  ] },
  { title: 'The Guild', links: [
    { href: '/join/#fellowship', label: 'Join the Fellowship', who: 'guest' },
    { href: '/join/#guild', label: 'Apply to the Guild', who: 'guest' },
    { href: '/guild/desk/', label: 'Sign in', who: 'guest' },
    { href: '/guild/desk/', label: 'My Desk', who: 'member' },
    { href: '/guild/members/?view=forum', label: 'The Forum', who: 'member' },
    { href: '/guild/members/', label: 'The Guild', who: 'member', cls: 'for-guild' },
    { href: '/guild/members/?view=way', label: 'The Way', who: 'member', cls: 'for-fellow' },
  ] },
];
const year = new Date().getFullYear();
---
<footer class="foot night">
  <div class="foot-g">
    <div class="foot-mark">
      <a href="/" aria-label="Overgrown Altar, home"><Wordmark width={250} mobileWidth={190} /></a>
      <span class="it foot-motto">We light the signal fires on the perimeter.</span>
    </div>
    <nav class="foot-links" aria-label="Footer">
      {groups.map((g) => (
        <div class="foot-group">
          <span class="foot-h">{g.title}</span>
          {g.links.map((l: any) => <a href={l.href} class={l.cls} data-guest={l.who === 'guest' ? '' : undefined} data-member={l.who === 'member' ? '' : undefined}>{l.label}</a>)}
        </div>
      ))}
    </nav>
  </div>
  <div class="foot-b">
    <span>© {year} Overgrown Altar · Est. MMXXVI</span>
    <a href="/legal">Disclaimer · Privacy · Terms</a>
  </div>
</footer>

<style>
  :global(html:not([data-member])) .foot [data-member], :global(html[data-member]) .foot [data-guest] { display: none !important; }
  .foot { padding: 88px 120px 40px; }
  .foot-g { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 64px; align-items: start; }
  .foot-mark { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .foot-mark :global(.wordmark) { margin-left: -6px; }
  .foot-motto { font-size: 19px; color: var(--muted-dark); }
  .foot-links { display: grid; grid-template-columns: repeat(3, auto); gap: 64px; }
  .foot-group { display: flex; flex-direction: column; gap: 12px; }
  .foot-h { font-family: var(--serif); font-size: 12px; letter-spacing: .34em; text-transform: uppercase; color: var(--ember); margin-bottom: 4px; }
  .foot-group a { font-family: var(--serif); font-size: 18px; line-height: 1.25; color: #CFC8B8; transition: color .25s; }
  .foot-group a:hover { color: var(--ember); }
  .foot-b {
    max-width: 1200px; margin: 64px auto 0; padding-top: 22px; border-top: 1px solid rgba(243,236,220,.12);
    display: flex; justify-content: space-between; gap: 16px;
    font-family: var(--sans); font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: #8C8679;
  }
  .foot-b a:hover { color: var(--ember); }
  @media (max-width: 1100px) {
    .foot { padding: 72px 48px 36px; }
    .foot-g { grid-template-columns: minmax(0, 1fr); gap: 44px; }
  }
  @media (max-width: 700px) {
    .foot { padding: 56px 24px 30px; }
    .foot-g { gap: 36px; }
    .foot-mark { align-items: center; text-align: center; }
    .foot-mark :global(.wordmark) { margin-left: 0; }
    .foot-motto { font-size: 17px; }
    .foot-links { grid-template-columns: 1fr 1fr; gap: 28px 20px; padding-top: 28px; border-top: 1px solid rgba(243,236,220,.1); }
    .foot-group:last-child { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: 10px 20px; }
    .foot-group:last-child .foot-h { flex-basis: 100%; margin-bottom: 0; }
    .foot-group { gap: 10px; }
    .foot-group a { font-size: 17px; }
    .foot-b { margin-top: 36px; flex-direction: column; align-items: center; text-align: center; gap: 10px; font-size: 9px; letter-spacing: .18em; }
  }
</style>
