  <span class="arrival-word">Overgrown Altar</span>
</div>
<script>
  const root = document.documentElement;
  if (root.dataset.arrive) {
    const done = () => { root.classList.add('arrived'); try { localStorage.setItem('oa_arrived', '1'); } catch {} setTimeout(() => root.removeAttribute('data-arrive'), 900); };
    const t = setTimeout(done, 2500);
    const skip = () => { clearTimeout(t); done(); };
    addEventListener('click', skip, { once: true }); addEventListener('keydown', skip, { once: true });
  }
</script>
<style is:global>
  .arrival { display: none; }
  html[data-arrive] .arrival {
    display: flex; position: fixed; inset: 0; z-index: 1000; flex-direction: column; align-items: center; justify-content: center; gap: 28px;
    background: #050605; transition: opacity .9s cubic-bezier(.16, 1, .3, 1);
  }
  html[data-arrive] body { overflow: hidden; }
  html.arrived .arrival { opacity: 0; pointer-events: none; }
  html.arrived body { overflow: auto; }
  .arrival-light { position: absolute; width: 520px; height: 520px; border-radius: 50%; opacity: 0;
    background: radial-gradient(closest-side, rgba(255, 214, 140, .22), rgba(255, 196, 77, .05) 60%, transparent);
    animation: arr-light 2.4s .3s ease-out forwards; }
  .arrival-cross { position: relative; overflow: visible; }
  .arrival-stroke { fill: none; stroke: #FFE3A3; stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; animation: arr-draw 1.6s .15s cubic-bezier(.65, 0, .35, 1) forwards; }
  .arrival-fill { fill: #FFE3A3; opacity: 0; animation: arr-fill .8s 1.45s ease-out forwards; }
  .arrival-word { position: relative; font-family: var(--serif); font-size: 13px; font-weight: 600; letter-spacing: .5em; text-transform: uppercase; color: #CFC8B8; opacity: 0;
    animation: arr-word 1s 1.3s ease-out forwards; }
  @keyframes arr-draw { to { stroke-dashoffset: 0; } }
  @keyframes arr-fill { to { opacity: 1; } }
  @keyframes arr-word { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes arr-light { 0% { opacity: 0; transform: scale(.8); } 60% { opacity: 1; } 100% { opacity: .85; transform: scale(1); } }
</style>
