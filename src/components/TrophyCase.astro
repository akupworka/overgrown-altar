---
// A writer's trophies, earned ones only (public pages). Built from their published pieces and their page.
import { trophiesFor, trophySvg, TIER_LABEL, type TrophyCtx } from '../lib/trophies';
import '../styles/trophies.css';
interface Props { ctx: TrophyCtx; tone?: 'dark' | 'paper' }
const { ctx, tone = 'paper' } = Astro.props;
const earned = trophiesFor(ctx).filter((t) => t.earned).map((t) => t.trophy);
---
{earned.length > 0 && (
  <section class:list={['tc', { 'paper-tone': tone === 'paper' }]}>
    <div class="tc-head"><span class="eb">Trophies</span><a class="lab mut" href="/guild/members/?view=prestige#trophies">{earned.length} earned · see all</a></div>
    <div class="tc-grid">
      {earned.map((t) => (
        <figure class="tr" data-tier={t.tier} title={t.note}>
          <Fragment set:html={trophySvg(t)} />
          <span class="tr-name">{t.name}</span>
          <span class="tr-tier">{TIER_LABEL[t.tier]}</span>
          <span class="tr-note">{t.note}</span>
        </figure>
      ))}
    </div>
  </section>
)}
