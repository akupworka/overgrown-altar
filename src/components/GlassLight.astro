---
// Stained light: colour that enters only through glass.
// The prism is the five glass colours from the brand cover (red, gold, green, blue, violet),
// softly blurred and slowly turning. The beams are light falling from a window.
//
// Built for smoothness: each layer is drawn once, and the animation only rotates, moves
// or fades it, which the graphics card does without redrawing anything. Every edge fades
// out to nothing, so there are no hard lines.
//
// Place it inside a section with position:relative. Use it like:
//   <GlassLight prism beams style="right:-10%;top:-20%" />
interface Props { prism?: boolean; beams?: boolean; size?: number; intensity?: number; style?: string }
const { prism = true, beams = false, size = 520, intensity = 1, style = '' } = Astro.props;
---
<div class="glass-light" aria-hidden="true" style={`--size:${size}px;--k:${intensity};${style}`}>
  {prism && <div class="halo"></div>}
  {prism && <div class="prism"></div>}
  {beams && <div class="beams"><div class="beam-set"></div></div>}
</div>

<style>
  .glass-light {
    position: absolute; width: min(var(--size), 92vw); aspect-ratio: 1;
    pointer-events: none; z-index: 0; opacity: var(--k);
  }
  .halo, .prism, .beams { position: absolute; will-change: transform, opacity; }

  /* Warm candle-light behind everything. */
  .halo {
    inset: -30%; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 214, 140, .26), rgba(255, 196, 77, .08) 55%, rgba(255, 196, 77, 0));
    animation: breathe 9s ease-in-out infinite;
  }
  /* The prism: a turning wheel of the five glass colours. */
  .prism {
    inset: 8%; border-radius: 50%;
    background: conic-gradient(from 20deg,
      rgba(255, 59, 78, .46), rgba(255, 196, 77, .46), rgba(61, 224, 160, .38),
      rgba(62, 123, 255, .46), rgba(176, 91, 255, .42), rgba(255, 59, 78, .46));
    filter: blur(50px);
    animation: turn 48s linear infinite;
  }
  /* The beams: four soft coloured shafts, faded out at the top, bottom and sides. */
  .beams {
    inset: -10% -25% -60% -25%;
    -webkit-mask-image: radial-gradient(ellipse 55% 60% at 50% 35%, #000 25%, transparent 75%);
    mask-image: radial-gradient(ellipse 55% 60% at 50% 35%, #000 25%, transparent 75%);
    animation: sway 16s ease-in-out infinite alternate;
  }
  .beam-set {
    position: absolute; inset: 0; transform: skewX(-22deg);
    background: linear-gradient(90deg,
      transparent 30%, rgba(62, 123, 255, .5) 36%, rgba(62, 123, 255, .0) 41%,
      rgba(176, 91, 255, .38) 43%, rgba(255, 59, 78, .5) 46%, rgba(255, 59, 78, 0) 50%,
      rgba(255, 196, 77, .52) 53%, rgba(255, 196, 77, 0) 58%,
      rgba(61, 224, 160, .4) 61%, transparent 67%);
    filter: blur(18px);
    animation: shimmer 7s ease-in-out infinite alternate;
  }

  @keyframes turn { to { transform: rotate(360deg); } }
  @keyframes breathe { 0%, 100% { opacity: .8; transform: scale(1); } 50% { opacity: 1; transform: scale(1.05); } }
  @keyframes sway { from { transform: translateX(-3%) rotate(-2deg); } to { transform: translateX(3%) rotate(2deg); } }
  @keyframes shimmer { from { opacity: .7; } to { opacity: 1; } }

  /* Phones: smaller and softer, so it never floods the screen. */
  @media (max-width: 700px) {
    .glass-light { width: min(calc(var(--size) * .75), 86vw); opacity: calc(var(--k) * .85); }
  }
  @media (prefers-reduced-motion: reduce) {
    .halo, .prism, .beams, .beam-set { animation: none; }
  }
</style>
