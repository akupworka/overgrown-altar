---
// Stained light: colour that enters only through glass.
// The prism is the five glass colours from the brand cover (red, gold, green, blue, violet),
// blurred and slowly turning. The beams are light falling from a window and drifting.
// Place it inside a section with position:relative. Use it like:
//   <GlassLight prism beams style="right:-10%;top:-20%" />
interface Props { prism?: boolean; beams?: boolean; size?: number; intensity?: number; style?: string }
const { prism = true, beams = false, size = 520, intensity = 1, style = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7); // keeps gradient ids unique if used twice on a page
---
<div class="glass-light" aria-hidden="true" style={`--size:${size}px;--k:${intensity};${style}`}>
  {prism && <div class="prism"></div>}
  {prism && <div class="halo"></div>}
  {beams && (
    <svg class="beams" viewBox="0 0 400 533" preserveAspectRatio="none">
      <defs>
        {[['b1', '#FF3B4E'], ['b2', '#FFC44D'], ['b3', '#3DE0A0'], ['b4', '#3E7BFF']].map(([id, c]) => (
          <linearGradient id={`${id}-${uid}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color={c} stop-opacity=".8" /><stop offset="1" stop-color={c} stop-opacity=".03" />
          </linearGradient>
        ))}
        <filter id={`blur-${uid}`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="9" /></filter>
      </defs>
      <g filter={`url(#blur-${uid})`}>
        <polygon class="beam" points="160,0 185,0 330,533 250,533" fill={`url(#b1-${uid})`} />
        <polygon class="beam" points="185,10 208,10 400,533 330,533" fill={`url(#b2-${uid})`} />
        <polygon class="beam" points="208,20 228,20 400,450 400,533" fill={`url(#b3-${uid})`} />
        <polygon class="beam" points="140,0 160,0 250,533 175,533" fill={`url(#b4-${uid})`} />
      </g>
    </svg>
  )}
</div>

<style>
  /* An animatable angle, so the conic gradient can turn smoothly. */
  @property --turn { syntax: '<angle>'; inherits: false; initial-value: 20deg; }

  .glass-light { position: absolute; width: var(--size); height: var(--size); pointer-events: none; z-index: 0; mix-blend-mode: screen; }
  .prism {
    position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from var(--turn),
      rgba(255,59,78,.34), rgba(255,196,77,.34), rgba(61,224,160,.28), rgba(62,123,255,.34), rgba(176,91,255,.32), rgba(255,59,78,.34));
    filter: blur(70px); opacity: calc(.9 * var(--k));
    animation: turn 36s linear infinite, drift 18s ease-in-out infinite alternate;
  }
  .halo {
    position: absolute; inset: -40%; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255,214,140,.30), rgba(255,196,77,.08) 55%, rgba(255,196,77,0));
    opacity: var(--k); animation: breathe 7s ease-in-out infinite;
  }
  .beams { position: absolute; inset: -10% -10% -30% -10%; width: 120%; height: 140%; opacity: calc(.75 * var(--k)); transform-origin: 45% 0; animation: sway 14s ease-in-out infinite alternate; }
  .beam { animation: shimmer 6s ease-in-out infinite alternate; }
  .beam:nth-child(2) { animation-delay: -1.5s; }
  .beam:nth-child(3) { animation-delay: -3s; }
  .beam:nth-child(4) { animation-delay: -4.5s; }

  @keyframes turn { to { --turn: 380deg; } }
  @keyframes drift { from { transform: translate(-4%, -3%) scale(1); } to { transform: translate(5%, 4%) scale(1.12); } }
  @keyframes breathe { 0%, 100% { opacity: calc(.8 * var(--k)); transform: scale(1); } 50% { opacity: var(--k); transform: scale(1.06); } }
  @keyframes sway { from { transform: rotate(-3deg) translateX(-2%); } to { transform: rotate(3deg) translateX(2%); } }
  @keyframes shimmer { from { opacity: .55; } to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .prism, .halo, .beams, .beam { animation: none; }
  }
</style>
