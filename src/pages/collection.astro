---
// A Fellowship member's collection, open to everyone: /collection/?of=<member id>.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import PublicCollection from '../components/desk/PublicCollection.tsx';
import '../styles/desk.css';
---
<BaseLayout title="A collection" description="Pieces and photographs gathered by a member of the Fellowship of the Overgrown Altar.">
  <section class="night pc-page">
    <SiteNav />
    <div class="pc-in"><PublicCollection client:only="react" /></div>
  </section>
</BaseLayout>
