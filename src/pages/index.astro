---
// The Home page. Every file in src/pages becomes a page on the site:
//   src/pages/index.astro  ->  overgrownaltar.com/
//   src/pages/about.astro  ->  overgrownaltar.com/about
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Wordmark from '../components/Wordmark.astro';
import Subscribe from '../components/Subscribe.astro';

// The content lives in lists like these for now.
// In step 2 these will come from Sanity, so you can edit them without code.
const articles = [
  { n: 'I', title: 'Built Without Tools of Pride', text: 'We reject the polished, man-made altars of secular cynicism and performative intellect. In the ancient law, if a tool touched the altar stone, it was defiled. We build with unvarnished raw material—high craft, deep reverence, and unarmored truth.' },
  { n: 'II', title: 'Beauty Reclaimed', text: 'High-level design, spatial order, and atmospheric visual craft do not belong to the cynic, the narcissist, or the self-serving. They belong entirely to the Living God. We reclaim aesthetic excellence from the posturing of modern art and restore it to sacred ground.' },
  { n: 'III', title: 'The Inklings’ Table', text: 'We do not build digital stages for central gurus or performative influencers. We cultivate a guild—a gathering of sharp minds, soft hearts, and unyielding spirits who gather around the hearth to write, sharpen, and discern together.' },
  { n: 'IV', title: 'Unmasking the Script', text: 'We name the invisible mechanics. We dismantle the intellectual counterfeits—from Freud to Bukowski—that keep human souls trapped in ironies and strongholds. We light the signal fires on the perimeter.' },
];

const pillars = [
  { href: '/watchtower', img: '/images/duomo-spires.jpg', pos: 'center 30%', mono: true, kicker: '01 · Prophetic Audits', name: 'The Watchtower', text: 'Long-form dispatches and cultural essays unmasking psychological scripts, secular idols (from Freud and Bukowski to modern digital posturing), and Leviathan structures in art and philosophy.' },
  { href: '/hearth', img: '/images/window-of-the-ascension-and.jpg', pos: 'center 45%', mono: false, kicker: '02 · Creative Guild', name: 'The Hearth', text: 'An Inklings-style fellowship space hosting dark atmospheric monochrome photography, original prose, architectural studies, design teardowns, and fiction.' },
  { href: '/perimeter', img: '/images/pillar-perimeter.jpg', pos: 'center 55%', mono: true, kicker: '03 · Testimony & the Unseen', name: 'The Perimeter', text: 'Writing from the edge of the unseen: deliverance stories, testimonies, recovery and personal accounts of the spirit world, told honestly and anchored in Christ.' },
];


import GlassLight from '../components/GlassLight.astro';
import Avatar from '../components/Avatar.astro';

// The homepage shows writing from The Watchtower only: its four newest pieces, Guild and foundational alike.
const watchtowerFeed = (await inPillar('watchtower')).slice(0, 4);
const [lead, ...more] = watchtowerFeed;
const fmtDate = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// The Guild's writers, as arches (those with published work).
const writers = (await getAuthors()).slice(0, 6).map(({ author }) => author);
import { inPillar } from '../lib/catalog';
import { getAuthors } from '../lib/guild';
---
<BaseLayout>

  <!-- 1. Hero: full-bleed photo, wordmark, tagline, two buttons -->
  <section class="hero home-hero">
    <img src="/images/folios-photo-2.jpg" srcset="/images/folios-photo-2-1200.jpg 1200w, /images/folios-photo-2.jpg 2576w" sizes="100vw" alt="A Gothic nave rising to three stained-glass windows"
      style="object-position:center 62%;filter:brightness(.6) saturate(.9)" fetchpriority="high" />
    <div class="veil"></div>
    <GlassLight prism beams size={620} intensity={0.85} style="right:4%;top:-6%" />
    <SiteNav />
    <div class="hero-c">
      <h1 class="visually-hidden">Overgrown Altar</h1>
      <Wordmark width={760} mobileWidth={330} />
      <p class="it hero-tag">Craft, Discernment &amp; The Reclaimed Hearth.</p>
      <p class="hero-what">An independent journal, creative sanctuary and deliverance guild.</p>
      <div class="hero-cta">
        <a class="btn" href="/watchtower">Read the Dispatches</a>
        <a class="ghost" href="/start-here">Start Here</a>
      </div>
    </div>
  </section>

  <!-- 2. The Core Thesis: photo with text on the left -->
  <section class="hero thesis">
    <img src="/images/labyrinth-stained-light.jpg" srcset="/images/labyrinth-stained-light-1200.jpg 1200w, /images/labyrinth-stained-light.jpg 2000w" sizes="100vw" alt="Stained-glass light falling across a stone labyrinth in a dark cathedral" style="object-position:60% 60%;filter:brightness(.85)" loading="lazy" />
    <div class="veil-l"></div>
    <div class="hin sec thesis-in">
      <span class="eb">The Core Thesis</span>
      <p class="big-it">Broken pieces of a mirror that Christ holds whole.</p>
      <p class="body" style="font-size:24px;color:#E6DFD0">The great secular minds each held a piece of the truth. Overgrown Altar exposes where their insights fractured for lack of a divine keystone, and anchors them back in the resurrection of Christ.</p>
    </div>
  </section>

  <!-- From The Watchtower: a journal's front page. One lead dispatch, large; the next three as cards. -->
  {lead && (
  <section class="sec paper wt-front">
    <div class="wt-front-in">
      <div class="wt-front-head">
        <div style="display:flex;flex-direction:column;gap:14px"><span class="eb">From The Watchtower</span><h2 class="h2">The latest dispatches</h2></div>
        <a class="lab wt-front-all" href="/watchtower">All dispatches →</a>
      </div>
      <article class="wt-lead">
        <a class="wt-lead-img" href={lead.href}><img src={lead.image} alt="" loading="lazy" /></a>
        <div class="wt-lead-text">
          <span class="lab wt-k">{lead.kicker}</span>
          <h3 class="wt-lead-t"><a href={lead.href}>{lead.title}</a></h3>
          {lead.standfirst && <p class="it wt-lead-sf">{lead.standfirst}</p>}
          <span class="wt-by">
            {lead.author.href ? <a href={lead.author.href} class="wt-who"><Avatar name={lead.author.name} src={lead.author.portrait} size={30} id={lead.author.id} /><span class="lab">{lead.author.name}</span></a>
              : <span class="wt-who"><Avatar name={lead.author.name} src={lead.author.portrait} size={30} /><span class="lab">{lead.author.name}</span></span>}
            <span class="lab mut">· {fmtDate(lead.date)}{lead.minutes ? ` · ${lead.minutes} min` : ''}</span>
          </span>
          <a class="btn" href={lead.href}>Read the dispatch</a>
        </div>
      </article>
      {more.length > 0 && (
        <div class="wt-cards">
          {more.map((d) => (
            <a class="wt-card" href={d.href}>
              <span class="wt-card-img"><img src={d.image} alt="" loading="lazy" /></span>
              <span class="wt-card-text">
                <span class="lab wt-k">{d.kicker}</span>
                <span class="wt-card-t">{d.title}</span>
                <span class="lab mut wt-card-by">{d.author.name} · {fmtDate(d.date)}</span>
              </span>
            </a>
          ))}
        </div>
      )}
      <div class="wt-more"><a class="ghost" href="/watchtower">Read more from The Watchtower <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  )}

  <!-- 4. The Three Core Pillars -->
  <section class="sec paper">
    <div class="row pillars-head">
      <div style="display:flex;flex-direction:column;gap:16px">
        <span class="eb">The Three Core Pillars</span>
        <h2 class="h2">Three rooms, one altar.</h2>
      </div>
      <span class="it mut" style="font-size:22px">Color enters only through glass.</span>
    </div>
    <div class="g3" style="margin-top:60px">
      {pillars.map((p) => (
        <a href={p.href} class="pillar">
          <div class="arch pillar-arch">
            <img src={p.img} srcset={`${p.img.replace('.jpg', '-1200.jpg')} 1200w, ${p.img} 2576w`} sizes="(max-width: 700px) 100vw, 33vw" alt="" class={p.mono ? 'mono' : undefined} style={`object-position:${p.pos}`} loading="lazy" />
          </div>
          <span class="eb" style="margin-top:28px;font-size:12px">{p.kicker}</span>
          <span class="cg pillar-name">{p.name}</span>
          <p class="body mut" style="margin-top:16px;font-size:20px">{p.text}</p>
          <span class="lab pillar-link">Enter {p.name}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 5. The Manifesto, in brief: four articles, one line each -->
  <section class="sec dark mani">
    <div class="mani-head">
      <span class="eb">The Launch Manifesto</span>
      <h2 class="h2">Four articles of the altar</h2>
    </div>
    <ol class="mani-list">
      {articles.map((a) => (
        <li><span class="num">{a.n}</span><span class="mani-t">{a.title}</span><span class="it mani-s">{a.text.split('. ')[0]}.</span></li>
      ))}
    </ol>
    <a class="ghost mani-go" href="/manifesto">Read the full manifesto</a>
  </section>

  <!-- 6. The Guild: its writers, and an open chair -->
  <section class="sec paper center guild-sec">
    <span class="eb">The Inklings’ Table</span>
    <h2 class="h2" style="margin-top:16px">Pull up a chair.</h2>
    <p class="it mut guild-lead">A guild of writers, photographers and makers who write, sharpen and discern together. Everything here passes through their hands, and the editor’s.</p>
    {writers.length > 0 && (
      <div class="writers">
        {writers.map((w) => (
          <a class="writer" href={`/guild/authors/${w.slug}/`}>
            <span class="writer-arch" data-author-id={w.id}>{w.portrait ? <img src={w.portrait} alt="" loading="lazy" /> : <span>{w.display_name.split(/\s+/).slice(0, 2).map((x) => x[0]).join('')}</span>}</span>
            <span class="writer-name">{w.display_name}</span>
            {w.craft && <span class="lab mut writer-craft">{w.craft}</span>}
          </a>
        ))}
      </div>
    )}
    <div class="guild-cta">
      <a class="btn" href="/guild" data-guest>Join the Guild</a>
      <a class="btn" href="/guild/desk/#write" data-member hidden>Write a piece</a>
      <a class="ghost" href="/hearth">Visit The Hearth</a>
    </div>
  </section>

  <!-- 7. Receive the Dispatches (newsletter sign-up) -->
  <Subscribe />

</BaseLayout>

<style>
  /* Hero */
  .home-hero { height: 940px; }
  .hero-c {
    position: absolute; left: 0; right: 0; top: 230px; z-index: 1;
    display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 20px;
  }
  .hero-tag { margin: 30px 0 0; font-size: 32px; line-height: 1.2; }
  @media (max-width: 700px) {
    .hero-tag { margin-top: 22px; font-size: 22px; max-width: 300px; }
    .hero-cta { flex-direction: column; align-items: stretch; width: min(100%, 300px); gap: 12px; margin-top: 36px; }
    .hero-cta .btn, .hero-cta .ghost { padding-top: 17px; padding-bottom: 17px; }
  }
  .hero-cta { margin-top: 42px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }

  .hero-what { margin: 14px 0 0; max-width: 520px; font-family: var(--sans); font-size: 11px; letter-spacing: .24em; line-height: 1.8; text-transform: uppercase; color: #CFC8B8; }

  /* From The Watchtower: a journal's front page */
  .wt-front-in { max-width: 1200px; margin: 0 auto; }
  .wt-front-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; padding-bottom: 28px; border-bottom: 1px solid rgba(42, 32, 23, .25); }
  .wt-front-all { border-bottom: 1px solid rgba(42, 32, 23, .4); padding-bottom: 3px; white-space: nowrap; }
  .wt-front-all:hover { color: var(--oxblood); border-color: var(--oxblood); }
  .wt-lead { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 56px; align-items: center; padding: 48px 0; }
  .wt-lead-img { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 999px 999px 0 0; box-shadow: 0 0 0 1px var(--brass), 0 0 0 8px var(--paper), 0 0 0 9px rgba(159, 148, 94, .4); }
  .wt-lead-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease, ease); }
  .wt-lead:hover .wt-lead-img img { transform: scale(1.04); }
  .wt-lead-text { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .wt-k { color: var(--oxblood); font-size: 10px; }
  .wt-lead-t { margin: 0; font-family: var(--serif); font-weight: 500; font-style: italic; font-size: 48px; line-height: 1.04; }
  .wt-lead-t a:hover { color: var(--oxblood); }
  .wt-lead-sf { margin: 0; font-size: 21px; line-height: 1.45; color: var(--muted-paper); }
  .wt-by { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .wt-who { display: inline-flex; align-items: center; gap: 10px; }
  a.wt-who:hover .lab { color: var(--oxblood); }
  .wt-by .lab { font-size: 10px; white-space: nowrap; }
  .wt-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; padding-top: 40px; border-top: 1px solid rgba(42, 32, 23, .2); }
  .wt-card { display: flex; flex-direction: column; gap: 14px; }
  .wt-card-img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #DDD5C6; }
  .wt-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease, ease); }
  .wt-card:hover .wt-card-img img { transform: scale(1.04); }
  .wt-card-text { display: flex; flex-direction: column; gap: 8px; }
  .wt-card-t { font-family: var(--serif); font-style: italic; font-size: 25px; line-height: 1.15; transition: color .3s; }
  .wt-card:hover .wt-card-t { color: var(--oxblood); }
  .wt-card-by { font-size: 9.5px; }
  .wt-more { margin-top: 48px; display: flex; justify-content: center; }

  /* The Manifesto, in brief */
  .mani { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .mani-head { display: flex; flex-direction: column; gap: 16px; align-items: center; }
  .mani-list { list-style: none; margin: 48px 0 0; padding: 0; width: 100%; max-width: 1100px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
  .mani-list li { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 8px 26px; }
  .mani-list li + li { border-left: 1px solid rgba(243, 236, 220, .14); }
  .mani-list .num { font-size: 44px; line-height: 1; }
  .mani-t { font-family: var(--serif); font-style: italic; font-size: 24px; line-height: 1.2; }
  .mani-s { font-size: 17px; line-height: 1.5; color: var(--muted-dark); }
  .mani-go { margin-top: 48px; }

  /* The Guild */
  .guild-lead { margin: 22px 0 0; max-width: 640px; font-size: 22px; line-height: 1.45; }
  .writers { margin-top: 52px; display: flex; flex-wrap: wrap; justify-content: center; gap: 36px 44px; }
  .writer { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 150px; }
  .writer-arch { width: 120px; height: 158px; border-radius: 999px 999px 0 0; overflow: hidden; display: flex; align-items: center; justify-content: center;
    background: #E3DCCD; color: var(--oxblood); font-family: var(--serif); font-size: 36px;
    box-shadow: 0 0 0 1px var(--brass), 0 0 0 6px var(--paper), 0 0 0 7px rgba(159, 148, 94, .4); transition: box-shadow .4s; }
  .writer-arch:has(img) { background: #E9E2D4; }
  .writer-arch :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease, ease); }
  .writer:hover .writer-arch :global(img) { transform: scale(1.05); }
  .writer-name { margin-top: 12px; font-family: var(--serif); font-size: 22px; line-height: 1.15; text-align: center; }
  .writer:hover .writer-name { color: var(--oxblood); }
  .writer-craft { font-size: 9px; text-align: center; }
  .guild-cta { margin-top: 52px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .guild-cta [hidden] { display: none; }

  /* Thesis */
  .thesis { min-height: 760px; display: flex; align-items: center; }
  .thesis-in { max-width: 900px; display: flex; flex-direction: column; gap: 28px; }

  /* Pillars */
  .pillars-head { padding-bottom: 34px; border-bottom: 1px solid var(--ink); }
  .pillar { display: flex; flex-direction: column; }
  .pillar-arch { height: 520px; }
  .pillar-name { margin-top: 12px; font-size: 38px; line-height: 1; letter-spacing: .04em; text-transform: uppercase; }
  .pillar-link { margin-top: 20px; align-self: flex-start; border-bottom: 1px solid var(--ink); padding-bottom: 4px; }
  .pillar:hover .pillar-link { color: var(--oxblood); border-color: var(--oxblood); }


  @media (max-width: 900px) {
    .wt-lead { grid-template-columns: minmax(0, 1fr); gap: 26px; padding: 32px 0; }
    .wt-cards { grid-template-columns: minmax(0, 1fr); gap: 0; padding-top: 0; }
    .wt-card { display: grid; grid-template-columns: minmax(0, 1fr) 96px; gap: 16px; align-items: start; padding: 20px 0; border-bottom: 1px solid rgba(42, 32, 23, .15); }
    .wt-card-img { order: 2; aspect-ratio: 1; }
  }
  @media (max-width: 700px) {
    .wt-front-head { flex-direction: column; align-items: flex-start; gap: 14px; padding-bottom: 20px; }
    .wt-lead-img { aspect-ratio: 4 / 3; }
    .wt-lead-t { font-size: 32px !important; }
    .wt-lead-sf { font-size: 18px; }
    .wt-lead .btn { align-self: stretch; text-align: center; }
    .wt-card-t { font-size: 20px; }
    .wt-more { margin-top: 32px; }
    .wt-more .ghost { width: 100%; text-align: center; }
    .hero-what { font-size: 10px; letter-spacing: .18em; max-width: 300px; }
    .mani-list { grid-template-columns: minmax(0, 1fr); margin-top: 30px; }
    .mani-list li { padding: 22px 0; }
    .mani-list li + li { border-left: 0; border-top: 1px solid rgba(243, 236, 220, .12); }
    .mani-list .num { font-size: 34px !important; }
    .mani-t { font-size: 22px; }
    .mani-s { font-size: 16px; }
    .mani-go { margin-top: 30px; }
    .guild-lead { font-size: 18px; }
    .writers { margin-top: 36px; gap: 28px 16px; }
    .writer { width: 140px; }
    .writer-arch { width: 104px; height: 136px; font-size: 30px; }
    .writer-name { font-size: 19px; }
    .guild-cta { flex-direction: column; align-items: stretch; width: min(100%, 300px); margin-left: auto; margin-right: auto; margin-top: 40px; }
    .guild-cta .btn, .guild-cta .ghost { text-align: center; }
  }
</style>
