---
// The full gallery: every photograph published at the Hearth, shown whole, newest first.
// Organized three ways: film or digital, by photographer, and newest or oldest first; twelve to a page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import { authorUrl, guildPillar, guildUrl } from '../../lib/guild';

const photos = (await guildPillar('hearth')).filter((g) => g.medium === 'photograph' && g.image).map((g) => ({
  href: guildUrl(g), title: g.title, image: g.image, alt: g.image_alt, date: g.published_at.slice(0, 10),
  format: g.photoMeta?.format || '', camera: g.photoMeta?.camera?.trim() || '', more: g.gallery?.length ?? 0,
  who: g.author.display_name, whoId: g.author.id ?? '', whoHref: authorUrl(g.author),
}));
const film = photos.filter((p) => p.format === 'film').length, digital = photos.filter((p) => p.format === 'digital').length;
const people = [...new Map(photos.map((p) => [p.whoId, { id: p.whoId, name: p.who, n: photos.filter((x) => x.whoId === p.whoId).length }])).values()]
  .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="The Gallery" description="Every photograph from the Hearth: dark, atmospheric photography by the Guild, on film and digital.">
  <section class="night ga-head">
    <SiteNav />
    <div class="ga-in">
      <a class="lab ga-back" href="/hearth#gallery">← The Hearth</a>
      <span class="eb">The Hearth · Photographs</span>
      <h1 class="h1">The Gallery</h1>
      <p class="it ga-sub">Stone in monochrome. Color only through glass. Every photograph the fellowship has brought to the fire, shown whole.</p>
      <span class="lab mut ga-total"><span class="ga-count">{photos.length}</span> {photos.length === 1 ? 'photograph' : 'photographs'}{film ? ` · ${film} on film` : ''}{digital ? ` · ${digital} digital` : ''}</span>
    </div>
  </section>

  <section class="dark ga-body">
    {photos.length > 0 ? (
      <>
        <div class="ga-tools">
          <div class="filters ga-filters" role="group" aria-label="Format">
            <button type="button" class="chip" aria-pressed="true" data-format="all">All<span class="chip-n">{photos.length}</span></button>
            {film > 0 && <button type="button" class="chip" aria-pressed="false" data-format="film">Film<span class="chip-n">{film}</span></button>}
            {digital > 0 && <button type="button" class="chip" aria-pressed="false" data-format="digital">Digital<span class="chip-n">{digital}</span></button>}
          </div>
          <div class="ga-selects">
            {people.length > 1 && (
              <label class="ga-sel"><span class="lab mut">Photographer</span>
                <select class="field" id="ga-who"><option value="all">Everyone</option>{people.map((p) => <option value={p.id}>{p.name} ({p.n})</option>)}</select>
              </label>
            )}
            <label class="ga-sel"><span class="lab mut">Order</span>
              <select class="field" id="ga-order"><option value="new">Newest first</option><option value="old">Oldest first</option></select>
            </label>
          </div>
        </div>
        <ol class="ga-wall">
          {photos.map((p) => (
            <li data-format={p.format || 'none'} data-who={p.whoId} data-date={p.date}>
              <a class="ga-ph" href={p.href}>
                <img src={p.image} alt={p.alt || p.title} loading="lazy" />
                {p.more > 0 && <span class="ga-more lab">+{p.more}</span>}
              </a>
              <span class="ga-cap">
                <a class="ga-t" href={p.href}>{p.title}</a>
                <span class="lab mut">{p.whoHref ? <a href={p.whoHref}>{p.who}</a> : p.who}{p.format ? ` · ${p.format === 'film' ? 'Film' : 'Digital'}` : ''}{p.camera ? ` · ${p.camera}` : ''} · {fmt(p.date)}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="it mut ga-none" hidden>No photographs here yet.</p>
        <nav class="pager ga-pager" aria-label="Pages of the gallery" hidden></nav>
      </>
    ) : (
      <p class="it mut ga-empty">The first photographs are being made. <a href="/guild/">Bring one to the fire →</a></p>
    )}
  </section>
  <Subscribe />
</BaseLayout>

<script>
  import { pagerHtml } from '../../lib/pager';
  // Film or digital, one photographer, newest or oldest; twelve to a page.
  const PER = 12;
  const wall = document.querySelector<HTMLElement>('.ga-wall');
  if (wall) {
    const items = [...wall.querySelectorAll<HTMLElement>(':scope > li')];
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.ga-filters .chip')];
    const who = document.querySelector<HTMLSelectElement>('#ga-who');
    const order = document.querySelector<HTMLSelectElement>('#ga-order')!;
    const pager = document.querySelector<HTMLElement>('.ga-pager')!;
    const none = document.querySelector<HTMLElement>('.ga-none')!;
    const count = document.querySelector('.ga-count')!;
    let format = 'all', page = 1;
    const draw = (scroll = false) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.format === format)));
      const sorted = [...items].sort((a, b) => (order.value === 'old' ? 1 : -1) * a.dataset.date!.localeCompare(b.dataset.date!));
      sorted.forEach((li) => wall.append(li));
      const shown = sorted.filter((li) => (format === 'all' || li.dataset.format === format) && (!who || who.value === 'all' || li.dataset.who === who.value));
      const pages = Math.max(1, Math.ceil(shown.length / PER)); page = Math.min(page, pages);
      items.forEach((li) => { li.hidden = true; });
      shown.slice((page - 1) * PER, page * PER).forEach((li) => { li.hidden = false; });
      count.textContent = String(shown.length);
      none.hidden = shown.length > 0;
      pager.hidden = pages < 2; pager.innerHTML = pagerHtml(page, pages);
      if (scroll) document.querySelector('.ga-body')?.scrollIntoView({ behavior: 'smooth' });
    };
    chips.forEach((c) => c.addEventListener('click', () => { format = c.dataset.format!; page = 1; draw(); }));
    who?.addEventListener('change', () => { page = 1; draw(); });
    order.addEventListener('change', () => { page = 1; draw(); });
    pager.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-go]');
      if (!b || b.disabled) return; page = Number(b.dataset.go); draw(true);
    });
    draw();
  }
</script>

<style>
  .ga-head { padding: 160px 24px 60px; }
  .ga-in { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
  .ga-back { align-self: flex-start; color: var(--muted-dark); border-bottom: 1px solid rgba(243, 236, 220, .25); padding-bottom: 3px; margin-bottom: 18px; }
  .ga-back:hover { color: var(--ember); }
  .ga-sub { margin: 0; max-width: 640px; font-size: 21px; line-height: 1.5; color: #CFC8B8; }
  .ga-total { margin-top: 6px; }
  .ga-body { padding: 10px 24px 110px; scroll-margin-top: 80px; }
  .ga-body > * { max-width: 1200px; margin-left: auto; margin-right: auto; }
  .ga-tools { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; padding: 22px 0 34px; border-top: 1px solid rgba(243, 236, 220, .12); }
  .ga-selects { display: flex; gap: 14px; }
  .ga-sel { display: flex; flex-direction: column; gap: 6px; }
  .ga-sel .field { min-width: 180px; padding: 10px 12px !important; font-size: 16px !important; }
  /* A wall of photographs, each whole, in columns like a salon hang */
  .ga-wall { list-style: none; margin: 0 auto; padding: 0; columns: 3 300px; column-gap: 26px; }
  .ga-wall > li { break-inside: avoid; margin: 0 0 34px; display: flex; flex-direction: column; gap: 12px; }
  .ga-wall > li[hidden] { display: none; }
  .ga-ph { position: relative; display: block; line-height: 0; overflow: hidden; box-shadow: 0 24px 50px -30px rgba(0, 0, 0, .9); }
  .ga-ph img { width: 100%; height: auto; display: block; transition: transform 1.2s var(--ease, ease), filter .6s; }
  .ga-ph:hover img { transform: scale(1.03); }
  .ga-more { position: absolute; right: 10px; bottom: 10px; line-height: 1; padding: 6px 9px; border-radius: 999px; background: rgba(10, 12, 10, .75); color: var(--bone); font-size: 9.5px; }
  .ga-cap { display: flex; flex-direction: column; gap: 4px; }
  .ga-t { font-family: var(--serif); font-size: 22px; line-height: 1.2; color: var(--bone); transition: color .3s; }
  .ga-t:hover, .ga-cap a:hover { color: var(--ember); }
  .ga-cap .lab { font-size: 9.5px; line-height: 1.6; }
  .ga-none, .ga-empty { font-size: 20px; text-align: center; padding: 40px 0; }
  .ga-empty a { color: var(--ember); }
  .ga-pager { color: var(--bone); }
  @media (max-width: 700px) {
    .ga-head { padding: 116px 20px 40px; }
    .ga-sub { font-size: 18px; }
    .ga-body { padding: 0 20px 80px; }
    .ga-tools { flex-direction: column; align-items: stretch; padding: 18px 0 24px; }
    .ga-selects { flex-direction: row; }
    .ga-sel { flex: 1; min-width: 0; }
    .ga-sel .field { min-width: 0; width: 100%; }
    .ga-wall { columns: 2; column-gap: 12px; }
    .ga-wall > li { margin-bottom: 22px; gap: 8px; }
    .ga-t { font-size: 17px; }
  }
</style>
