---
// The Hearth: the Guild's creative room. Prose, poetry, fiction, photographs, architectural studies and design teardowns.
//   - a featured piece (the newest), large
//   - the six kinds of work, each a filter
//   - the written work as a gallery of cards, newest first (photographs have their own section)
//   - the gallery: the newest photographs, and a link to all of them (/hearth/gallery/)
//   - the makers, and an invitation to bring work to the table
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import Subscribe from '../components/Subscribe.astro';
import Avatar from '../components/Avatar.astro';
import { authorUrl, guildPillar, guildUrl, MEDIUM_LABEL, readingMinutes, type GuildAuthor } from '../lib/guild';

const KINDS = [
  { value: 'prose', label: 'Prose', note: 'Essays of the heart, short reflections.' },
  { value: 'poetry', label: 'Poetry', note: 'Lines, stanzas, psalms of our own.' },
  { value: 'fiction', label: 'Fiction', note: 'Stories that tell the truth slant.' },
  { value: 'photograph', label: 'Photographs', note: 'Stone in monochrome; color through glass.' },
  { value: 'study', label: 'Architectural studies', note: 'Reading sacred space.' },
  { value: 'teardown', label: 'Design teardowns', note: 'How a made thing works, and why.' },
];
const FALLBACK = ['/images/glass-2-1200.jpg', '/images/window-light-on-wall-1200.jpg', '/images/bay-window-of-stained-glass-1200.jpg', '/images/faded-chapel-wall-with-a-1200.jpg'];
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const all = (await guildPillar('hearth')).map((g, i) => ({
  href: guildUrl(g), title: g.title, kind: g.medium, kindLabel: MEDIUM_LABEL[g.medium] ?? '', standfirst: g.standfirst,
  date: g.published_at.slice(0, 10), minutes: readingMinutes(g.body), image: g.image || FALLBACK[i % FALLBACK.length], hasPhoto: !!g.image, pos: (g.image && g.imagePos) ? `object-position:${g.imagePos}` : undefined,
  author: g.author, authorHref: authorUrl(g.author), format: g.photoMeta?.format ?? '', more: g.gallery?.length ?? 0,
}));
const featured = all[0];
// Photographs live in the gallery; the cards below are the written work.
const works = all.filter((w) => w.kind !== 'photograph');
const photos = all.filter((w) => w.kind === 'photograph' && w.hasPhoto);
const count = (k: string) => all.filter((w) => w.kind === k).length;
const ROMAN = ['i', 'ii', 'iii', 'iv'];
const makers = [...new Map(all.map((w) => [w.author.id, w.author] as [string, GuildAuthor])).values()].slice(0, 8);
---
<BaseLayout title="The Hearth" description="The Guild's creative room: prose, poetry, fiction, photographs, architectural studies and design teardowns.">
  <section class="hero pill-h">
    <img src="/images/ascension-window-wide.jpg" srcset="/images/ascension-window-wide-1200.jpg 1200w, /images/ascension-window-wide.jpg 2880w" sizes="100vw" alt="Stained-glass window of the Ascension in a warm stone vault" style="object-position:center 45%;" fetchpriority="high" />
    <div class="veil-l"></div><SiteNav />
    <div class="pill-in">
      <span class="eb">02 · Creative Guild</span>
      <h1 class="h1" style="text-transform:uppercase;letter-spacing:.04em">The Hearth</h1>
      <p class="body" style="color:#E6DFD0;max-width:720px">The Guild’s creative room, in the spirit of the Inklings: prose and poetry, fiction, photographs, architectural studies and design teardowns, made with reverence and brought to the fire to be read.</p>
    </div>
  </section>

  {featured && (
    <!-- The newest work, large -->
    <section class="sec paper he-feat-sec">
      <a class="he-feat" href={featured.href}>
        <span class="he-feat-img"><img src={featured.image} alt="" style={featured.pos} /></span>
        <span class="he-feat-text">
          <span class="eb">Newest at the hearth · {featured.kindLabel}</span>
          <span class="h2 he-feat-title">{featured.title}</span>
          {featured.standfirst && <span class="it he-feat-sf">{featured.standfirst}</span>}
          <span class="he-feat-by"><Avatar name={featured.author.display_name} src={featured.author.portrait || undefined} size={30} id={featured.author.id} /><span class="lab mut">{featured.author.display_name} · {fmt(featured.date)}</span></span>
          <span class="lab he-feat-go">{featured.kind === 'photograph' ? 'See the photograph' : 'Read'} <span aria-hidden="true">→</span></span>
        </span>
      </a>
    </section>
  )}

  <!-- The six kinds of work, each a filter -->
  <section class="sec dark he-kinds-sec">
    <span class="eb">What the fellowship makes</span>
    <div class="he-kinds">
      {KINDS.map((k) => (
        k.value === 'photograph' ? (
          <a class="he-kind" href="#gallery">
            <span class="he-k">{k.label}</span>
            <span class="it he-n">{k.note}</span>
            <span class="lab he-c">{count(k.value) ? `${count(k.value)} in the gallery` : 'Be the first'}</span>
          </a>
        ) : (
        <button type="button" class="he-kind" data-kind={k.value}>
          <span class="he-k">{k.label}</span>
          <span class="it he-n">{k.note}</span>
          <span class="lab he-c">{count(k.value) ? `${count(k.value)} ${count(k.value) === 1 ? 'piece' : 'pieces'}` : 'Be the first'}</span>
        </button>)
      ))}
    </div>
    <a class="lab room-forms" href="/crafts/#hearth">What each craft is, and what the editor looks for →</a>
  </section>

  <!-- The work, as a gallery -->
  <section class="sec paper" id="work">
    <div class="row" style="padding-bottom:22px">
      <div style="display:flex;flex-direction:column;gap:14px"><span class="eb">From the fellowship</span><h2 class="h2">The work</h2></div>
      <span class="lab mut he-total">{works.length} {works.length === 1 ? 'piece' : 'pieces'} · newest first</span>
    </div>
    <div class="filters he-filters" role="group" aria-label="Show">
      <button type="button" class="chip" aria-pressed="true" data-show="all">All</button>
      {KINDS.filter((k) => k.value !== 'photograph').map((k) => <button type="button" class="chip" aria-pressed="false" data-show={k.value}>{k.label}</button>)}
    </div>
    {works.length > 0 ? (
      <ol class="he-grid">
        {works.map((w) => (
          <li data-tag={w.kind}>
            <a class="he-card-img" href={w.href} tabindex="-1" aria-hidden="true"><img class:list={[{ mono: !w.hasPhoto }]} src={w.image} alt="" loading="lazy" style={w.pos} /></a>
            <span class="lab he-card-k">{w.kindLabel}</span>
            <a class="he-card-t" href={w.href}>{w.title}</a>
            {w.standfirst && <span class="it he-card-sf">{w.standfirst}</span>}
            {w.authorHref
              ? <a class="he-card-by" href={w.authorHref}><Avatar name={w.author.display_name} src={w.author.portrait || undefined} size={24} id={w.author.id} /><span class="lab mut">{w.author.display_name}</span></a>
              : <span class="he-card-by"><Avatar name={w.author.display_name} src={w.author.portrait || undefined} size={24} /><span class="lab mut">{w.author.display_name}</span></span>}
          </li>
        ))}
      </ol>
    ) : <p class="it mut" style="font-size:22px;margin:0">The first pieces from the fellowship are being written.</p>}
    <p class="it mut he-none" hidden>Nothing of this kind yet. The first one may be yours.</p>
    <nav class="pager he-pager" aria-label="Pages of work" hidden></nav>
  </section>

  <!-- The gallery: the newest photographs from the fellowship, and the way to all of them -->
  <section class="sec dark" id="gallery">
    <div class="row" style="padding-bottom:30px"><div style="display:flex;flex-direction:column;gap:16px"><span class="eb">Photographs</span><h2 class="h2">The gallery</h2></div><span class="it mut" style="font-size:20px">Stone in monochrome. Color only through glass.</span></div>
    {photos.length > 0 ? (
      <div class="g4 he-plates">
        {photos.slice(0, 4).map((w, i) => (
          <a class="he-plate" href={w.href}>
            <figure><div class="tile" style={`height:${i % 2 ? 280 : 360}px`}><img src={w.image} alt="" loading="lazy" style={w.pos} /></div>
              <figcaption class="lab mut">Plate {ROMAN[i]} · {w.title}<span class="he-plate-by">{w.author.display_name}{w.format ? ` · ${w.format === 'film' ? 'Film' : 'Digital'}` : ''}</span></figcaption></figure>
          </a>
        ))}
      </div>
    ) : (
      <div class="g4 he-plates">
        <figure><div class="tile" style="height:360px"><img src="/images/glass.jpg" alt="Glass" loading="lazy" /></div><figcaption class="lab mut">Plate i · Glass</figcaption></figure>
        <figure><div class="tile" style="height:280px"><img src="/images/ivy.jpg" alt="Ivy" class="mono" loading="lazy" /></div><figcaption class="lab mut">Plate ii · Ivy</figcaption></figure>
        <figure><div class="tile" style="height:360px"><img src="/images/glass-2.jpg" srcset="/images/glass-2-1200.jpg 1200w, /images/glass-2.jpg 1617w" sizes="(max-width: 700px) 100vw, 50vw" alt="Glass" style="object-position:center 30%;" loading="lazy" /></div><figcaption class="lab mut">Plate iii · Glass</figcaption></figure>
        <figure><div class="tile" style="height:280px"><img src="/images/stone.jpg" alt="Stone" class="mono" loading="lazy" /></div><figcaption class="lab mut">Plate iv · Stone</figcaption></figure>
      </div>
    )}
    <div class="he-gallery-go">
      {photos.length > 0
        ? <a class="btn" href="/hearth/gallery/">View the full gallery <span aria-hidden="true">→</span></a>
        : <a class="btn" href="/guild/">Bring the first photograph</a>}
      {photos.length > 0 && <span class="lab mut">{photos.length} {photos.length === 1 ? 'photograph' : 'photographs'} from the fellowship</span>}
    </div>
  </section>

  <!-- The makers, and an open chair -->
  <section class="sec paper center he-table">
    <span class="eb">The Inklings’ Table</span>
    <p class="lede" style="margin-top:24px;max-width:900px">A gathering of sharp minds, soft hearts and unyielding spirits who bring their work to the fire to write, sharpen, and discern together.</p>
    {makers.length > 0 && (
      <div class="he-makers">
        {makers.map((m) => (
          <a class="he-maker" href={authorUrl(m)}>
            <Avatar name={m.display_name} src={m.portrait || undefined} size={64} id={m.id} />
            <span class="he-maker-n">{m.display_name}</span>
            {m.craft && <span class="lab mut he-maker-c">{m.craft}</span>}
          </a>
        ))}
      </div>
    )}
    <div class="he-cta">
      <a class="btn" href="/guild/desk/#write" data-member hidden>Bring your work to the table</a>
      <a class="btn" href="/guild" data-guest>Join the Guild</a>
    </div>
  </section>
  <Subscribe />
</BaseLayout>

<script>
  import { PER_PAGE, pagerHtml } from '../lib/pager';
  // Tapping a kind shows only that kind of work; six at a time, with pages below.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.he-filters .chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.he-grid li[data-tag]')];
  const none = document.querySelector<HTMLElement>('.he-none');
  const pager = document.querySelector<HTMLElement>('.he-pager');
  let kind = 'all', page = 1;
  const draw = (scroll = false) => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.show === kind)));
    const shown = cards.filter((c) => kind === 'all' || c.dataset.tag === kind);
    const pages = Math.max(1, Math.ceil(shown.length / PER_PAGE));
    page = Math.min(page, pages);
    cards.forEach((c) => { c.hidden = true; });
    shown.slice((page - 1) * PER_PAGE, page * PER_PAGE).forEach((c) => { c.hidden = false; });
    if (none) none.hidden = shown.length > 0 || cards.length === 0;
    if (pager) { pager.hidden = pages < 2; pager.innerHTML = pagerHtml(page, pages); }
    if (scroll) document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
  };
  const show = (k: string) => { kind = k; page = 1; draw(); };
  pager?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-go]');
    if (!b || b.disabled) return; page = Number(b.dataset.go); draw(true);
  });
  chips.forEach((c) => c.addEventListener('click', () => show(c.dataset.show!)));
  document.querySelectorAll<HTMLButtonElement>('button.he-kind').forEach((b) => b.addEventListener('click', () => {
    show(b.dataset.kind!);
    document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
  }));
  draw();
</script>

<style>
  .room-forms { display: inline-block; margin-top: 26px; color: var(--ember); border-bottom: 1px solid rgba(255,227,163,.4); padding-bottom: 3px; }
  /* Featured */
  .he-feat-sec { padding-bottom: 40px; }
  .he-feat { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; align-items: center; max-width: 1200px; margin: 0 auto; }
  .he-feat-img { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 999px 999px 0 0; box-shadow: 0 0 0 1px var(--brass), 0 0 0 8px var(--paper), 0 0 0 9px rgba(159, 148, 94, .4); }
  .he-feat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease, ease); }
  .he-feat:hover .he-feat-img img { transform: scale(1.04); }
  .he-feat-text { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .he-feat-title { font-style: italic; line-height: 1.05; transition: color .3s; }
  .he-feat:hover .he-feat-title { color: var(--oxblood); }
  .he-feat-sf { font-size: 21px; line-height: 1.45; color: var(--muted-paper); }
  .he-feat-by { display: inline-flex; align-items: center; gap: 10px; }
  .he-feat-go { color: var(--oxblood); border-bottom: 1px solid rgba(98, 55, 45, .4); padding-bottom: 3px; }

  /* Kinds */
  .he-kinds { margin-top: 34px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(243, 236, 220, .14); }
  .he-kind { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 26px 26px 24px; text-align: left; background: none; border: 0; border-bottom: 1px solid rgba(243, 236, 220, .14); color: inherit; cursor: pointer; }
  .he-kind:not(:nth-child(3n + 1)) { border-left: 1px solid rgba(243, 236, 220, .14); }
  .he-k { font-family: var(--serif); font-size: 27px; line-height: 1.1; transition: color .3s; }
  .he-n { font-size: 17px; line-height: 1.45; color: var(--muted-dark); }
  .he-c { margin-top: 4px; color: var(--ember); font-size: 10px; }
  .he-kind:hover .he-k { color: var(--ember); }

  /* The work, as a gallery */
  .he-filters { margin-bottom: 30px; }
  #work { scroll-margin-top: 90px; }
  .he-pager { margin-top: 56px; }
  .he-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 32px; }
  .he-grid li { display: flex; flex-direction: column; gap: 10px; }
  .he-grid li[hidden] { display: none; }
  .he-card-img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #DDD5C6; margin-bottom: 6px; }
  .he-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease, ease); }
  .he-grid li:hover .he-card-img img { transform: scale(1.04); }
  .he-card-k { color: var(--oxblood); font-size: 10px; }
  .he-card-t { font-family: var(--serif); font-style: italic; font-size: 26px; line-height: 1.15; transition: color .3s; }
  .he-card-t:hover, .he-grid li:hover .he-card-t { color: var(--oxblood); }
  .he-card-sf { font-size: 17px; line-height: 1.45; color: var(--muted-paper); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .he-card-by { display: inline-flex; align-items: center; gap: 8px; margin-top: 2px; }
  a.he-card-by:hover .lab { color: var(--oxblood); }
  .he-card-by .lab { font-size: 9px; }
  .he-none { margin: 28px 0 0; font-size: 19px; }

  /* Plates */
  .he-plates figure { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .he-plates figcaption { font-size: 10px; display: flex; flex-direction: column; gap: 4px; }
  .he-plate-by { opacity: .7; }
  .he-plate { display: block; }
  .he-plate .tile img { transition: transform 1.1s var(--ease, ease); }
  .he-plate:hover .tile img { transform: scale(1.04); }
  .he-plate:hover figcaption { color: var(--ember); }
  .he-gallery-go { margin-top: 44px; display: flex; flex-direction: column; align-items: center; gap: 14px; }

  /* The table */
  .he-makers { margin-top: 44px; display: flex; flex-wrap: wrap; justify-content: center; gap: 28px 40px; }
  .he-maker { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 120px; }
  .he-maker-n { font-family: var(--serif); font-size: 19px; line-height: 1.15; text-align: center; transition: color .3s; }
  .he-maker:hover .he-maker-n { color: var(--oxblood); }
  .he-maker-c { font-size: 9px; text-align: center; }
  .he-cta { margin-top: 44px; display: flex; justify-content: center; gap: 14px; }
  .he-cta [hidden] { display: none; }

  @media (max-width: 1000px) {
    .he-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .he-kinds { grid-template-columns: 1fr 1fr; }
    .he-kind:not(:nth-child(3n + 1)) { border-left: 0; }
    .he-kind:nth-child(2n) { border-left: 1px solid rgba(243, 236, 220, .14); }
  }
  @media (max-width: 700px) {
    .he-feat { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .he-feat-img { aspect-ratio: 4 / 3; }
    .he-feat-title { font-size: 30px !important; }
    .he-feat-sf { font-size: 18px; }
    .he-kinds { grid-template-columns: 1fr 1fr; }
    .he-kind { padding: 16px 12px 16px 0; gap: 6px; }
    .he-kind:nth-child(2n) { padding-left: 14px; }
    .he-k { font-size: 20px; }
    .he-n { display: none; }
    .he-plates { grid-template-columns: 1fr 1fr !important; gap: 14px !important; }
    .he-plates .tile { height: 200px !important; max-height: none; }
    .he-grid { grid-template-columns: 1fr 1fr; gap: 30px 16px; }
    .he-card-t { font-size: 19px; }
    .he-card-sf { display: none; }
    .he-total { display: none; }
    .he-cta { flex-direction: column; align-items: stretch; width: min(100%, 300px); margin-left: auto; margin-right: auto; }
    .he-cta .btn { text-align: center; }
  }
</style>
