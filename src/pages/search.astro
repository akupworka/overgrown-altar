---
// One search for everything: writing, photographs and the site's pages for everyone (from /search-index.json,
// drawn at build time), and, for members, the Guild's members and forum threads (asked of Supabase as you type).
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
---
<BaseLayout title="Search" description="Search the Overgrown Altar: writing, photographs, pages, and for members the Guild and its forum.">
  <section class="night sr-head">
    <SiteNav />
    <div class="sr-in">
      <span class="eb">Search the altar</span>
      <form class="sr-form" role="search" action="/search/" method="get">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input id="sr-q" type="search" name="q" placeholder="A title, a writer, a word…" aria-label="Search" autocomplete="off" enterkeyhint="search" />
      </form>
      <p class="it mut sr-hint">Writing, photographs and pages<span data-member hidden>, members and forum threads</span>.</p>
    </div>
  </section>
  <section class="dark sr-body">
    <div class="sr-results" aria-live="polite"></div>
  </section>
</BaseLayout>

<script>
  import { supabase, portraitUrl } from '../lib/supabase';
  type Hit = { href: string; title: string; line?: string; meta?: string; image?: string; round?: boolean };
  const input = document.getElementById('sr-q') as HTMLInputElement;
  const out = document.querySelector<HTMLElement>('.sr-results')!;
  const member = document.documentElement.hasAttribute('data-member');
  let index: Promise<{ pieces: any[]; pages: any[] }> | null = null;
  const load = () => (index ??= fetch('/search-index.json').then((r) => r.json()).catch(() => ({ pieces: [], pages: [] })));
  const words = (q: string) => q.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').split(/\s+/).filter(Boolean);
  const fits = (text: string, w: string[]) => { const t = text.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, ''); return w.every((x) => t.includes(x)); };
  const day = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

  const group = (title: string, hits: Hit[], more?: string) => {
    if (!hits.length) return null;
    const sec = document.createElement('section'); sec.className = 'sr-group';
    const h = document.createElement('h2'); h.className = 'eb sr-gh'; h.textContent = `${title} · ${hits.length}`; sec.append(h);
    const ol = document.createElement('ol'); ol.className = 'sr-list';
    for (const x of hits.slice(0, 8)) {
      const li = document.createElement('li');
      const a = document.createElement('a'); a.className = 'sr-hit'; a.href = x.href;
      if (x.image !== undefined) {
        const pic = document.createElement('span'); pic.className = 'sr-pic' + (x.round ? ' round' : '');
        if (x.image) { const i = new Image(); i.src = x.image; i.alt = ''; i.loading = 'lazy'; pic.append(i); } else pic.textContent = x.title.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
        a.append(pic);
      }
      const t = document.createElement('span'); t.className = 'sr-t';
      const n = document.createElement('span'); n.className = 'sr-n'; n.textContent = x.title; t.append(n);
      if (x.meta) { const m = document.createElement('span'); m.className = 'lab sr-m'; m.textContent = x.meta; t.append(m); }
      if (x.line) { const l = document.createElement('span'); l.className = 'it sr-l'; l.textContent = x.line; t.append(l); }
      a.append(t); li.append(a); ol.append(li);
    }
    sec.append(ol);
    if (hits.length > 8 && more) { const m = document.createElement('a'); m.className = 'lab sr-more'; m.href = more; m.textContent = `See all ${hits.length} →`; sec.append(m); }
    return sec;
  };

  let turn = 0;
  async function run() {
    const q = input.value.trim(), mine = ++turn;
    const u = new URL(location.href); q ? u.searchParams.set('q', q) : u.searchParams.delete('q'); history.replaceState(null, '', u.pathname + u.search);
    if (q.length < 2) { out.innerHTML = ''; return; }
    const w = words(q), idx = await load();
    const pieces = idx.pieces.filter((p) => fits(`${p.title} ${p.line ?? ''} ${p.who} ${p.label}`, w));
    const writing: Hit[] = pieces.filter((p) => p.kind === 'piece').map((p) => ({ href: p.href, title: p.title, line: p.line, meta: `${p.label} · ${p.who}`, image: p.image || '' }));
    const photos: Hit[] = pieces.filter((p) => p.kind === 'photo').map((p) => ({ href: p.href, title: p.title, meta: `${p.who} · ${day(p.date)}`, image: p.image || '' }));
    const pages: Hit[] = idx.pages.filter((p) => fits(`${p.title} ${p.line}`, w)).map((p) => ({ href: p.href, title: p.title, line: p.line }));
    let people: Hit[] = [], threads: Hit[] = [];
    if (member) {
      const like = `%${q.replace(/[%_,()]/g, ' ').trim()}%`;
      const [{ data: pp }, { data: th }] = await Promise.all([
        supabase.from('profiles').select('id, display_name, craft, portrait_path').or(`display_name.ilike.${like},craft.ilike.${like}`).limit(12),
        supabase.from('forum_threads').select('id, title, reply_count, last_post_at').ilike('title', like).order('last_post_at', { ascending: false }).limit(12),
      ]);
      people = (pp ?? []).map((p: any) => ({ href: `/guild/members/?m=${p.id}`, title: p.display_name, meta: p.craft || 'Writer', image: portraitUrl(p.portrait_path), round: true }));
      threads = (th ?? []).map((t: any) => ({ href: `/guild/members/?view=forum&t=${t.id}`, title: t.title, meta: `${t.reply_count} ${t.reply_count === 1 ? 'reply' : 'replies'} · ${day(t.last_post_at)}` }));
    }
    if (mine !== turn) return;
    out.innerHTML = '';
    const parts = [group('Writing', writing, `/archive/?q=${encodeURIComponent(q)}`), group('Photographs', photos, '/gallery/'), group('Members', people), group('In the forum', threads), group('Pages', pages)].filter(Boolean) as HTMLElement[];
    if (!parts.length) { const p = document.createElement('p'); p.className = 'it mut sr-none'; p.textContent = `Nothing on the altar matches “${q}” yet.`; out.append(p); return; }
    out.append(...parts);
  }
  let wait = 0;
  input.addEventListener('input', () => { clearTimeout(wait); wait = window.setTimeout(run, 220); });
  document.querySelector('.sr-form')!.addEventListener('submit', (e) => { e.preventDefault(); run(); input.blur(); });
  const start = new URLSearchParams(location.search).get('q');
  if (start) { input.value = start; run(); } else input.focus();
</script>

<style>
  .sr-head { padding: 170px 24px 30px; }
  .sr-in { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
  .sr-form { display: flex; align-items: center; gap: 14px; padding: 0 22px; min-height: 64px; border-radius: 999px; color: var(--ember);
    background: linear-gradient(180deg, #171B13, #0E110C); box-shadow: inset 0 1px 0 rgba(255, 236, 190, .1), inset 0 0 0 1px rgba(255, 227, 163, .4); }
  .sr-form:focus-within { box-shadow: inset 0 1px 0 rgba(255, 236, 190, .1), inset 0 0 0 1px rgba(255, 227, 163, .75); }
  .sr-form input { flex: 1; min-width: 0; border: 0; outline: none; background: none; color: var(--bone); font-family: var(--serif); font-size: 24px; }
  .sr-form input::placeholder { color: #8C8679; font-style: italic; }
  .sr-hint { margin: 0; font-size: 17px; }
  .sr-body { padding: 10px 24px 110px; min-height: 40vh; }
  .sr-results { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 38px; }
  :global(.sr-group) { display: flex; flex-direction: column; gap: 10px; }
  :global(.sr-gh) { margin: 0; }
  :global(.sr-list) { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  :global(.sr-list li + li) { border-top: 1px solid rgba(243, 236, 220, .08); }
  :global(.sr-hit) { display: flex; align-items: center; gap: 16px; padding: 14px 0; color: var(--bone); }
  :global(.sr-hit:hover .sr-n) { color: var(--ember); }
  :global(.sr-pic) { flex: none; width: 64px; height: 64px; border-radius: 10px; overflow: hidden; background: #14180F; display: inline-flex; align-items: center; justify-content: center; color: var(--ember); font-family: var(--serif); font-size: 18px; }
  :global(.sr-pic.round) { width: 52px; height: 52px; border-radius: 50%; box-shadow: 0 0 0 1px var(--brass); }
  :global(.sr-pic img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.sr-t) { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  :global(.sr-n) { font-family: var(--serif); font-size: 22px; line-height: 1.2; transition: color .3s; }
  :global(.sr-m) { font-size: 9px; color: var(--ember); }
  :global(.sr-l) { font-size: 16px; color: var(--muted-dark); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(.sr-more) { align-self: flex-start; color: var(--ember); border-bottom: 1px solid rgba(255, 227, 163, .4); padding-bottom: 3px; }
  :global(.sr-none) { font-size: 20px; text-align: center; padding: 30px 0; }
  @media (max-width: 700px) {
    .sr-head { padding: 112px 16px 20px; }
    .sr-form { min-height: 56px; padding: 0 18px; }
    .sr-form input { font-size: 20px; }
    .sr-hint { font-size: 15px; }
    .sr-body { padding: 6px 16px 100px; }
    :global(.sr-pic) { width: 54px; height: 54px; }
    :global(.sr-n) { font-size: 18px; }
    :global(.sr-l) { font-size: 15px; }
  }
</style>
