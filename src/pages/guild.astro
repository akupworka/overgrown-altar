---
// Join the Guild — converted from the design file Guild.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import DoorwayFrame from '../components/DoorwayFrame.astro';
---
<BaseLayout title="Join the Guild">
<section class="hero" style="height:820px"><img src="/images/format-guild.jpg" srcset="/images/format-guild-1200.jpg 1200w, /images/format-guild.jpg 2576w" sizes="100vw" alt="Altar of Our Lady between stained-glass windows" style="object-position:center 40%;filter:brightness(.6)" fetchpriority="high" /><div class="veil"></div><SiteNav />
<div class="hero-c" style="top:250px"><span class="eb">The Inklings’ Table</span><h1 class="h1" style="margin-top:22px">Join the Guild</h1><p class="it" style="margin:24px 0 0;max-width:640px;font-size:26px;line-height:1.4;color:#E6DFD0">A structured round-table guild for creative believers.</p></div></section>
<section class="sec paper"><div class="g3"><div class="center" style="gap:16px"><span class="num" style="font-size:64px;color:#62372D">I</span><span class="cg" style="font-size:36px;letter-spacing:.08em;text-transform:uppercase">Write</span><span class="it mut" style="font-size:20px;max-width:300px">Bring essays, poems, chapters and photographs to the table, finished or still on the anvil.</span></div><div class="center" style="gap:16px"><span class="num" style="font-size:64px;color:#62372D">II</span><span class="cg" style="font-size:36px;letter-spacing:.08em;text-transform:uppercase">Sharpen</span><span class="it mut" style="font-size:20px;max-width:300px">Members read closely and answer honestly. As iron sharpeneth iron.</span></div><div class="center" style="gap:16px"><span class="num" style="font-size:64px;color:#62372D">III</span><span class="cg" style="font-size:36px;letter-spacing:.08em;text-transform:uppercase">Discern</span><span class="it mut" style="font-size:20px;max-width:300px">We weigh every work against Scripture and against beauty, and we pray over what we make.</span></div></div>
<div style="margin-top:70px"><div style="display:flex;align-items:center;gap:18px;justify-content:center"><span style="width:80px;height:1px;background:#9F945E"></span><svg width="18" height="26" viewBox="0 0 603 883" aria-hidden="true" style="display:block"><path fill="#9F945E" d="M302.5,874.8C301.9,872.7 300.2,850.6 298.0,817.0C296.9,799.7 295.1,774.0 294.0,760.0C292.9,746.0 291.5,725.5 291.0,714.5C289.8,689.3 289.8,594.6 291.0,552.5C292.6,497.2 293.3,386.5 292.2,375.7C290.3,358.2 281.5,345.0 268.5,340.0C261.2,337.3 237.4,336.2 182.5,336.1C135.1,336.0 120.4,337.5 102.9,344.2C96.1,346.8 87.9,352.3 85.7,355.7C84.1,358.2 81.2,356.9 77.5,352.2C67.3,339.4 56.9,335.0 27.4,331.5C9.1,329.3 8.0,329.1 8.0,327.6C8.0,326.5 16.9,325.0 40.5,322.3C52.6,320.9 65.5,314.4 77.5,303.6C83.4,298.2 84.2,298.1 87.9,301.8C92.4,306.2 105.2,312.0 115.3,314.1C129.1,317.0 184.3,318.6 230.0,317.4C265.1,316.5 265.6,316.4 269.5,314.0C282.5,306.1 289.0,298.7 291.2,289.0C292.2,284.8 292.5,268.4 292.4,220.5C292.3,131.8 291.4,123.6 278.4,103.2C276.5,100.3 275.0,97.5 275.0,97.0C275.0,96.5 277.4,93.7 280.4,90.7C292.3,78.8 297.1,63.6 301.6,23.8C303.9,3.2 305.5,2.7 306.3,22.2C307.5,50.2 313.0,69.5 324.9,86.9C327.1,90.0 330.0,93.6 331.4,94.9C334.5,97.8 334.7,100.1 332.0,102.5C328.8,105.4 322.2,118.0 320.6,124.4C316.6,139.5 315.7,157.2 315.6,218.0C315.5,281.4 315.9,287.1 320.8,296.3C327.0,307.8 338.1,314.7 353.3,316.2C369.6,317.8 476.5,316.6 486.5,314.7C501.2,311.8 507.7,309.2 516.3,302.6C521.4,298.7 523.4,298.2 524.7,300.4C526.1,302.8 536.4,310.6 541.5,313.2C554.5,319.7 574.7,325.5 587.7,326.6C594.7,327.2 596.0,327.6 595.8,328.9C595.5,330.2 593.4,330.6 584.5,331.3C557.6,333.2 536.0,340.9 526.6,352.0C523.6,355.6 522.0,355.7 519.1,352.6C517.9,351.3 513.7,348.7 509.7,346.7C503.2,343.4 497.5,341.7 479.5,337.8C471.7,336.1 359.8,336.2 350.5,337.9C347.2,338.5 342.2,340.2 339.3,341.6C332.8,344.7 322.7,354.9 319.5,361.5C314.8,371.1 314.7,372.8 316.5,503.5C318.2,631.1 318.3,696.5 316.6,718.5C315.7,730.6 314.1,754.9 313.0,772.5C311.9,790.1 310.5,809.5 310.0,815.5C309.4,821.5 308.7,836.6 308.4,849.0C308.0,861.4 307.3,872.5 306.9,873.8C306.0,876.2 303.2,876.8 302.5,874.8Z"></path></svg><span style="width:80px;height:1px;background:#9F945E"></span></div></div>
<p class="lede center" style="margin:50px auto 0;max-width:980px;font-size:34px">We do not build digital stages for central gurus or performative influencers. We cultivate a guild—a gathering of sharp minds, soft hearts, and unyielding spirits who gather around the hearth to write, sharpen, and discern together.</p></section>
<!-- Applications arrive in Netlify > Forms ("guild-application"). You then invite the people you choose. -->
<DoorwayFrame kicker="Apply" title="Pull up a chair." image="/images/tall-windows-dark-vault-1200.jpg"
  lead="Come to make, and come to be made better. Tell us a little about your craft.">
<form name="guild-application" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="company" class="dw-form">
<input type="hidden" name="form-name" value="guild-application" />
<p class="visually-hidden"><label>Leave this empty <input name="company" tabindex="-1" /></label></p>
<label class="dw-field"><span class="dw-label">Your name</span><span class="dw-line-row"><input name="name" autocomplete="name" required /></span></label>
<label class="dw-field"><span class="dw-label">Email</span><span class="dw-line-row"><input type="email" name="email" autocomplete="email" required /></span></label>
<label class="dw-field"><span class="dw-label">What you make</span><span class="dw-line-row"><input name="craft" placeholder="Essays, poems, photographs…" required /></span></label>
<label class="dw-field"><span class="dw-label">Why the table?</span><span class="dw-line-row"><textarea name="why" rows="3" required></textarea></span></label>
<button class="dw-send" type="submit">Apply to the Guild <span aria-hidden="true">→</span></button>
</form>
<Fragment slot="foot">Members comment on dispatches, submit to The Hearth, and gather monthly around one reading and one open table.</Fragment>
</DoorwayFrame>
</BaseLayout>
