---
// Menu — converted from the design file Menu.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import Monogram from '../components/Monogram.astro';
import GlassLight from '../components/GlassLight.astro';
---
<BaseLayout title="Menu" footer={false} noindex>
<section class="night" style="position:relative;min-height:1080px;overflow:hidden"><img src="/images/menu-photo.jpg" srcset="/images/menu-photo-1200.jpg 1200w, /images/menu-photo.jpg 2880w" sizes="100vw" alt="" style="object-position:center 40%;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.18" fetchpriority="high" /><GlassLight prism beams size={640} intensity={0.8} style="right:-6%;top:-12%" /><div class="menu-in" style="position:relative;min-height:100%;box-sizing:border-box;padding:40px 56px 50px;display:flex;flex-direction:column">
<div style="display:flex;justify-content:space-between;align-items:center"><a href="/" aria-label="Overgrown Altar, home" style="width:28px;height:42px;display:block"><Monogram size={42} color="#F3ECDC" /></a><a href="/" class="lab menu-close">Close ✕</a></div>
<div style="margin-top:60px;display:flex;flex-direction:column;align-items:center;gap:30px"><Wordmark width={520} mobileWidth={260} ink="#F3ECDC" script="#FFE3A3" /></div>
<form action="/search/" method="get" role="search" style="margin:50px auto 0;width:100%;max-width:720px"><input class="field search" type="search" name="q" placeholder="Search the altar…" aria-label="Search" style="width:100%;font-size:22px;text-align:center" /></form>
<div class="g4 mgrid" style="margin-top:70px"><div class="mcol" style="display:flex;flex-direction:column;gap:16px"><span class="eb">Begin</span><a class="mlink" href="/start-here">Start Here</a><a class="mlink" href="/manifesto">The Manifesto</a><a class="mlink" href="/archive">The Archive</a></div><div class="mcol" style="display:flex;flex-direction:column;gap:16px"><span class="eb">The Three Pillars</span><a class="mlink" href="/watchtower">The Watchtower</a><a class="mlink" href="/hearth">The Hearth</a><a class="mlink" href="/perimeter">The Perimeter</a></div><div class="mcol" style="display:flex;flex-direction:column;gap:16px"><span class="eb">The Publication</span><a class="mlink" href="/folios">Folios</a><a class="mlink" href="/#subscribe" data-guest>Receive the Dispatches</a><a class="mlink" href="/guild">Join the Guild</a><a class="mlink" href="/guild/desk">The Guild Desk</a></div><div class="mcol" style="display:flex;flex-direction:column;gap:16px"><span class="eb">The House</span><a class="mlink" href="/about">About</a><a class="mlink" href="/beliefs">What We Believe</a><a class="mlink" href="/contact">Contact</a></div></div>
<p class="it mut" style="margin:auto 0 0;padding-top:60px;text-align:center;font-size:20px">We light the signal fires on the perimeter.</p></div></section>
<script>
  // "Close" takes you back to the page you came from (or home, if you arrived here directly).
  document.querySelector<HTMLAnchorElement>('.menu-close')?.addEventListener('click', (e) => {
    if (document.referrer.startsWith(location.origin) && history.length > 1) { e.preventDefault(); history.back(); }
  });
</script>
</BaseLayout>
