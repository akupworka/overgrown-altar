---
// The Guild Desk. Members (and the editor) sign in here, then write, save drafts and send
// pieces to the editor. The interactive part is components/desk/DeskApp.tsx; accounts and
// pieces live in Supabase, guarded by the database's own rules.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import DeskApp from '../../components/desk/DeskApp.tsx';
import '../../styles/glass.css';
import '../../styles/desk.css';
---
<BaseLayout title="The Guild Desk" description="Members of the Guild sign in to their desk." footer={false} noindex>
  <section class="desk night">
    <!-- A faint memory of the window at the top; the room itself stays quiet. -->
    <div class="desk-memory" aria-hidden="true">
      <img src="/images/window-light-on-wall-1200.jpg" alt="" fetchpriority="high" />
    </div>
    <SiteNav />
    <div class="desk-in">
      <DeskApp client:only="react" />
      <noscript><p class="it" style="font-size:20px">The Guild Desk needs JavaScript switched on.</p></noscript>
    </div>
  </section>
</BaseLayout>

