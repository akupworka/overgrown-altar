---
// The Guild Desk. Members (and the editor) sign in here, then write, save drafts and send
// pieces to the editor. The interactive part is components/desk/DeskApp.tsx; accounts and
// pieces live in Supabase, guarded by the database's own rules.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import DeskApp from '../../components/desk/DeskApp.tsx';
import '../../styles/glass.css';
import '../../styles/desk.css';
import '../../styles/doorway.css';
---
<BaseLayout title="The Guild Desk" description="Members of the Guild sign in to their desk." footer={false} noindex arrival={false}>
  <section class="desk night">
    <!-- A faint memory of the window at the top; the room itself stays quiet. -->
    <!-- Visitors: the sign-in doorway's backdrop, drawn from the first moment so nothing flickers while the Desk loads -->
    <div class="dw-backdrop desk-guest-back" aria-hidden="true">
      <div class="dw-nave"><img src="/images/folios-photo-2-1200.jpg" alt="" fetchpriority="high" /></div>
      <div class="dw-shaft"></div>
      <div class="dw-vignette"></div>
    </div>
    <div class="desk-memory" aria-hidden="true">
      <img src="/images/window-light-on-wall-1200.jpg" alt="" fetchpriority="high" />
    </div>
    <SiteNav />
    <div class="desk-in">
      <DeskApp client:only="react" />
      <noscript><p class="it" style="font-size:20px">The Guild Desk needs JavaScript switched on.</p></noscript>
    </div>
  </section>
</BaseLayout>

<style is:global>
  html[data-member] .desk-guest-back { display: none; }
  html:not([data-member]) .desk-memory { display: none; }
  html:not([data-member]) .desk { background: transparent; }
</style>

