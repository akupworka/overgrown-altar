---
// The Guild Desk. Members (and the editor) sign in here, then write, save drafts and send
// pieces to the editor. The interactive part is components/desk/DeskApp.tsx; accounts and
// pieces live in Supabase, guarded by the database's own rules.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import GlassLight from '../../components/GlassLight.astro';
import DeskApp from '../../components/desk/DeskApp.tsx';
import '../../styles/glass.css';
---
<BaseLayout title="The Guild Desk" description="Members of the Guild sign in to their desk." footer={false} noindex>
  <section class="hero desk">
    <img src="/images/window-light-on-wall.jpg" srcset="/images/window-light-on-wall-1200.jpg 1200w, /images/window-light-on-wall.jpg 1326w" sizes="100vw"
      alt="" style="object-position:center 45%;filter:brightness(.4) saturate(1.05)" fetchpriority="high" />
    <div class="veil"></div>
    <GlassLight prism beams size={760} style="left:50%;top:-14%;translate:-50% 0" />
    <GlassLight size={520} intensity={0.55} style="left:-12%;bottom:-18%" />
    <SiteNav />
    <div class="desk-in">
      <DeskApp client:only="react" />
      <noscript><p class="it" style="font-size:20px">The Guild Desk needs JavaScript switched on.</p></noscript>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .desk { min-height: 100vh; min-height: 100svh; }
  .desk > img { position: fixed !important; translate: none !important; }
  .desk-in { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; padding: 130px 20px 80px; }
  .d-loading { margin-top: 120px; }

  .d-narrow { width: 100%; max-width: 500px; }
  .d-wide { width: 100%; max-width: 1040px; }
  .d-card { padding: 46px 44px 38px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .d-title { margin-top: 14px; font-size: 52px; }
  .d-lead { margin: 16px 0 0; font-size: 19px; line-height: 1.45; max-width: 380px; }
  .d-form { width: 100%; margin-top: 28px; display: flex; flex-direction: column; text-align: left; }
  .d-form .lab { color: var(--muted-dark); margin-bottom: 8px; }
  .d-form .field { width: 100%; font-size: 19px; padding: 15px 18px; margin-bottom: 18px; }
  .d-form .btn { width: 100%; padding: 18px; margin-top: 4px; }
  .d-notice { min-height: 1.4em; margin: 14px 0 0; font-size: 18px; line-height: 1.4; color: var(--ember); text-align: center; }
  .d-links { width: 100%; margin-top: 18px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .d-links .it { font-size: 18px; }
  .d-rule { width: 60px; height: 1px; background: var(--brass); margin: 6px 0 0; }
  .d-textbtn { background: none; border: 0; padding: 6px 0; color: var(--muted-dark); cursor: pointer; border-bottom: 1px solid rgba(207, 200, 184, .4); min-height: 32px; }
  .d-textbtn:hover { color: var(--ember); border-color: var(--ember); }
  .d-danger:hover { color: #E6A99A; border-color: #E6A99A; }

  /* Signed in */
  .d-desk { padding: 40px 44px 44px; display: flex; flex-direction: column; gap: 28px; text-align: left; }
  .d-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .d-me { display: flex; align-items: center; gap: 16px; }
  .d-hello { font-size: 40px; margin-top: 6px; }
  .d-avatar {
    flex: none; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
    background: #1B201A; box-shadow: 0 0 0 1px var(--brass), 0 0 0 4px rgba(159, 148, 94, .18);
    color: var(--ember); font-family: var(--serif); font-weight: 500; letter-spacing: .04em;
  }
  .d-tabs { display: flex; gap: 6px; flex-wrap: wrap; border-bottom: 1px solid rgba(243, 236, 220, .14); }
  .d-tab {
    background: none; border: 0; color: var(--muted-dark); cursor: pointer; padding: 14px 16px; min-height: 46px;
    font-family: var(--sans); font-size: 11px; letter-spacing: .22em; text-transform: uppercase;
    border-bottom: 1px solid transparent; margin-bottom: -1px; transition: color .25s, border-color .25s;
  }
  .d-tab:hover { color: var(--bone); }
  .d-tab.on { color: var(--ember); border-bottom-color: var(--ember); }
  .d-section { display: flex; flex-direction: column; gap: 18px; }
  .d-row-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .d-row-head .eb { margin: 0; }
  .d-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .d-stats > div { padding: 18px 20px; border-radius: 12px; background: rgba(243, 236, 220, .04); box-shadow: inset 0 0 0 1px rgba(243, 236, 220, .08); display: flex; flex-direction: column; gap: 6px; }
  .d-stats b { font-family: var(--serif); font-weight: 400; font-size: 40px; line-height: 1; color: var(--bone); }
  .d-empty { font-size: 20px; margin: 10px 0; }
  .d-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(243, 236, 220, .12); }
  .d-item { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 20px 0; border-bottom: 1px solid rgba(243, 236, 220, .1); }
  .d-item-main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .d-item-title { font-size: 26px; }
  .d-item-actions { display: flex; align-items: center; gap: 16px; flex: none; }
  .d-item-actions .ghost { border-radius: 8px; padding: 12px 18px; }
  .d-status { align-self: flex-start; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; box-shadow: inset 0 0 0 1px currentColor; }
  .s-draft { color: var(--muted-dark); }
  .s-submitted { color: var(--ember); }
  .s-returned { color: #E6A99A; }
  .s-approved { color: #9FD8B8; }
  .s-declined { color: #8C8679; }
  .d-note { margin: 4px 0 0; padding: 12px 16px; border-left: 2px solid #E6A99A; background: rgba(230, 169, 154, .06); font-family: var(--serif); font-style: italic; font-size: 18px; line-height: 1.45; display: flex; flex-direction: column; gap: 6px; }
  .d-note .lab { font-style: normal; color: #E6A99A; }

  .d-editor .field { width: 100%; font-size: 18px; padding: 14px 16px; }
  .d-editor select.field { appearance: none; font-style: normal; font-family: var(--sans); font-size: 13px; letter-spacing: .06em; color: var(--bone); }
  .d-editor select.field option { color: #12160F; }
  .d-big { font-size: 32px !important; font-style: normal !important; }
  .d-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .d-lbl { display: flex; flex-direction: column; gap: 8px; }
  .d-lbl > .lab { color: var(--muted-dark); }
  .d-tools .chip { min-height: 38px; padding: 8px 14px; }
  .d-body { min-height: 440px; resize: vertical; font-style: normal !important; font-size: 20px !important; line-height: 1.65; }
  .d-photo { display: flex; gap: 20px; align-items: flex-start; flex-wrap: wrap; }
  .d-photo-frame { width: 200px; aspect-ratio: 3 / 2; border-radius: 10px; overflow: hidden; background: #1B201A; box-shadow: inset 0 0 0 1px rgba(243, 236, 220, .16); display: flex; align-items: center; justify-content: center; }
  .d-photo-frame img { width: 100%; height: 100%; object-fit: cover; }
  .d-photo-fields { flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 14px; }
  .d-photo-fields input[type='file'] { color: var(--muted-dark); font-size: 13px; }
  .d-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; padding-top: 14px; border-top: 1px solid rgba(243, 236, 220, .14); }
  .d-actions .btn, .d-actions .ghost { border-radius: 8px; }
  .d-editor .d-notice { text-align: left; }
  .d-reader .h2 { font-size: 44px; }
  .d-reading { display: flex; flex-direction: column; gap: 16px; white-space: pre-wrap; }

  @media (max-width: 700px) {
    .desk-in { padding: 100px 12px 48px; }
    .d-card { padding: 34px 22px 28px; }
    .d-title { font-size: 38px !important; }
    .d-desk { padding: 26px 18px 30px; gap: 22px; }
    .d-hello { font-size: 30px !important; }
    .d-stats b { font-size: 30px; }
    .d-stats > div { padding: 14px; }
    .d-item { flex-direction: column; align-items: stretch; }
    .d-item-actions { justify-content: flex-start; }
    .d-two { grid-template-columns: minmax(0, 1fr); }
    .d-tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .d-tabs::-webkit-scrollbar { display: none; }
    .d-tab { padding: 12px 10px; letter-spacing: .14em; white-space: nowrap; flex: none; }
    .d-body { min-height: 360px; font-size: 18px !important; }
    .d-actions .btn, .d-actions .ghost { flex: 1; text-align: center; }
  }
</style>
