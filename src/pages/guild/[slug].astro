---
// A published Guild piece, at /guild/<its address>. One page per approved piece, built from Supabase.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import Avatar from '../../components/Avatar.astro';
import Cross from '../../components/Cross.astro';
import AuthorLinks from '../../components/AuthorLinks.astro';
import PrestigeBadge from '../../components/PrestigeBadge.astro';
import { Body, wantsDropCap } from '../../lib/marks';
import { PhotoPlate } from '../../components/PhotoPlate';
import { authorUrl, getGuildPieces, guildPillar, guildUrl, MEDIUM_LABEL, PILLAR_LABEL, readingMinutes, type GuildPiece } from '../../lib/guild';
import { seatFor } from '../../lib/seats';
import '../../styles/desk.css';
import '../../styles/guild-piece.css';

export async function getStaticPaths() {
  const reserved = new Set(['desk', 'members', 'authors']);
  return (await getGuildPieces()).filter((p) => !reserved.has(p.slug)).map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}
const { piece: p } = Astro.props as { piece: GuildPiece };
const a = p.author;
const more = (await guildPillar(p.pillar)).filter((x) => x.id !== p.id).slice(0, 3);
const FALLBACK: Record<string, string> = { watchtower: '/images/watchtower-photo-1200.jpg', hearth: '/images/glass-2-1200.jpg', perimeter: '/images/chapel-and-cross-under-a-1200.jpg' };
const date = new Date(p.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const first = a.display_name.split(' ')[0];
const insta = a.instagram ? `https://instagram.com/${a.instagram}` : '';
const aUrl = authorUrl(a);
// A photograph is shown whole, with what's behind the lens; any words follow it.
const isPhoto = p.medium === 'photograph';
const published = (await getGuildPieces()).filter((x) => x.author.id === a.id).length;
---
<BaseLayout title={p.title} image={p.image || undefined} description={p.standfirst || `${MEDIUM_LABEL[p.medium] ?? ''} by ${a.display_name}`}>
  <section class="hero gp-hero">
    {p.image
      ? <img src={p.image} alt={p.image_alt} style={`object-position:${p.imagePos || 'center 45%'};filter:brightness(.5)`} fetchpriority="high" />
      : <img src="/images/tall-windows-dark-vault-1200.jpg" alt="" style="object-position:center 55%;filter:brightness(.35)" fetchpriority="high" />}
    <div class="veil"></div>
    <SiteNav />
    <div class="hero-c gp-hero-c">
      <a class="lab gp-back" href={`/${p.pillar}`}>{PILLAR_LABEL[p.pillar]}</a>
      <span class="eb"><a class="gp-eb-room" href={`/${p.pillar}`}>{PILLAR_LABEL[p.pillar]}</a><span class="gp-eb-dot"> · </span>{MEDIUM_LABEL[p.medium] ?? ''}</span>
      <h1 class="h1 gp-title">{p.title}</h1>
      <span class="gp-by">
        <a class="gp-by-who" href={aUrl}><Avatar name={a.display_name} src={a.portrait || undefined} size={30} id={a.id} /><span class="lab">{a.display_name}</span></a>
        <span class="lab">· {date}{isPhoto ? '' : ` · ${readingMinutes(p.body)} min read`}</span>
      </span>
    </div>
  </section>

  <article class="sec paper gp-article">
    <div class:list={['narrow gp-flow', { 'gp-drop': !isPhoto && wantsDropCap(p.medium, p.body), 'gp-photo': isPhoto }]}>
      {p.standfirst && <p class="lede gp-standfirst">{p.standfirst}</p>}
      {isPhoto && p.image && <PhotoPlate src={p.image} alt={p.image_alt} meta={p.photoMeta} gallery={p.gallery} />}
      {p.body.trim() && <Body body={p.body} />}
      <div class="gp-sign"><Cross width={20} color="#62372D" /><span>{first}</span></div>
      <!-- Share: the phone's share sheet, or the link copied on a computer (BaseLayout's [data-share]). -->
      <div class="gp-share">
        <button type="button" class="gp-share-btn" data-share>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg>
          <span>Share this {isPhoto ? 'photograph' : 'piece'}</span>
        </button>
      </div>

      <aside class="gp-author" aria-label="About the author">
        <a class="gp-arch" href={aUrl} aria-hidden="true" tabindex="-1" data-author-id={a.id}><img src={a.portrait || seatFor(a.display_name)} alt="" loading="lazy" /></a>
        <div class="gp-author-text">
          <span class="eb">About the author</span>
          <a class="gp-author-name" href={aUrl}>{a.display_name}</a>
          {a.craft && <span class="gp-craft">{a.craft}</span>}
          <span class="gp-prestige"><PrestigeBadge published={published} tone="paper" /></span>
          {a.bio && <p class="gp-bio">{a.bio}</p>}
          <AuthorLinks website={a.website} instagram={a.instagram} email={a.email} />
          <a class="gp-all" href={aUrl}>All of {first}’s work <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </article>

  {more.length > 0 && (
    <section class="sec dark">
      <span class="eb">More from {PILLAR_LABEL[p.pillar]}</span>
      <div class="g3" style="margin-top:30px">
        {more.map((m) => (
          <a href={guildUrl(m)} class="gp-more">
            <span class="gp-more-img"><img src={m.image || FALLBACK[m.pillar]} alt="" loading="lazy" class:list={[{ mono: !m.image }]} style={m.image && m.imagePos ? `object-position:${m.imagePos}` : undefined} /></span>
            <span class="lab gp-more-k">{MEDIUM_LABEL[m.medium] ?? ''} · {m.author.display_name}</span>
            <span class="h3">{m.title}</span>
            {m.standfirst && <span class="it gp-more-sf">{m.standfirst}</span>}
          </a>
        ))}
      </div>
    </section>
  )}
  <Subscribe />
</BaseLayout>

<!-- How far through the piece you are: a fine gold line along the top of the screen -->
<div class="gp-progress" aria-hidden="true"><i></i></div>
<script>
  const bar = document.querySelector<HTMLElement>('.gp-progress i');
  const article = document.querySelector<HTMLElement>('.gp-article');
  if (bar && article) {
    let ticking = false;
    const update = () => {
      const r = article.getBoundingClientRect();
      const k = Math.min(1, Math.max(0, (innerHeight - r.top) / (r.height + innerHeight * 0.4)));
      bar.style.transform = `scaleX(${k})`; ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
