---
// A published Guild piece, at /guild/<its address>. One page per approved piece, built from Supabase.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import Avatar from '../../components/Avatar.astro';
import Cross from '../../components/Cross.astro';
import { Body } from '../../lib/marks';
import { getGuildPieces, guildPillar, guildUrl, MEDIUM_LABEL, PILLAR_LABEL, readingMinutes, type GuildPiece } from '../../lib/guild';
import '../../styles/desk.css';

export async function getStaticPaths() {
  const reserved = new Set(['desk', 'members']);
  return (await getGuildPieces()).filter((p) => !reserved.has(p.slug)).map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}
const { piece: p } = Astro.props as { piece: GuildPiece };
const a = p.author;
const more = (await guildPillar(p.pillar)).filter((x) => x.id !== p.id).slice(0, 3);
const date = new Date(p.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const first = a.display_name.split(' ')[0];
const insta = a.instagram ? `https://instagram.com/${a.instagram}` : '';
---
<BaseLayout title={p.title} description={p.standfirst || `${MEDIUM_LABEL[p.medium] ?? ''} by ${a.display_name}`}>
  <section class="hero gp-hero">
    {p.image
      ? <img src={p.image} alt={p.image_alt} style="object-position:center 45%;filter:brightness(.5)" fetchpriority="high" />
      : <img src="/images/tall-windows-dark-vault-1200.jpg" alt="" style="object-position:center 55%;filter:brightness(.35)" fetchpriority="high" />}
    <div class="veil"></div>
    <SiteNav />
    <div class="hero-c gp-hero-c">
      <span class="eb"><a href={`/${p.pillar}`}>{PILLAR_LABEL[p.pillar]}</a> · {MEDIUM_LABEL[p.medium] ?? ''}</span>
      <h1 class="h1 gp-title">{p.title}</h1>
      <span class="gp-by">
        <Avatar name={a.display_name} src={a.portrait || undefined} size={30} />
        <span class="lab">{a.display_name} · {date} · {readingMinutes(p.body)} min read</span>
      </span>
    </div>
  </section>

  <article class="sec paper gp-article">
    <div class="narrow gp-flow">
      {p.standfirst && <p class="lede gp-standfirst">{p.standfirst}</p>}
      <Body body={p.body} />
      <div class="gp-sign"><Cross width={20} color="#62372D" /><span>{first}</span></div>

      <aside class="gp-author" aria-label="About the author">
        <span class="gp-arch" aria-hidden="true">{a.portrait ? <img src={a.portrait} alt="" loading="lazy" /> : a.display_name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('')}</span>
        <div class="gp-author-text">
          <span class="eb">About the author</span>
          <span class="h3">{a.display_name}</span>
          {a.craft && <span class="lab mut">{a.craft}</span>}
          {a.bio && <p class="body">{a.bio}</p>}
          <span class="gp-links">
            {a.website && <a class="lab" href={a.website} target="_blank" rel="noopener noreferrer">Website ↗</a>}
            {insta && <a class="lab" href={insta} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
          </span>
        </div>
      </aside>
    </div>
  </article>

  {more.length > 0 && (
    <section class="sec dark">
      <span class="eb">More from {PILLAR_LABEL[p.pillar]}</span>
      <div class="g3" style="margin-top:30px">
        {more.map((m) => (
          <a href={guildUrl(m)} class="rule gp-more">
            <span class="lab mut">{m.author.display_name}</span>
            <span class="h3">{m.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}
  <Subscribe />
</BaseLayout>

<style>
  .gp-hero { height: 680px; }
  .gp-hero-c { top: 230px; padding: 0 40px; }
  .gp-hero-c .eb a:hover { color: var(--bone); }
  .gp-title { margin-top: 22px; max-width: 980px; font-size: 68px; }
  .gp-by { margin-top: 26px; display: inline-flex; align-items: center; gap: 12px; }
  .gp-flow { display: flex; flex-direction: column; gap: 26px; }
  .gp-flow :global(p.body) { font-size: 22px; margin: 0; }
  .gp-flow :global(h2.eb) { margin: 14px 0 0; }
  .gp-flow > :global(p.lede + p.body::first-letter), .gp-flow > :global(p.body:first-child::first-letter) { float: left; font-family: var(--serif); font-weight: 500; font-size: 96px; line-height: .78; margin: 8px 14px 0 0; color: var(--oxblood); }
  .gp-standfirst { font-size: 30px; font-style: italic; color: var(--muted-paper); }
  .gp-sign { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
  .gp-sign span { font-family: var(--script); font-size: 52px; color: var(--oxblood); line-height: 1.2; }
  .gp-author { margin-top: 30px; padding-top: 36px; border-top: 1px solid rgba(42, 32, 23, .2); display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 32px; align-items: start; }
  .gp-arch { width: 140px; height: 184px; border-radius: 999px 999px 0 0; overflow: hidden; box-shadow: 0 0 0 1px var(--brass);
    display: flex; align-items: center; justify-content: center; background: #E3DCCD; color: var(--oxblood); font-family: var(--serif); font-size: 44px; }
  .gp-arch img { width: 100%; height: 100%; object-fit: cover; }
  .gp-author-text { display: flex; flex-direction: column; gap: 10px; }
  .gp-author-text .h3 { font-size: 32px; }
  .gp-author-text .body { font-size: 19px !important; }
  .gp-links { display: flex; gap: 22px; }
  .gp-links a { border-bottom: 1px solid rgba(42, 32, 23, .35); padding-bottom: 3px; }
  .gp-more { padding-top: 24px; display: flex; flex-direction: column; gap: 10px; }
  .gp-more:hover .h3 { color: var(--ember); }
  @media (max-width: 700px) {
    .gp-hero { height: 560px; }
    .gp-hero-c { top: 140px; padding: 0 22px; }
    .gp-title { font-size: 36px !important; }
    .gp-by .lab { font-size: 9px; letter-spacing: .14em; }
    .gp-standfirst { font-size: 21px !important; }
    .gp-flow :global(p.body) { font-size: 18px !important; }
    .gp-author { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
    .gp-links { justify-content: center; }
  }
</style>
