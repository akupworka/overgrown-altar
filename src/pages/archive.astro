---
// Archive — converted from the design file Archive.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import { getCatalog } from '../lib/catalog';
const pieces = await getCatalog();
import { ROOMS, KINDS } from '../lib/kinds';
---
<BaseLayout title="Archive">
<section class="hero" style="height:560px"><img src="/images/tall-windows-dark-vault.jpg" srcset="/images/tall-windows-dark-vault-1200.jpg 1200w, /images/tall-windows-dark-vault.jpg 1331w" sizes="100vw" alt="Tall stained-glass windows in a dark Gothic vault" style="object-position:center 62%;filter:grayscale(1) brightness(.45)" class="mono" fetchpriority="high" /><div class="veil"></div><SiteNav />
<div class="hero-c" style="top:202px;padding:0 24px"><span class="eb">Everything, in one place</span><h1 class="h1" style="margin-top:22px">The Archive</h1></div></section>
<section class="sec paper" style="padding-top:80px"><div style="display:flex;flex-direction:column;gap:26px">
<input class="field search" type="search" placeholder="Search by title, writer or craft…" aria-label="Search the archive" id="archive-search" name="q" style="font-size:24px;padding:22px 24px;width:100%" />
<div class="ar-filters">
<div class="filters"><span class="lab mut fl">Room</span><button type="button" class="chip" aria-pressed="true" data-k="pillar" data-v="all">All</button>{ROOMS.map((r) => <button type="button" class="chip" aria-pressed="false" data-k="pillar" data-v={r.id}>{r.name}</button>)}</div>
<div class="filters"><span class="lab mut fl">Craft</span><button type="button" class="chip" aria-pressed="true" data-k="medium" data-v="all">All</button>{KINDS.map((k) => <button type="button" class="chip" aria-pressed="false" data-k="medium" data-v={k.value} data-room={k.pillar}>{k.plural}</button>)}<a class="ar-guide lab" href="/crafts/">What each craft is →</a></div>
</div>
<div class="g3 results" style="margin-top:60px">{pieces.map((a) => (
<a class="item" href={a.href} data-pillar={a.pillar} data-medium={a.medium} style="display:flex;flex-direction:column;gap:12px"><div class="tile" style="height:260px"><img src={a.image} alt="" loading="lazy" style={a.imagePos ? `object-position:${a.imagePos}` : undefined} /></div><span class="lab" style="color:#62372D">{a.kicker.split(' · ')[0] === 'Dispatch 1' ? 'The Watchtower · Essay' : a.kicker === 'Recovery story' ? 'The Perimeter · Recovery story' : a.kicker}</span><span class="h3" style="font-size:27px">{a.title}</span><span class="lab mut" style="font-size:10px">{a.author.name}</span></a>
))}</div>
<nav class="pager ar-pager" aria-label="Pages of the archive" hidden></nav>
<p class="it mut empty" style="display:none;margin-top:40px;font-size:22px">Nothing here yet. Try another filter.</p></section>
<script>
  import { pagerHtml, pageFromUrl, rememberPage, toListTop } from '../lib/pager';
  // Archive search and filters. This runs in the visitor's browser.
  // Each result card carries data-pillar and data-medium tags;
  // we hide the cards that don't match the chosen chips and the search words.
  const search = document.querySelector<HTMLInputElement>('#archive-search')!;
  const items = [...document.querySelectorAll<HTMLElement>('.results .item')];
  const chosen: Record<string, string> = { pillar: 'all', medium: 'all' };

  const empty = document.createElement('p');
  empty.className = 'it mut';
  empty.style.cssText = 'font-size:22px;margin:40px 0 0;display:none';
  empty.textContent = 'Nothing on the altar matches that yet.';
  document.querySelector('.results')!.after(empty);

  // Twelve to a page (four rows of three); a new search or filter starts again at page one.
  const PER = 12, pager = document.querySelector<HTMLElement>('.ar-pager')!;
  let page = pageFromUrl();
  function paginate(scroll = false) {
    const on = items.filter((i) => !i.hidden);
    const pages = Math.max(1, Math.ceil(on.length / PER)); page = Math.min(page, pages);
    items.forEach((i) => i.classList.remove('pg-off'));
    on.forEach((i, n) => i.classList.toggle('pg-off', n < (page - 1) * PER || n >= page * PER));
    pager.hidden = pages < 2; pager.innerHTML = pagerHtml(page, pages, 'Newer', 'Older');
    rememberPage(page);
    if (scroll) toListTop('.results');
  }
  pager.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-go]');
    if (!b || b.disabled) return; page = Number(b.dataset.go); paginate(true);
  });
  function update() {
    page = 1;
    const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const text = (item.textContent + ' ' + Object.values(item.dataset).join(' ')).toLowerCase();
      const ok = Object.entries(chosen).every(([k, v]) => v === 'all' || item.dataset[k] === v)
        && words.every((w) => text.includes(w));
      item.hidden = !ok;
      if (ok) shown++;
    }
    empty.style.display = shown ? 'none' : 'block';
    paginate();
  }
  paginate();

  document.querySelectorAll<HTMLButtonElement>('.chip[data-k]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.k!;
      chosen[key] = chip.dataset.v!;
      document.querySelectorAll(`.chip[data-k="${key}"]`).forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      if (key === 'pillar') narrowForms();
      update();
    });
  });
  search.addEventListener('input', update);

  // Choosing a room shows only the crafts that room takes.
  function narrowForms() {
    const room = chosen.pillar;
    document.querySelectorAll<HTMLButtonElement>('.chip[data-k="medium"][data-room]').forEach((c) => {
      const fits = room === 'all' || c.dataset.room === room;
      c.hidden = !fits;
      if (!fits && chosen.medium === c.dataset.v) { chosen.medium = 'all'; document.querySelectorAll('.chip[data-k="medium"]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.v === 'all'))); }
    });
  }
  // Arriving from the Crafts page: /archive/?pillar=hearth&medium=poetry
  const want = new URLSearchParams(location.search);
  for (const key of ['pillar', 'medium']) {
    const v = want.get(key); if (!v) continue;
    const chip = document.querySelector<HTMLButtonElement>(`.chip[data-k="${key}"][data-v="${v}"]`); chip?.click();
  }

  // Arriving from the Menu's search box: /archive?q=jung
  const q = new URLSearchParams(location.search).get('q');
  if (q) { search.value = q; update(); }
</script>
</BaseLayout>

<style>
  .ar-filters { display: flex; flex-direction: column; gap: 12px; }
  .ar-filters .chip { font-size: 9.5px; letter-spacing: .16em; padding: 6px 13px; min-height: 30px; }
  .ar-filters .chip[hidden] { display: none; }
  .results .item.pg-off { display: none !important; }
  .results { scroll-margin-top: 110px; }
  .ar-pager { margin-top: 56px; }
  .ar-filters .fl { width: 64px; font-size: 10px; }
  .ar-filters .filters { gap: 7px; }
  .ar-guide { margin-left: 6px; color: var(--oxblood); border-bottom: 1px solid rgba(98,55,45,.35); padding-bottom: 2px; font-size: 10px; white-space: nowrap; }
  @media (max-width: 700px) { .ar-guide { display: none; } }
</style>
