---
// Archive — converted from the design file Archive.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import { getCatalog } from '../lib/catalog';
const pieces = await getCatalog();
---
<BaseLayout title="Archive">
<section class="hero" style="height:560px"><img src="/images/tall-windows-dark-vault.jpg" srcset="/images/tall-windows-dark-vault-1200.jpg 1200w, /images/tall-windows-dark-vault.jpg 1331w" sizes="100vw" alt="Tall stained-glass windows in a dark Gothic vault" style="object-position:center 62%;filter:grayscale(1) brightness(.45)" class="mono" fetchpriority="high" /><div class="veil"></div><SiteNav />
<div class="hero-c" style="top:202px;padding:0 24px"><span class="eb">Everything, in one place</span><h1 class="h1" style="margin-top:22px">The Archive</h1></div></section>
<section class="sec paper" style="padding-top:80px"><div style="display:flex;flex-direction:column;gap:26px">
<input class="field search" type="search" placeholder="Search by title, thinker or medium…" aria-label="Search the archive" id="archive-search" name="q" style="font-size:24px;padding:22px 24px;width:100%" />
<div class="filters"><span class="lab mut fl">Pillar</span><button type="button" class="chip" aria-pressed="true" data-k="pillar" data-v="all">All</button><button type="button" class="chip" aria-pressed="false" data-k="pillar" data-v="watchtower">The Watchtower</button><button type="button" class="chip" aria-pressed="false" data-k="pillar" data-v="hearth">The Hearth</button><button type="button" class="chip" aria-pressed="false" data-k="pillar" data-v="perimeter">The Perimeter</button></div>
<div class="filters"><span class="lab mut fl">Medium</span><button type="button" class="chip" aria-pressed="true" data-k="medium" data-v="all">All</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="essay">Essays</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="photograph">Photographs</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="prose">Prose</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="fiction">Fiction</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="teardown">Teardowns</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="protocol">Protocols</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="recovery">Recovery stories</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="testimony">Testimonies</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="deliverance">Deliverance stories</button><button type="button" class="chip" aria-pressed="false" data-k="medium" data-v="personal">Personal</button></div>
<div class="filters"><span class="lab mut fl">Thinker</span><button type="button" class="chip" aria-pressed="true" data-k="thinker" data-v="all">All</button><button type="button" class="chip" aria-pressed="false" data-k="thinker" data-v="nietzsche">Nietzsche</button><button type="button" class="chip" aria-pressed="false" data-k="thinker" data-v="jung">Jung</button><button type="button" class="chip" aria-pressed="false" data-k="thinker" data-v="freud">Freud</button><button type="button" class="chip" aria-pressed="false" data-k="thinker" data-v="bukowski">Bukowski</button><button type="button" class="chip" aria-pressed="false" data-k="thinker" data-v="newton">Newton</button><button type="button" class="chip" aria-pressed="false" data-k="thinker" data-v="quantum">Quantum</button></div></div>
<div class="g3 results" style="margin-top:60px">{pieces.map((a) => (
<a class="item" href={a.href} data-pillar={a.pillar} data-medium={a.medium === 'study' || a.medium === 'poetry' ? 'prose' : a.medium} data-thinker={a.thinkers.join(' ')} style="display:flex;flex-direction:column;gap:12px"><div class="tile" style="height:260px"><img src={a.image} alt="" loading="lazy" /></div><span class="lab" style="color:#62372D">{a.kicker.split(' · ')[0] === 'Dispatch 1' ? 'The Watchtower · Essay' : a.kicker === 'Recovery story' ? 'The Perimeter · Recovery story' : a.kicker}</span><span class="h3" style="font-size:27px">{a.title}</span><span class="lab mut" style="font-size:10px">{a.author.name}</span></a>
))}</div>
<p class="it mut empty" style="display:none;margin-top:40px;font-size:22px">Nothing here yet. Try another filter.</p></section>
<script>
  // Archive search and filters. This runs in the visitor's browser.
  // Each result card carries data-pillar, data-medium and data-thinker tags;
  // we hide the cards that don't match the chosen chips and the search words.
  const search = document.querySelector<HTMLInputElement>('#archive-search')!;
  const items = [...document.querySelectorAll<HTMLElement>('.results .item')];
  const chosen: Record<string, string> = { pillar: 'all', medium: 'all', thinker: 'all' };

  const empty = document.createElement('p');
  empty.className = 'it mut';
  empty.style.cssText = 'font-size:22px;margin:40px 0 0;display:none';
  empty.textContent = 'Nothing on the altar matches that yet.';
  document.querySelector('.results')!.after(empty);

  function update() {
    const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const text = (item.textContent + ' ' + Object.values(item.dataset).join(' ')).toLowerCase();
      const ok = Object.entries(chosen).every(([k, v]) => v === 'all' || item.dataset[k] === v)
        && words.every((w) => text.includes(w));
      item.hidden = !ok;
      if (ok) shown++;
    }
    empty.style.display = shown ? 'none' : 'block';
  }

  document.querySelectorAll<HTMLButtonElement>('.chip[data-k]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.k!;
      chosen[key] = chip.dataset.v!;
      document.querySelectorAll(`.chip[data-k="${key}"]`).forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      update();
    });
  });
  search.addEventListener('input', update);

  // Arriving from the Menu's search box: /archive?q=jung
  const q = new URLSearchParams(location.search).get('q');
  if (q) { search.value = q; update(); }
</script>
</BaseLayout>
