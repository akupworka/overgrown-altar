---
// The Perimeter — converted from the design file Perimeter.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import DispatchList, { type DispatchItem } from '../../components/DispatchList.astro';
import { authorUrl, guildPillar, guildUrl, MEDIUM_LABEL, readingMinutes } from '../../lib/guild';
const fromGuild: DispatchItem[] = (await guildPillar('perimeter')).filter((g) => g.medium !== 'protocol').map((g) => ({
  href: guildUrl(g), title: g.title, kicker: MEDIUM_LABEL[g.medium] ?? '', standfirst: g.standfirst,
  date: g.published_at.slice(0, 10), minutes: readingMinutes(g.body),
  author: { name: g.author.display_name, portrait: g.author.portrait || undefined, href: authorUrl(g.author), id: g.author.id }, image: g.image || '/images/chapel-and-cross-under-a-1200.jpg',
}));
import { inPillar } from '../../lib/catalog';
const protocols = (await inPillar('perimeter')).filter((p) => p.medium === 'protocol');
---
<BaseLayout title="The Perimeter">
<section class="hero pill-h"><img src="/images/the-perimeter.jpg" srcset="/images/the-perimeter-1200.jpg 1200w, /images/the-perimeter.jpg 2880w" sizes="100vw" alt="The Perimeter" style="object-position:center 50%;" class="mono" fetchpriority="high" /><div class="veil-l"></div><SiteNav />
<div class="pill-in"><span class="eb">03 · Deliverance Protocols</span><h1 class="h1" style="text-transform:uppercase;letter-spacing:.04em">The Perimeter</h1><p class="body" style="color:#E6DFD0;max-width:720px">Actionable recovery manuals for legal audits, breaking soul ties, untangling mental strongholds, and establishing firm personal and spiritual boundaries.</p></div></section>
{fromGuild.length > 0 && (
<section class="sec paper">
<div class="row" style="padding-bottom:26px"><div style="display:flex;flex-direction:column;gap:14px"><span class="eb">From the Guild</span><h2 class="h2">Newest work</h2></div><span class="lab mut">{fromGuild.length} {fromGuild.length === 1 ? 'piece' : 'pieces'} · newest first</span></div>
<DispatchList items={fromGuild} />
</section>
)}
<section class="sec paper"><div class="row" style="padding-bottom:34px;border-bottom:1px solid #2A2017"><div style="display:flex;flex-direction:column;gap:16px"><span class="eb">Recovery Manuals</span><h2 class="h2">The protocols</h2></div><span class="it mut" style="font-size:20px">Actionable, step by step, kept in order.</span></div>
<div class="g2" style="margin-top:56px">{protocols.map((p, i) => (
<a href={p.href} class="protocol" style="display:flex;flex-direction:column;gap:16px;padding:40px;background:#F1ECE2;box-shadow:inset 0 0 0 1px rgba(42,32,23,.15)"><span class="num" style="font-size:80px;color:#62372D">{p.kicker.startsWith('Protocol') ? p.kicker.replace('Protocol ', '') : ['I','II','III','IV','V','VI','VII','VIII'][i]}</span><span class="h3">{p.title}</span><p class="body mut" style="font-size:19px">{p.standfirst}</p><span class="lab" style="align-self:flex-start;border-bottom:1px solid #2A2017;padding-bottom:4px">Open the manual</span></a>
))}</div></section>
<section class="hero" style="min-height:560px;display:flex;align-items:center"><img src="/images/chapel-and-cross-under-a.jpg" srcset="/images/chapel-and-cross-under-a-1200.jpg 1200w, /images/chapel-and-cross-under-a.jpg 2576w" sizes="100vw" alt="Chapel and cross under a storm sky" style="object-position:center 45%;" class="mono" loading="lazy" /><div class="veil-l"></div><div class="hin sec" style="max-width:900px;display:flex;flex-direction:column;gap:22px"><span class="eb">Unmasking the Script</span><p class="big-it" style="font-size:64px">We name the invisible mechanics.</p></div></section>
<Subscribe />
</BaseLayout>

<style>
  .protocol:hover { box-shadow: inset 0 0 0 1px var(--oxblood) !important; }
  @media (max-width: 700px) { .protocol { padding: 26px !important; } }
</style>
