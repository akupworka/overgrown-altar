---
// The Perimeter — converted from the design file Perimeter.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import Cross from '../../components/Cross.astro';
import { getArticles, articleUrl, roman } from '../../lib/sanity';

const protocols = await getArticles('perimeter');
---
<BaseLayout title="The Perimeter">
<section class="hero pill-h"><img src="/images/the-perimeter.jpg" srcset="/images/the-perimeter-1200.jpg 1200w, /images/the-perimeter.jpg 2880w" sizes="100vw" alt="The Perimeter" style="object-position:center 50%;" class="mono" fetchpriority="high" /><div class="veil-l"></div><SiteNav />
<div class="pill-in"><span class="eb">03 · Deliverance Protocols</span><h1 class="h1" style="text-transform:uppercase;letter-spacing:.04em">The Perimeter</h1><p class="body" style="color:#E6DFD0;max-width:720px">Actionable recovery manuals for legal audits, breaking soul ties, untangling mental strongholds, and establishing firm personal and spiritual boundaries.</p></div></section>
<section class="sec paper"><div class="row" style="padding-bottom:34px;border-bottom:1px solid #2A2017"><div style="display:flex;flex-direction:column;gap:16px"><span class="eb">Recovery Manuals</span><h2 class="h2">The protocols</h2></div><span class="it mut" style="font-size:20px">Actionable, step by step, kept in order.</span></div>
<div class="g2" style="margin-top:56px">{protocols.map((a) => (
<a href={articleUrl(a)} class="protocol" style="display:flex;flex-direction:column;gap:16px;padding:40px;background:#F1ECE2;box-shadow:inset 0 0 0 1px rgba(42,32,23,.15)"><div style="display:flex;justify-content:space-between;align-items:flex-start"><span class="num" style="font-size:80px;color:#62372D">{roman(a.number)}</span><Cross width={25} color="#9F945E" /></div><span class="h3">{a.title}</span><p class="body mut" style="font-size:19px">{a.standfirst}</p><span class="lab" style="align-self:flex-start;border-bottom:1px solid #2A2017;padding-bottom:4px">Open the manual</span></a>
))}</div></section>
<section class="hero" style="min-height:560px;display:flex;align-items:center"><img src="/images/chapel-and-cross-under-a.jpg" alt="Chapel and cross under a storm sky" style="object-position:center 45%;" class="mono" loading="lazy" /><div class="veil-l"></div><div class="hin sec" style="max-width:900px;display:flex;flex-direction:column;gap:22px"><span class="eb">Unmasking the Script</span><p class="big-it" style="font-size:64px">We name the invisible mechanics.</p></div></section>
<Subscribe />
</BaseLayout>

<style>
  .protocol:hover { box-shadow: inset 0 0 0 1px var(--oxblood) !important; }
  @media (max-width: 700px) { .protocol { padding: 26px !important; } }
</style>
