---
// The Fellowship: readers with an account. Joining is open to anyone: name and email, then a welcome letter
// with a link to choose a password (netlify/functions/join-fellowship.mts). Writers apply to the Guild instead.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import FellowshipJoin from '../components/FellowshipJoin.astro';
---
<BaseLayout title="The Fellowship" description="Join the Fellowship of the Overgrown Altar: keep a collection of the work and photographs you love, write to the Guild, and join the conversation.">
  <section class="hero fs-hero">
    <img src="/images/window-of-the-ascension-and.jpg" alt="" style="object-position:center 35%;filter:brightness(.5)" fetchpriority="high" />
    <div class="veil"></div>
    <SiteNav />
    <div class="hero-c fs-hero-c">
      <span class="eb">Readers of the altar</span>
      <h1 class="h1">The Fellowship</h1>
      <p class="it fs-lead">For those who come to read, to look, and to keep company with the Guild.</p>
      <a class="btn" href="#join">Join the Fellowship</a>
    </div>
  </section>

  <section class="sec paper fs-what">
    <ol class="fs-three">
      <li><span class="num">I</span><span class="fs-k">Collect</span><span class="it mut fs-d">Keep the pieces and photographs you love in a collection of your own, open for others to see.</span></li>
      <li><span class="num">II</span><span class="fs-k">Converse</span><span class="it mut fs-d">Write to the members of the Guild, and pull up a chair in the Forum.</span></li>
      <li><span class="num">III</span><span class="fs-k">Belong</span><span class="it mut fs-d">Follow the writers whose work stays with you. In time, you may take a seat at the Guild’s table yourself.</span></li>
    </ol>
  </section>

  <section class="sec dark fs-join" id="join">
    <FellowshipJoin />
  </section>
</BaseLayout>



<style>
  .fs-lead { margin: 0; max-width: 620px; font-size: 26px; line-height: 1.4; color: #E6DFD0; }
  .fs-three { list-style: none; margin: 0 auto; padding: 0; max-width: 1100px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .fs-three li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; }
  .fs-three .num { font-size: 60px; color: var(--oxblood); }
  .fs-k { font-family: var(--serif); font-size: 34px; letter-spacing: .08em; text-transform: uppercase; }
  .fs-d { font-size: 20px; max-width: 300px; line-height: 1.45; }
  .fs-join { display: flex; justify-content: center; }
  @media (max-width: 700px) {
    .fs-lead { font-size: 20px; }
    .fs-three { grid-template-columns: 1fr; gap: 34px; }
    .fs-k { font-size: 26px; }
    .fs-d { font-size: 18px; }
  }
</style>
