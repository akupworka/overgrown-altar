---
// Join: two doors, side by side (stacked on phones). The Fellowship, for readers: free and open to all.
// The Guild, for writers and photographers: by application, read by the editor. Choosing a door opens its form below.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import FellowshipJoin from '../components/FellowshipJoin.astro';
import GuildApply from '../components/GuildApply.astro';
import '../styles/doorway.css';
import '../styles/guild.css';
import { crestSvg } from '../lib/crests';
import { PRESTIGES } from '../lib/prestige';
import { TROPHIES, trophySvg } from '../lib/trophies';
import { BADGES, STATIONS, enamelOf, pewterBadge } from '../lib/way';
import { uniqueIds } from '../lib/svgIds';
// A glimpse of what is earned inside, on each door: ranks and trophies for the Guild, pilgrim badges for the Fellowship.
const T = (id: string) => TROPHIES.find((t) => t.id === id)!;
const guildEarn = [...[1, 4, 7, 10].map((lv) => crestSvg(lv, 46)), ...['signal-fire', 'lion', 'cathedral'].map((id, i) => trophySvg(T(id), 44, i === 0 ? 'gold' : 'rainbow', false, true))].map((x) => uniqueIds(x));
const fellowEarn = ['first-keep', 'kind-word', 'fellow-traveller', 'season', 'lamp'].map((id) => BADGES.find((b) => b.id === id)!).map((b) => uniqueIds(pewterBadge(b.glyph, 42, true, enamelOf(b))));
---
<BaseLayout title="Join" footer={false} description="Two ways to the table: the Fellowship, for readers, free and open to all; or the Guild, for writers and photographers, by application.">
  <SiteNav />
  <section class="jn" aria-label="Choose your way in">
    <a class="jn-door jn-f" href="#fellowship" data-door="fellowship">
      <img src="/images/window-of-the-ascension-and.jpg" alt="" fetchpriority="high" />
      <span class="jn-veil"></span>
      <span class="jn-in">
        <span class="eb">For readers</span>
        <span class="jn-t">The Fellowship</span>
        <span class="it jn-line">Free, and open to all.</span>
        <span class="jn-pts">
          <span><b>Collect</b> the pieces and photographs you love</span>
          <span><b>Converse</b> with the Guild, by message and in the Forum</span>
          <span><b>Follow</b> the writers whose work stays with you</span>
        </span>
        <span class="jn-earn" aria-hidden="true"><span class="jn-earn-row">{fellowEarn.map((x) => <span set:html={x} />)}</span><span class="lab">{STATIONS.length} stations on The Way · {BADGES.length} pilgrim badges</span></span>
        <span class="jn-go">Join the Fellowship <i aria-hidden="true">→</i></span>
      </span>
    </a>
    <a class="jn-door jn-g" href="#guild" data-door="guild">
      <img src="/images/format-guild.jpg" alt="" fetchpriority="high" />
      <span class="jn-veil"></span>
      <span class="jn-in">
        <span class="eb">For writers &amp; photographers</span>
        <span class="jn-t">The Guild</span>
        <span class="it jn-line">By application. Every one is read.</span>
        <span class="jn-pts">
          <span><b>Apply</b> with a sample of your work</span>
          <span><b>Be read</b> by the Editor in Chief, within three days</span>
          <span><b>Take your seat</b>: write, publish, and climb the prestiges</span>
        </span>
        <span class="jn-earn" aria-hidden="true"><span class="jn-earn-row">{guildEarn.map((x, i) => <span class:list={{ 'jn-earn-gap': i === 4 }} set:html={x} />)}</span><span class="lab">{PRESTIGES.length} ranks · {TROPHIES.length} trophies</span></span>
        <span class="jn-go">Apply to the Guild <i aria-hidden="true">→</i></span>
      </span>
    </a>
    <span class="jn-or lab" aria-hidden="true">or</span>
  </section>

  <!-- The Fellowship: what it is, then the form -->
  <section class="sec dark jn-path" id="fellowship" hidden>
    <div class="jn-path-in">
      <div class="jn-path-text">
        <span class="eb">The Fellowship</span>
        <h2 class="h2">Keep company with the Guild.</h2>
        <p class="it mut">The Fellowship is for those who come to read and to look. You won’t publish here; you’ll gather.</p>
        <ol class="jn-list">
          <li><span class="num">I</span><span><b>A library of your own.</b> Save any piece or photograph; your library stands on your page for others to see.</span></li>
          <li><span class="num">II</span><span><b>Conversation.</b> Write to any member, and pull up a chair in the Forum.</span></li>
          <li><span class="num">III</span><span><b>A daily letter</b>, only when something is waiting: replies, messages, new work from writers you follow.</span></li>
          <li><span class="num">IV</span><span><b>In time, the Guild.</b> If you begin to make work of your own, you can apply for a seat at the table.</span></li>
        </ol>
        <div class="jn-must">
          <span class="lab jn-must-k"><i aria-hidden="true"></i>Read before you join</span>
          <p><b>Open to all denominations.</b> We are one body in Christ: a clean, safe house where every tradition is treated with respect and everyone stays teachable.</p>
          <a class="jn-must-go" href="/rule/" target="_blank" rel="noopener">Read the Rule of the House <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <FellowshipJoin />
    </div>
  </section>

  <!-- The Guild: the vetting, then the application -->
  <section class="jn-path jn-path-g" id="guild" hidden>
    <div class="sec paper jn-vet">
      <div class="jn-path-in jn-vet-in">
        <div class="jn-path-text">
          <span class="eb">The Guild</span>
          <h2 class="h2">How a seat is given.</h2>
          <p class="it mut">The Guild is a working table of writers and photographers. Seats are given by application, so that what goes on the altar is worth the reading.</p>
          <a class="lab jn-switch" href="#fellowship" data-door="fellowship">Here to read? Join the Fellowship instead →</a>
        </div>
        <ol class="jn-steps">
          <li><span class="num">1</span><b>Apply</b><span>About ten minutes: who you are, a sample of your work, your faith.</span></li>
          <li><span class="num">2</span><b>We read it</b><span>The Editor in Chief reads every application, and answers within three days.</span></li>
          <li><span class="num">3</span><b>An invitation</b><span>If there is a seat for you, it arrives by email.</span></li>
          <li><span class="num">4</span><b>Take your seat</b><span>Fill in your page, then write your first piece at the Desk.</span></li>
        </ol>
        <div class="jn-must jn-must-paper">
          <span class="lab jn-must-k"><i aria-hidden="true"></i>Read before you apply</span>
          <h3 class="jn-must-h">The Rule of the House</h3>
          <p><b>Open to all denominations.</b> We are one body in Christ: a clean, safe house where every tradition is treated with respect and everyone stays teachable. The Rule is how each member carries themselves here, and the standard the work is held to.</p>
          <a class="jn-must-go" href="/rule/" target="_blank" rel="noopener">Read the Rule of the House <span aria-hidden="true">→</span></a>
          <span class="it jn-must-n">You will confirm you have read it on the first page of the application.</span>
        </div>
        <a class="jn-down" href="#apply">
          <span class="lab">Begin your application</span>
          <span class="jn-down-o" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v15M5.5 12.5L12 19l6.5-6.5" /></svg></span>
        </a>
      </div>
    </div>
    <GuildApply />
  </section>
</BaseLayout>

<script>
  // Choosing a door opens its path below (and the address remembers it: /join/#fellowship or /join/#guild).
  const doors = [...document.querySelectorAll<HTMLAnchorElement>('.jn-door')];
  const paths = { fellowship: document.getElementById('fellowship')!, guild: document.getElementById('guild')! };
  const open = (which: 'fellowship' | 'guild', scroll = true) => {
    (Object.keys(paths) as ('fellowship' | 'guild')[]).forEach((k) => (paths[k].hidden = k !== which));
    doors.forEach((d) => { d.classList.toggle('chosen', d.dataset.door === which); d.classList.toggle('other', d.dataset.door !== which); });
    history.replaceState(null, '', '#' + which);
    if (scroll) requestAnimationFrame(() => paths[which].scrollIntoView({ behavior: 'smooth', block: 'start' }));
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-door]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); open(a.dataset.door as 'fellowship' | 'guild'); }));
  const start = location.hash.replace('#', '');
  if (start === 'fellowship' || start === 'guild' || start === 'apply') open(start === 'apply' ? 'guild' : start, false);
</script>

<style>
  /* Two doors: side by side on a computer, one above the other on a phone */
  .jn { position: relative; display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; min-height: 100svh; background: #060806; }
  .jn-door { position: relative; overflow: hidden; display: flex; align-items: flex-end; color: var(--bone); isolation: isolate; }
  .jn-door img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transform: scale(1.02); transition: transform 1.6s var(--ease, ease), opacity .6s; }
  .jn-f img { object-position: center 30%; }
  .jn-g img { object-position: center 40%; }
  .jn-veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(6, 8, 6, .5) 0%, rgba(6, 8, 6, .25) 28%, rgba(6, 8, 6, .7) 52%, rgba(6, 8, 6, .95) 72%, #060806 100%); transition: opacity .6s; }
  .jn-g .jn-veil { background: linear-gradient(180deg, rgba(6, 8, 6, .55) 0%, rgba(6, 8, 6, .3) 28%, rgba(6, 8, 6, .72) 52%, rgba(6, 8, 6, .95) 72%, #060806 100%); }
  .jn-door + .jn-door { box-shadow: inset 1px 0 0 rgba(255, 227, 163, .25); }
  .jn-in { display: flex; flex-direction: column; gap: 14px; padding: 0 56px 72px; max-width: 560px; transition: transform .7s var(--ease, ease); }
  .jn-t { font-family: var(--serif); font-weight: 400; font-size: 64px; line-height: 1; }
  .jn-line { font-size: 22px; color: #E6DFD0; }
  .jn-pts { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; font-family: var(--serif); font-size: 18px; line-height: 1.4; color: #CFC8B8; }
  .jn-pts b { font-weight: 500; color: var(--bone); }
  .jn-go { align-self: flex-start; margin-top: 16px; display: inline-flex; gap: 12px; align-items: center; padding: 15px 26px; border-radius: 999px;
    font-family: var(--sans); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; transition: background .35s, color .35s, box-shadow .35s; }
  .jn-f .jn-go { background: var(--bone); color: #12160F; }
  .jn-g .jn-go { color: var(--ember); box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .6); background: rgba(6, 8, 6, .35); }
  .jn-go i { font-style: normal; transition: transform .4s var(--ease, ease); }
  .jn-door:hover img { transform: scale(1.07); }
  .jn-door:hover .jn-in { transform: translateY(-6px); }
  .jn-door:hover .jn-go i { transform: translateX(4px); }
  .jn-f:hover .jn-go { background: var(--ember); }
  .jn-g:hover .jn-go { background: rgba(255, 227, 163, .1); }
  /* The half you're not pointing at (or didn't choose) steps back: grey and dim */
  .jn-door img { transition: transform 1.6s var(--ease, ease), filter .6s, opacity .6s; }
  .jn-door .jn-in { transition: transform .7s var(--ease, ease), opacity .6s; }
  @media (hover: hover) {
    .jn:has(.jn-door:hover) .jn-door:not(:hover) img { filter: grayscale(1) brightness(.55); }
    .jn:has(.jn-door:hover) .jn-door:not(:hover) .jn-in { opacity: .55; }
  }
  .jn-door.other img { filter: grayscale(1) brightness(.55); }
  .jn-door.other .jn-in { opacity: .55; }
  .jn-door.chosen .jn-go { box-shadow: 0 0 0 1px var(--ember), 0 10px 30px -12px rgba(255, 214, 140, .5); }
  .jn-or { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 54px; height: 54px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    background: #0B0D0A; color: var(--ember); box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .45); font-size: 10px; pointer-events: none; }

  /* The chosen path */
  .jn-path[hidden] { display: none; }
  .jn-path { scroll-margin-top: 70px; }
  .jn-path-in { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 64px; align-items: start; }
  .jn-path-text { display: flex; flex-direction: column; gap: 16px; }
  .jn-path-text .h2 { margin: 0; }
  .jn-path-text > .it { margin: 0; font-size: 20px; line-height: 1.5; }
  .jn-list { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .jn-list li { display: grid; grid-template-columns: 50px 1fr; gap: 10px; font-family: var(--serif); font-size: 19px; line-height: 1.45; color: #CFC8B8; }
  .jn-list .num { color: var(--ember); font-size: 22px; }
  .jn-list b { font-weight: 500; color: var(--bone); }
  .jn-switch { align-self: flex-start; margin-top: 10px; color: var(--ember); border-bottom: 1px solid rgba(255, 227, 163, .35); padding-bottom: 3px; }
  .paper .jn-switch { color: var(--oxblood); border-bottom-color: rgba(98, 55, 45, .35); }
  /* How a seat is given: a centred head, four steps along one line, what is asked of members, and the way down to the form. */
  .jn-vet { padding-top: 96px; padding-bottom: 72px; }
  .jn-vet-in { grid-template-columns: 1fr; gap: 0; justify-items: center; text-align: center; }
  .jn-vet .jn-path-text { align-items: center; max-width: 720px; }
  .jn-vet .jn-switch { align-self: center; }
  .jn-steps { position: relative; list-style: none; margin: 60px 0 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .jn-steps::before { content: ''; position: absolute; top: 27px; left: 12.5%; right: 12.5%; height: 1px; background: rgba(42, 32, 23, .28); }
  .jn-steps li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .jn-steps .num { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 10px; background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--brass), 0 0 0 8px var(--paper); font-size: 26px; line-height: 1; color: var(--oxblood); }
  .jn-steps b { font-family: var(--serif); font-weight: 500; font-size: 25px; }
  .jn-steps span:last-child { max-width: 250px; font-family: var(--serif); font-style: italic; font-size: 17.5px; line-height: 1.45; color: var(--muted-paper); text-wrap: balance; }
  /* What must be read first: lit, so nobody passes it by */
  .jn-must { margin-top: 10px; padding: 20px 22px 22px; border-radius: 14px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; text-align: left;
    background: linear-gradient(180deg, rgba(255, 227, 163, .1), rgba(255, 227, 163, .04)); box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .55), 0 18px 40px -26px rgba(255, 214, 140, .5); }
  .jn-must-k { display: inline-flex; align-items: center; gap: 10px; color: var(--ember); font-size: 10px; letter-spacing: .26em; }
  .jn-must-k i { width: 8px; height: 8px; transform: rotate(45deg); border-radius: 1.5px; background: var(--ember); }
  .jn-must p { margin: 0; font-family: var(--serif); font-size: 19px; line-height: 1.5; color: #E6DFD0; }
  .jn-must b { font-weight: 600; color: var(--bone); }
  .jn-must-go { display: inline-flex; align-items: center; gap: 10px; margin-top: 2px; padding: 12px 20px; border-radius: 999px; background: var(--ember); color: #12160F;
    font-family: var(--sans); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; transition: background-color .3s, transform .4s var(--ease, ease); }
  .jn-must-go:hover { background: var(--bone); transform: translateY(-1px); }
  .jn-must-paper { margin-top: 44px; width: 100%; max-width: 760px; align-items: center; text-align: center; padding: 28px 30px 30px;
    background: #2A2017; box-shadow: inset 0 0 0 1px rgba(255, 227, 163, .5), 0 26px 50px -30px rgba(42, 32, 23, .8); }
  .jn-must-paper p { max-width: 600px; font-size: 20px; }
  .jn-must-paper { margin-top: 64px; gap: 14px; padding: 36px 34px 34px; }
  .jn-must-h { margin: 2px 0 0; font-family: var(--serif); font-weight: 400; font-size: 44px; line-height: 1.05; color: var(--bone); }
  .jn-must-n { font-size: 16.5px; color: #A9A294; }
  /* A short screen (a laptop): the Fellowship's section still fits without scrolling */
  @media (min-width: 901px) and (max-height: 820px) {
    #fellowship { padding-top: 22px; padding-bottom: 22px; }
    #fellowship .jn-path-text { gap: 10px; }
    #fellowship .h2 { font-size: 40px; }
    #fellowship .jn-path-text > .it { font-size: 18px; }
    #fellowship .jn-list { gap: 7px; }
    #fellowship .jn-list li { font-size: 17px; line-height: 1.35; }
    #fellowship .jn-must { padding: 14px 18px 16px; gap: 9px; margin-top: 6px; }
    #fellowship .jn-must p { font-size: 17.5px; line-height: 1.4; }
    #fellowship .jn-must-go { padding: 10px 16px; }
    #fellowship :global(.fs-card) { padding: 26px 32px; gap: 10px; }
    #fellowship :global(.fs-form) { gap: 13px; }
    #fellowship :global(.fs-h) { font-size: 44px; }
  }
  /* The Fellowship's section fits one screen: tighter measures, and it sits in the middle of the height it has */
  #fellowship { padding-top: clamp(40px, 7vh, 96px); padding-bottom: clamp(36px, 6vh, 88px); min-height: calc(100svh - 70px); display: flex; align-items: center; }
  #fellowship[hidden] { display: none; }
  #fellowship .jn-path-in { width: 100%; align-items: center; }
  #fellowship .jn-path-text { gap: 14px; }
  #fellowship .h2 { font-size: clamp(38px, 3.6vw, 52px); }
  #fellowship .jn-path-text > .it { font-size: 19px; }
  #fellowship .jn-list { margin-top: 4px; gap: 11px; }
  #fellowship .jn-list li { font-size: 18px; line-height: 1.4; }
  /* What is earned inside, on each door */
  .jn-earn { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; padding-top: 16px; border-top: 1px solid rgba(243, 236, 220, .14); }
  .jn-earn-row { display: flex; align-items: center; gap: 9px; }
  .jn-earn-row > span { line-height: 0; }
  .jn-earn-gap { margin-left: 10px; padding-left: 18px; border-left: 1px solid rgba(243, 236, 220, .18); }
  .jn-earn .lab { font-size: 9px; letter-spacing: .22em; color: #A9A294; }
  /* The way down to the form */
  .jn-down { margin-top: 56px; display: flex; flex-direction: column; align-items: center; gap: 16px; color: var(--oxblood); }
  .jn-down-o { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #2A2017; color: var(--bone); transition: transform .5s cubic-bezier(.16, 1, .3, 1), background-color .3s; }
  .jn-down-o svg { animation: jn-nod 2.4s ease-in-out infinite; }
  .jn-down:hover .jn-down-o { transform: translateY(4px); background: var(--oxblood); }
  @keyframes jn-nod { 0%, 100% { transform: translateY(-2px); } 50% { transform: translateY(3px); } }
  @media (prefers-reduced-motion: reduce) { .jn-down-o svg { animation: none; } }

  @media (max-width: 900px) {
    .jn { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; min-height: calc(100svh - 0px); }
    .jn-door + .jn-door { box-shadow: inset 0 1px 0 rgba(255, 227, 163, .25); }
    .jn-door { min-height: 50svh; }
    .jn-f .jn-veil { background: linear-gradient(180deg, rgba(6, 8, 6, .55) 0%, rgba(6, 8, 6, .7) 40%, rgba(6, 8, 6, .95) 75%, #060806 100%); }
    .jn-in { padding: 90px 22px 30px; gap: 8px; }
    .jn-g .jn-in { padding-top: 46px; }
    .jn-t { font-size: 40px; }
    .jn-line { font-size: 18px; }
    .jn-pts { font-size: 15.5px; gap: 4px; }
    .jn-go { margin-top: 10px; padding: 13px 20px; font-size: 9.5px; }
    .jn-or { width: 44px; height: 44px; font-size: 9px; }
    .jn-path-in { grid-template-columns: 1fr; gap: 34px; }
    .jn-vet { padding-top: 64px; padding-bottom: 56px; }
    .jn-steps { grid-template-columns: 1fr; gap: 26px; margin-top: 40px; text-align: left; }
    .jn-steps::before { top: 10px; bottom: 30px; left: 22px; right: auto; width: 1px; height: auto; }
    .jn-steps li { display: grid; grid-template-columns: 46px minmax(0, 1fr); column-gap: 18px; row-gap: 4px; align-items: start; }
    .jn-steps .num { grid-row: 1 / span 2; width: 46px; height: 46px; font-size: 22px; margin: 0; box-shadow: inset 0 0 0 1px var(--brass), 0 0 0 6px var(--paper); }
    .jn-steps b { font-size: 21px; align-self: end; }
    .jn-steps span:last-child { font-size: 16px; max-width: none; text-wrap: pretty; }
    .jn-must { padding: 18px 18px 20px; }
    .jn-must p { font-size: 17.5px; }
    .jn-must-paper { margin-top: 40px; padding: 28px 20px 28px; }
    .jn-must-h { font-size: 32px; }
    .jn-must-paper p { font-size: 18px; }
    #fellowship { display: block; min-height: 0; padding-top: 56px; padding-bottom: 56px; }
    #fellowship[hidden] { display: none; }
    .jn-earn { margin-top: 8px; padding-top: 12px; gap: 8px; }
    .jn-earn-row { gap: 6px; }
    .jn-earn-row :global(svg) { width: 34px; height: 34px; }
    .jn-earn-gap { margin-left: 6px; padding-left: 12px; }
    .jn-earn .lab { font-size: 8px; }
    .jn-down { margin-top: 44px; }
    .jn-list li { font-size: 17px; }
  }
</style>
