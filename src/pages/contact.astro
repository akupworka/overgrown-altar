---
// Contact — converted from the design file Contact.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import DoorwayFrame from '../components/DoorwayFrame.astro';
---
<BaseLayout title="Contact">
<section class="hero" style="height:620px"><img src="/images/watchtower-photo.jpg" srcset="/images/watchtower-photo-1200.jpg 1200w, /images/watchtower-photo.jpg 2576w" sizes="100vw" alt="Write to Us" style="object-position:30% 50%;filter:brightness(.5)" fetchpriority="high" /><div class="veil"></div><SiteNav />
<div class="hero-c" style="top:223px;padding:0 24px"><span class="eb">Contact</span><h1 class="h1" style="margin-top:22px">Write to Us</h1><p class="it" style="margin:24px 0 0;max-width:680px;font-size:26px;line-height:1.4;color:#E6DFD0">Letters, submissions and press. Every letter is read.</p></div></section>
<!-- data-netlify="true": Netlify collects each letter and can email it to you (Netlify > Forms > Notifications). -->
<DoorwayFrame kicker="Correspondence" title="Write a letter." image="/images/window-light-on-wall-1200.jpg" lead="Every letter is read, and most are answered.">
<form name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="company" class="dw-form">
<input type="hidden" name="form-name" value="contact" />
<p class="visually-hidden"><label>Leave this empty <input name="company" tabindex="-1" /></label></p>
<label class="dw-field"><span class="dw-label">Your name</span><span class="dw-line-row"><input name="name" autocomplete="name" required /></span></label>
<label class="dw-field"><span class="dw-label">Email</span><span class="dw-line-row"><input type="email" name="email" autocomplete="email" required /></span></label>
<fieldset class="dw-topics"><legend class="visually-hidden">What is this about?</legend><label class="dw-topic"><input type="radio" name="topic" value="A letter" checked />A letter</label><label class="dw-topic"><input type="radio" name="topic" value="Submission" />Submission</label><label class="dw-topic"><input type="radio" name="topic" value="Press" />Press</label><label class="dw-topic"><input type="radio" name="topic" value="Folios" />Folios</label></fieldset>
<label class="dw-field"><span class="dw-label">Your letter</span><span class="dw-line-row"><textarea name="message" rows="4" required></textarea></span></label>
<button class="dw-send" type="submit">Send the letter <span aria-hidden="true">→</span></button>
</form>
<Fragment slot="foot">Or write directly: <a href="mailto:hello@overgrownaltar.com">hello@overgrownaltar.com</a><a href="https://instagram.com/overgrownaltar" rel="noopener">Instagram</a><br />For Guild applications, use the <a href="/guild/">Guild page</a>.</Fragment>
</DoorwayFrame>
</BaseLayout>
