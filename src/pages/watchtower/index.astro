---
// The Watchtower — converted from the design file Watchtower.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import MatrixRow from '../../components/MatrixRow.astro';
import { getArticles, getMatrix, articleUrl, kind, imgSrc, imgPos, formatDate, readingTime } from '../../lib/sanity';

// Everything below comes from Sanity.
const dispatches = await getArticles('watchtower');
const matrix = await getMatrix();
// Featured: the most recent dispatch.
const featured = [...dispatches].sort((a, b) => (b.publishedAt ?? '').localeCompare(a.publishedAt ?? ''))[0];
// The archive: dispatches that aren't already in the matrix above it.
const archive = dispatches.filter((d) => !d.inMatrix);
---
<BaseLayout title="The Watchtower">
<section class="hero pill-h"><img src="/images/pillar-watchtower.jpg" srcset="/images/pillar-watchtower-1200.jpg 1200w, /images/pillar-watchtower.jpg 2576w" sizes="100vw" alt="The Watchtower" style="object-position:20% 30%;" class="mono" fetchpriority="high" /><div class="veil-l"></div><SiteNav />
<div class="pill-in"><span class="eb">01 · Prophetic Audits</span><h1 class="h1" style="text-transform:uppercase;letter-spacing:.04em">The Watchtower</h1><p class="body" style="color:#E6DFD0;max-width:720px">Long-form dispatches and cultural essays unmasking psychological scripts, secular idols (from Freud and Bukowski to modern digital posturing), and Leviathan structures in art and philosophy.</p></div></section>
{featured && (
<section class="sec paper"><div class="g2" style="align-items:center"><a href={articleUrl(featured)} class="arch" style="height:640px;display:block"><img src={imgSrc(featured.image, 1200)} alt={featured.image?.alt ?? ''} style={`object-position:${imgPos(featured.image, '45% 40%')}`} loading="lazy" /></a>
<div style="display:flex;flex-direction:column;gap:22px"><span class="eb">Featured · {kind(featured)}</span><h2 class="h2" style="font-size:58px">{featured.title}</h2>
<p class="body mut">{featured.standfirst}</p>
<span class="lab mut">{formatDate(featured.publishedAt)}</span><a class="btn" href={articleUrl(featured)} style="align-self:flex-start">Read the dispatch</a></div></div></section>
)}
<section class="sec dark"><div class="row" style="padding-bottom:30px"><div style="display:flex;flex-direction:column;gap:16px"><span class="eb">Foundational Dispatches</span><h2 class="h2">The Editorial Matrix</h2></div></div>{matrix.map((m) => <MatrixRow article={m} />)}</section>
<section class="sec paper"><div class="row" style="padding-bottom:30px"><h2 class="h2">The archive</h2><div class="lab mut" style="display:flex;flex-wrap:wrap;gap:14px 28px"><span style="border-bottom:1px solid #2A2017">All</span><span>Philosophy</span><span>Psychology</span><span>Science</span><span>Art</span></div></div>
<div class="g3">{archive.map((d) => (
<a href={articleUrl(d)} class="card" style="display:flex;flex-direction:column;gap:14px"><div class="tile" style="height:300px"><img src={imgSrc(d.image, 900)} alt="" style={`object-position:${imgPos(d.image)}`} loading="lazy" /></div><span class="lab" style="color:#62372D">{kind(d)}</span><span class="h3" style="font-size:30px">{d.title}</span><span class="it mut" style="font-size:19px">{d.standfirst}</span></a>
))}</div></section>
<Subscribe />
</BaseLayout>
