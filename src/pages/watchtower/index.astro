---
// The Watchtower: the dispatches, laid out like a journal's blog section.
//   - a short header, so the writing starts right away
//   - the latest dispatch, large
//   - every other dispatch below it, newest first
//   - a sidebar: search, where to start, browse by thinker, get the letter
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import Avatar from '../../components/Avatar.astro';
import DispatchList, { type DispatchItem } from '../../components/DispatchList.astro';
import { guildPillar, guildUrl, MEDIUM_LABEL, readingMinutes } from '../../lib/guild';

// Every dispatch. Sample content from the design, with placeholder dates,
// until Sanity supplies the real ones (then this list comes from your Studio).
const author = { name: 'Ainslie Willson' };
const all: (DispatchItem & { n: number })[] = [
  { n: 1, title: 'Nietzsche Surrendered: The Übermensch at the Foot of the Cross', date: '2026-09-22', minutes: 12, image: 'format-dispatches', imagePos: '45% 40%',
    standfirst: 'Nietzsche correctly diagnosed the spiritual rot of modern society, but his solution was an exercise in human pride that collapsed into madness.' },
  { n: 2, title: 'Jung vs. Tolkien: The Counterfeit Unconscious vs. Myth Realized', date: '2026-09-29', image: 'window-of-the-ascension-and', imagePos: 'center 40%',
    standfirst: 'Jung found the old myths in the depths of the psyche. Tolkien knew the True Myth had stepped into history.' },
  { n: 3, title: 'Newtonian Determinism: The Missing Anchor', date: '2026-10-06', image: 'folios-photo-2',
    standfirst: 'A universe of perfect laws, and no Lawgiver to keep them. Where the clockwork worldview runs down.' },
  { n: 4, title: 'The Resurrection as the Primary Quantum Law', date: '2026-10-13', image: 'folios-photo',
    standfirst: 'Decay is not the deepest law of the universe. The empty tomb is.' },
  { n: 5, title: 'Freud’s Couch and the Confessional', date: '2026-10-20', image: 'watchtower-photo',
    standfirst: 'The talking cure found the wound. It could not pronounce the absolution.' },
  { n: 6, title: 'Bukowski and the Liturgy of Despair', date: '2026-10-27', image: 'what-we-believe',
    standfirst: 'A poet who worshipped his own ruin, and the grace he kept walking past.' },
  { n: 7, title: 'The Algorithm as Idol', date: '2026-11-03', image: 'watchtower-photo-2',
    standfirst: 'Digital posturing, the curated self, and the God who sees in secret.' },
].map((d: any) => ({ ...d, href: '/watchtower/nietzsche-surrendered', kicker: `Dispatch ${d.n}`, author, image: `/images/${d.image}-1200.jpg` }));

// Dispatches published from the Guild Desk join the list.
const fromGuild: DispatchItem[] = (await guildPillar('watchtower')).map((g) => ({
  href: guildUrl(g), title: g.title, kicker: MEDIUM_LABEL[g.medium] ?? 'Dispatch', standfirst: g.standfirst,
  date: g.published_at.slice(0, 10), minutes: readingMinutes(g.body),
  author: { name: g.author.display_name, portrait: g.author.portrait || undefined }, image: g.image || '/images/watchtower-photo-1200.jpg',
}));
const newestFirst = [...all, ...fromGuild].sort((a, b) => b.date.localeCompare(a.date));
const latest = newestFirst[0];
const rest = newestFirst.slice(1);

// "Start here": the four foundational dispatches of the Editorial Matrix.
const foundations = [
  { n: 1, title: 'Nietzsche Surrendered', thinker: 'Will to Power', anchor: 'Surrender & Divine Authority' },
  { n: 2, title: 'Jung vs. Tolkien', thinker: 'The Archetypal Psyche', anchor: 'The True Myth Made Flesh' },
  { n: 3, title: 'Newtonian Determinism', thinker: 'Newtonian Mechanics', anchor: 'Colossians 1:17 Coherence' },
  { n: 4, title: 'The Resurrection as the Primary Quantum Law', thinker: 'Quantum Paradox', anchor: 'Resurrection Re-encryption' },
];
const thinkers = ['Nietzsche', 'Jung', 'Freud', 'Bukowski', 'Newton', 'Quantum'];
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="The Watchtower" description="Long-form dispatches and cultural essays from Overgrown Altar.">
  <section class="hero wt-hero">
    <img src="/images/duomo-pigeons.jpg" srcset="/images/duomo-pigeons-1200.jpg 1200w, /images/duomo-pigeons.jpg 2000w" sizes="100vw"
      alt="Pigeons rising in front of a Gothic cathedral facade" style="object-position:center 35%;" class="mono" fetchpriority="high" />
    <div class="veil-l"></div>
    <SiteNav />
    <div class="pill-in wt-in">
      <span class="eb">01 · Prophetic Audits</span>
      <h1 class="h1" style="text-transform:uppercase;letter-spacing:.04em">The Watchtower</h1>
      <p class="body" style="color:#E6DFD0;max-width:640px">Long-form dispatches and cultural essays unmasking psychological scripts, secular idols, and Leviathan structures in art and philosophy.</p>
    </div>
  </section>

  <section class="paper blog">
    <div class="blog-grid">
      <div class="blog-main">
        <!-- The latest dispatch -->
        <article class="latest">
          <a class="latest-img" href={latest.href}><img src={latest.image} alt="" style={latest.imagePos ? `object-position:${latest.imagePos}` : undefined} /></a>
          <div class="latest-text">
            <span class="eb">Latest · {latest.kicker}</span>
            <h2 class="h2 latest-title"><a href={latest.href}>{latest.title}</a></h2>
            <p class="body mut latest-sum">{latest.standfirst}</p>
            <div class="latest-by">
              <Avatar name={latest.author.name} src={latest.author.portrait} size={34} />
              <span class="lab mut">{latest.author.name} · <time datetime={latest.date}>{fmt(latest.date)}</time></span>
            </div>
            <a class="btn" href={latest.href}>Read the dispatch</a>
          </div>
        </article>

        <!-- Everything else, newest first -->
        <div class="list-head">
          <h2 class="eb">Earlier dispatches</h2>
          <span class="lab mut">{rest.length} pieces · newest first</span>
        </div>
        <DispatchList items={rest} />
      </div>

      <aside class="blog-side" aria-label="Find more dispatches">
        <form class="side-block" action="/archive" method="get" role="search">
          <label class="eb" for="wt-search">Search the dispatches</label>
          <input id="wt-search" class="field" type="search" name="q" placeholder="A thinker, a title, a word…" />
        </form>

        <div class="side-block">
          <h2 class="eb">Start here</h2>
          <p class="it mut side-note">The four foundational dispatches: where each great mind fractured, and the anchor that holds.</p>
          <ol class="found">
            {foundations.map((f) => (
              <li>
                <a href="/watchtower/nietzsche-surrendered">
                  <span class="num found-n">{f.n}</span>
                  <span class="found-t"><span class="found-title">{f.title}</span><span class="found-sub">{f.thinker} → {f.anchor}</span></span>
                </a>
              </li>
            ))}
          </ol>
        </div>

        <div class="side-block">
          <h2 class="eb">Browse by thinker</h2>
          <div class="filters">
            {thinkers.map((t) => <a class="chip" href={`/archive?q=${t.toLowerCase()}`}>{t}</a>)}
          </div>
        </div>

        <a class="side-block side-letter" href="#letter">
          <span class="eb">Receive the dispatches</span>
          <span class="it">New essays delivered as a letter. →</span>
        </a>
      </aside>
    </div>
  </section>

  <div id="letter"><Subscribe /></div>
</BaseLayout>

<style>
  /* A shorter header, so the writing starts right away. */
  .wt-hero { height: 560px; }
  .wt-in { bottom: 80px; }

  .blog { padding: 96px 120px 120px; }
  .blog-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 80px; align-items: start; }

  /* The latest dispatch */
  .latest { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px; align-items: center; padding-bottom: 56px; }
  .latest-img { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 999px 999px 0 0; box-shadow: 0 0 0 1px var(--brass); }
  .latest-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease, ease); }
  .latest-img:hover img { transform: scale(1.04); }
  .latest-text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .latest-title { font-size: 46px; line-height: 1.04; }
  .latest-title a:hover { color: var(--oxblood); }
  .latest-sum { font-size: 20px; }
  .latest-by { display: flex; align-items: center; gap: 12px; }

  .list-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px; padding-bottom: 14px; }
  .list-head > * { white-space: nowrap; }
  .list-head .eb { margin: 0; }

  /* Sidebar: stays in view on desktop */
  .blog-side { position: sticky; top: 110px; display: flex; flex-direction: column; gap: 36px; }
  .side-block { display: flex; flex-direction: column; gap: 14px; }
  .side-block .eb { margin: 0; }
  .side-block .field { width: 100%; font-size: 18px; padding: 14px 16px; }
  .side-note { margin: 0; font-size: 17px; line-height: 1.45; }
  .found { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(42, 32, 23, .2); }
  .found li { border-bottom: 1px solid rgba(42, 32, 23, .14); }
  .found a { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 14px 0; }
  .found-n { font-size: 30px !important; color: var(--oxblood); }
  .found-t { display: flex; flex-direction: column; gap: 4px; }
  .found-title { font-family: var(--serif); font-style: italic; font-size: 19px; line-height: 1.2; transition: color .3s; }
  .found-sub { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted-paper); line-height: 1.5; }
  .found a:hover .found-title { color: var(--oxblood); }
  .side-block .chip { display: inline-flex; align-items: center; text-decoration: none; }
  .side-block .chip:hover { background: var(--ink); color: var(--bone); border-color: var(--ink); }
  .side-letter { padding: 22px 24px; background: #F1ECE2; box-shadow: inset 0 0 0 1px rgba(42, 32, 23, .15); transition: box-shadow .3s; }
  .side-letter:hover { box-shadow: inset 0 0 0 1px var(--oxblood); }
  .side-letter .it { font-size: 18px; }

  @media (max-width: 1100px) {
    .blog { padding: 80px 48px 100px; }
    .blog-grid { grid-template-columns: minmax(0, 1fr); gap: 64px; }
    .blog-side { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  }
  @media (max-width: 700px) {
    .wt-hero { height: 460px; }
    .wt-in { bottom: 40px; }
    .blog { padding: 48px 24px 72px; }
    .latest { grid-template-columns: minmax(0, 1fr); gap: 22px; padding-bottom: 40px; }
    .latest-img { aspect-ratio: 16 / 10; border-radius: 0; }
    .latest-title { font-size: 30px !important; }
    .latest-sum { font-size: 17px !important; }
    .latest .btn { align-self: stretch; text-align: center; }
    .blog-side { grid-template-columns: minmax(0, 1fr); gap: 36px; }
  }
</style>
