---
// The Watchtower: the dispatches, laid out like a journal's blog section.
//   - the header, with how many dispatches and writers
//   - the three newest dispatches under arched windows, then six more ("Also new")
//   - how a dispatch works: Thinker, Fracture, Anchor
//   - a line from the newest dispatches, set large
//   - every earlier dispatch, with a search that filters as you type
//   - the writers of The Watchtower, and an invitation to write for it
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Subscribe from '../../components/Subscribe.astro';
import Avatar from '../../components/Avatar.astro';
import DispatchList, { type DispatchItem } from '../../components/DispatchList.astro';
import { inPillar } from '../../lib/catalog';
import { authorUrl, guildPillar, type GuildAuthor } from '../../lib/guild';

// Every dispatch: real pieces only (the design's complete essay, plus pieces published at the Guild Desk).
const newestFirst: DispatchItem[] = await inPillar('watchtower');
// A dispatch without a picture of its own wears one of the house's photographs. They take turns (counted from the oldest,
// so a piece keeps its picture as newer ones arrive) and no two neighbours on the page share one.
const ROOM_PHOTO = '/images/watchtower-photo-1200.jpg';
const HOUSE = [ROOM_PHOTO, '/images/tall-windows-dark-vault-1200.jpg', '/images/duomo-spires-1200.jpg', '/images/what-we-believe-1200.jpg', '/images/labyrinth-stained-light-1200.jpg',
  '/images/cathedral-facade-and-rose-window-1200.jpg', '/images/format-guild-1200.jpg', '/images/manifesto-photo-1200.jpg', '/images/duomo-pigeons-1200.jpg'];
[...newestFirst].reverse().filter((d) => d.image === ROOM_PHOTO).forEach((d, i) => { d.image = HOUSE[i % HOUSE.length]; });
const newest = newestFirst.slice(0, 3);           // the three newest, under arched windows
const alsoNew = newestFirst.slice(3, 9);           // six more, as an index in words: the day, the title, its line, the writer
const rest = newestFirst.slice(9);                 // everything earlier, as a searchable list

// The writers of The Watchtower.
const guildPieces = await guildPillar('watchtower');
const writers = [...new Map(guildPieces.map((g) => [g.author.id, g.author] as [string, GuildAuthor])).values()].slice(0, 8);
// The line set large between the dispatches is the journal's own, and always the same: where every dispatch ends.
// (It is not lifted from a piece: whatever happens to be newest should not get to speak for the whole room.)
const pull = { text: 'The same truth holds again, whole, in the resurrection of Christ.', from: 'The Anchor', href: '/manifesto' };

const day = (d: string) => String(new Date(d).getUTCDate()).padStart(2, '0');
const mon = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="The Watchtower" description="Long-form dispatches and cultural essays from Overgrown Altar.">
  <section class="hero wt-hero">
    <img src="/images/duomo-pigeons.jpg" srcset="/images/duomo-pigeons-1200.jpg 1200w, /images/duomo-pigeons.jpg 2000w" sizes="100vw"
      alt="Pigeons rising in front of a Gothic cathedral facade" style="object-position:center 35%;" class="mono" fetchpriority="high" />
    <div class="veil-l"></div>
    <SiteNav />
    <div class="pill-in wt-in">
      <span class="eb">01 · Prophetic Audits</span>
      <h1 class="h1" style="text-transform:uppercase;letter-spacing:.04em">The Watchtower</h1>
      <p class="body" style="color:#E6DFD0;max-width:640px">Long-form dispatches and cultural essays unmasking psychological scripts, secular idols, and Leviathan structures in art and philosophy.</p>
      <span class="lab wt-stats">{newestFirst.length} {newestFirst.length === 1 ? 'dispatch' : 'dispatches'}{writers.length ? ` · ${writers.length} ${writers.length === 1 ? 'writer' : 'writers'}` : ''}</span>
    </div>
  </section>

  <section class="paper blog">
    <div class="blog-col">
      {!newest.length && <p class="it mut" style="font-size:22px;margin:0">The first dispatches are being written.</p>}
      <!-- The three newest dispatches -->
      {newest.length > 0 && (
        <div class="newest">
          <h2 class="eb newest-h">The newest</h2>
          <div class="newest-grid">
            {newest.map((d, i) => (
              <article class:list={['nw', { 'nw-first': i === 0 }]}>
                <a class="nw-img" href={d.href} aria-label={d.title} tabindex="-1"><img src={d.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} style={d.imagePos ? `object-position:${d.imagePos}` : undefined} /></a>
                <span class="lab nw-k">{i === 0 ? 'Latest · ' : ''}{d.kicker}</span>
                <h3 class="nw-t"><a href={d.href}>{d.title}</a></h3>
                {d.standfirst && <p class="it nw-sf">{d.standfirst}</p>}
                <div class="nw-by">
                  {d.author.href
                    ? <a class="latest-who" href={d.author.href}><Avatar name={d.author.name} src={d.author.portrait} size={28} id={d.author.id} /><span class="lab mut">{d.author.name}</span></a>
                    : <span class="latest-who"><Avatar name={d.author.name} src={d.author.portrait} size={28} /><span class="lab mut">{d.author.name}</span></span>}
                  <span class="lab mut"><span class="nw-dot">· </span><time datetime={d.date}>{fmt(d.date)}</time></span>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}

      <!-- Also new: six more -->
      {alsoNew.length > 0 && (
        <div class="also">
          <h2 class="eb also-h">Also new</h2>
          <div class="also-grid">
            {alsoNew.map((d) => (
              <a class="also-card" href={d.href}>
                <time class="also-date" datetime={d.date}><b>{day(d.date)}</b><span class="lab">{mon(d.date)}</span></time>
                <span class="also-text">
                  <span class="lab also-k">{d.kicker.replace(/^The Watchtower · /, '')}{d.minutes ? ` · ${d.minutes} min` : ''}</span>
                  <span class="also-t">{d.title}</span>
                  {d.standfirst && <span class="it also-sf">{d.standfirst}</span>}
                  <span class="lab mut also-by">{d.author.name}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- How a dispatch works -->
  <section class="sec dark method">
    <div class="method-head">
      <span class="eb">The method</span>
      <h2 class="h2">How a dispatch works</h2>
      <p class="it method-lead">Every dispatch takes one great secular mind seriously, then follows the truth they held to where it holds whole.</p>
    </div>
    <ol class="method-steps">
      <li><span class="num">I</span><span class="method-k">The Thinker</span><span class="method-d">A great secular mind, and the real piece of truth they held: Nietzsche, Jung, Freud, Bukowski, Newton.</span></li>
      <li><span class="num">II</span><span class="method-k">The Fracture</span><span class="method-d">Where that insight broke, for lack of a divine keystone, and what it cost those who followed it.</span></li>
      <li><span class="num">III</span><span class="method-k">The Anchor</span><span class="method-d">How the same truth holds again, whole, in the resurrection of Christ.</span></li>
    </ol>
  </section>

  <!-- The journal's own line, set large -->
  <section class="hero wt-pull">
    <img src="/images/labyrinth-stained-light-1200.jpg" alt="" loading="lazy" aria-hidden="true" />
    <div class="veil"></div>
    <figure class="wt-pull-in">
      <blockquote class="big-it">{pull.text}</blockquote>
      <figcaption class="lab"><a href={pull.href}>{pull.from}</a></figcaption>
    </figure>
  </section>

  <section class="paper blog blog-2">
    <div class="blog-col">
      <!-- Every earlier dispatch, newest first, with a search that filters as you type -->
      {rest.length > 0 && (<>
      <div class="list-head">
        <div class="list-title"><h2 class="eb">Earlier dispatches</h2><span class="lab mut wt-count">{rest.length} {rest.length === 1 ? 'piece' : 'pieces'} · newest first</span></div>
        <label class="wt-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span class="visually-hidden">Search the dispatches</span>
          <input type="search" placeholder="Search the dispatches" autocomplete="off" />
        </label>
      </div>
      <div class="wt-list"><DispatchList items={rest} live={{ pillar: 'watchtower' }} paged={10} /></div>
      <p class="it mut wt-none" hidden>No dispatch matches that. Try another word, or <a href="/archive">search everything</a>.</p>
      </>)}
      {rest.length === 0 && <p class="it mut wt-first">The next dispatches are being written at the watch. <a href="#subscribe">Receive them as they go up →</a></p>}

      <!-- The writers, and an open invitation -->
      <div class="wt-write">
        <div class="wt-write-text">
          <span class="eb">Write for The Watchtower</span>
          <h2 class="h2 wt-write-h">Name the thinker. Find the fracture. Set the anchor.</h2>
          <p class="it mut wt-write-p">The Watchtower takes essays and dispatches, 1,500 to 5,000 words. Every piece is read by the editor before it is published.</p>
          <a class="lab wt-forms" href="/crafts/#watchtower">What we look for in a dispatch →</a>
          <div class="wt-write-cta">
            <a class="btn" href="/guild/desk/#write" data-member hidden>Write a dispatch</a>
          </div>
        </div>
        {writers.length > 0 && (
          <div class="wt-writers">
            <span class="lab mut">The writers</span>
            <div class="wt-writers-row">
            {writers.map((w) => (
              <a class="wt-writer" href={authorUrl(w)}>
                <Avatar name={w.display_name} src={w.portrait || undefined} size={44} id={w.id} />
                <span><span class="wt-writer-n">{w.display_name}</span>{w.craft && <span class="lab mut wt-writer-c">{w.craft}</span>}</span>
              </a>
            ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <div id="letter"><Subscribe /></div>
</BaseLayout>

<script>
  // Type to narrow the list: matches the title, summary, kicker and writer.
  const input = document.querySelector<HTMLInputElement>('.wt-search input');
  const rows = [...document.querySelectorAll<HTMLElement>('.wt-list li')];
  const none = document.querySelector<HTMLElement>('.wt-none');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    rows.forEach((r) => { const on = !q || (r.textContent ?? '').toLowerCase().includes(q); r.hidden = !on; if (on) n++; });
    if (none) none.hidden = n > 0;
  });
</script>

<style>
  /* A shorter header, so the writing starts right away. */
  .wt-hero { height: 560px; }
  .wt-in { bottom: 80px; }

  .blog { padding: 96px 48px 120px; }
  .blog-col { max-width: 1040px; margin: 0 auto; }

  /* The latest dispatch */
  .latest { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px; align-items: center; padding-bottom: 56px; }
  .latest-img { display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 999px 999px 0 0; box-shadow: 0 0 0 1px var(--brass); }
  .latest-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease, ease); }
  .latest-img:hover img { transform: scale(1.04); }
  .latest-text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .latest-title { font-size: 46px; line-height: 1.04; }
  .latest-title a:hover { color: var(--oxblood); }
  .latest-sum { font-size: 20px; }
  .latest-by { display: flex; align-items: center; gap: 12px; }

  .list-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px; padding-bottom: 14px; }
  .list-head > * { white-space: nowrap; }
  .list-head .eb { margin: 0; }

  .wt-stats { margin-top: 6px; color: var(--ember); }

  /* The three newest: arched windows side by side */
  .newest { padding-bottom: 64px; }
  .newest-h { margin: 0 0 28px; }
  .newest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; align-items: start; }
  .nw { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .nw-img { display: block; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 999px 999px 0 0; box-shadow: 0 0 0 1px var(--brass); margin-bottom: 8px; }
  .nw-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease, ease); }
  .nw-img:hover img { transform: scale(1.04); }
  .nw-k { color: var(--oxblood); font-size: 10px; }
  .nw-t { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 30px; line-height: 1.1; }
  .nw-t a:hover { color: var(--oxblood); }
  .nw-sf { margin: 0; font-size: 18px; line-height: 1.45; color: var(--muted-paper); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .nw-by { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 2px; }
  .nw-by .lab { font-size: 9.5px; white-space: nowrap; }

  /* Also new: an index in words under the three arches. The day stands in the margin; the title leads; two to a row on a computer. */
  .also { padding-top: 8px; border-top: 1px solid rgba(42, 32, 23, .25); }
  .also-h { margin: 26px 0 8px; }
  .also-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 80px; }
  .also-card { display: grid; grid-template-columns: 62px minmax(0, 1fr); column-gap: 22px; align-items: start; padding: 30px 0 32px; border-top: 1px solid rgba(42, 32, 23, .14); }
  .also-card:nth-child(-n+2) { border-top: 0; }
  .also-date { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding-top: 2px; color: var(--oxblood); }
  .also-date b { font-family: var(--serif); font-weight: 400; font-size: 44px; line-height: .86; letter-spacing: -.01em; }
  .also-date .lab { font-size: 9px; letter-spacing: .26em; color: var(--muted-paper); }
  .also-text { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  .also-k { color: var(--oxblood); font-size: 9px; letter-spacing: .22em; }
  .also-t { font-family: var(--serif); font-style: italic; font-size: 31px; line-height: 1.1; transition: color .3s; text-wrap: balance;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .also-card:hover .also-t { color: var(--oxblood); }
  .also-sf { font-size: 18px; line-height: 1.45; color: var(--muted-paper); text-wrap: pretty; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .also-by { font-size: 9.5px; margin-top: 3px; }
  .nw-sf { text-wrap: pretty; min-height: calc(2 * 1.45em); }

  /* The method */
  .method { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .method-head { display: flex; flex-direction: column; align-items: center; gap: 16px; max-width: 720px; }
  .method-lead { margin: 0; font-size: 22px; line-height: 1.45; color: var(--muted-dark); }
  .method-steps { list-style: none; margin: 56px 0 0; padding: 0; width: 100%; max-width: 1100px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .method-steps li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 0 30px; }
  .method-steps li + li { border-left: 1px solid rgba(243, 236, 220, .14); }
  .method-steps li + li::before { content: '→'; position: absolute; left: -10px; top: 14px; color: var(--brass); font-size: 16px; background: #0A0C0A; padding: 2px 0; }
  .method-steps .num { font-size: 48px; line-height: 1; }
  .method-k { font-family: var(--serif); font-size: 28px; }
  .method-d { font-family: var(--serif); font-size: 18px; line-height: 1.5; color: var(--muted-dark); max-width: 300px; }
  .method-go { margin-top: 52px; }

  /* The pull quote */
  .wt-pull { min-height: 440px; display: flex; align-items: center; justify-content: center; }
  .wt-pull > img { filter: brightness(.6); object-position: center 60%; }
  .wt-pull-in { position: relative; z-index: 1; margin: 0; padding: 80px 24px; max-width: 980px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 26px; }
  .wt-pull-in blockquote { margin: 0; font-size: clamp(44px, 4.4vw, 66px); line-height: 1.06; }
  .wt-pull-in figcaption { color: var(--ember); }
  .wt-pull-in figcaption a { border-bottom: 1px solid rgba(255, 227, 163, .4); }

  /* Write for The Watchtower */
  .blog-2 { padding-top: 80px !important; }
  .wt-write { margin-top: 80px; padding: 48px; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px; align-items: start;
    background: linear-gradient(180deg, #F1ECE2, #EDE6D9); box-shadow: inset 0 0 0 1px rgba(159, 148, 94, .45); border-radius: 4px; }
  .blog-2 .blog-col > .wt-write:first-child { margin-top: 0; }
  .wt-write-text { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .wt-write-h { font-size: 40px; line-height: 1.08; }
  .wt-write-p { margin: 0; font-size: 19px; line-height: 1.5; }
  .wt-write-cta { margin-top: 6px; }
  .wt-forms { color: var(--oxblood); border-bottom: 1px solid rgba(98,55,45,.35); padding-bottom: 3px; }
  .wt-write-cta [hidden] { display: none; }
  .wt-writers { display: flex; flex-direction: column; gap: 14px; padding-left: 40px; border-left: 1px solid rgba(42, 32, 23, .15); }
  .wt-writers-row { display: contents; }
  .wt-writer { display: flex; align-items: center; gap: 14px; }
  .wt-writer > span:last-child { display: flex; flex-direction: column; gap: 3px; }
  .wt-writer-n { font-family: var(--serif); font-size: 21px; transition: color .3s; }
  .wt-writer:hover .wt-writer-n { color: var(--oxblood); }
  .wt-writer-c { font-size: 9px; }

  .list-title { display: flex; flex-direction: column; gap: 8px; }
  .list-head { align-items: flex-end !important; padding-bottom: 18px !important; border-bottom: 0; }
  .wt-search { display: flex; align-items: center; gap: 10px; min-width: 280px; padding: 0 2px 8px; border-bottom: 1px solid rgba(42, 32, 23, .35); color: var(--muted-paper); transition: border-color .3s, color .3s; }
  .wt-search:focus-within { border-color: var(--oxblood); color: var(--oxblood); }
  .wt-search input { flex: 1; min-width: 0; background: none; border: 0; outline: none; padding: 6px 0; font-family: var(--serif); font-style: italic; font-size: 19px; color: var(--ink); }
  .wt-search input::placeholder { color: #8C8070; }
  .wt-list li[hidden] { display: none; }
  .wt-none { margin: 28px 0 0; font-size: 19px; }
  .wt-first { margin: 0 0 40px; font-size: 21px; }
  .wt-first a { color: var(--oxblood); border-bottom: 1px solid rgba(98, 55, 45, .35); }
  .wt-none a { border-bottom: 1px solid currentColor; }
  .latest-who { display: inline-flex; align-items: center; gap: 12px; }
  .latest-by { flex-wrap: wrap; row-gap: 6px; }
  .latest-by .lab { white-space: nowrap; }
  a.latest-who:hover .lab { color: var(--oxblood); }

  @media (max-width: 900px) and (min-width: 701px) { .newest-grid { gap: 26px 20px; } .nw-t { font-size: 24px; } .also-grid { column-gap: 44px; } .also-t { font-size: 26px; } }
  /* Phones: the newest full width, the next two side by side; Also new two to a row */
  @media (max-width: 700px) {
    /* the three newest, all the same: a small arch beside each title */
    .newest { padding-bottom: 40px; }
    .newest-h { margin-bottom: 18px; }
    .newest-grid { grid-template-columns: 1fr; gap: 0; }
    .nw { display: grid; grid-template-columns: 96px minmax(0, 1fr); column-gap: 16px; row-gap: 5px; align-items: start; padding: 18px 0; border-top: 1px solid rgba(42, 32, 23, .14); }
    .nw:first-child { border-top: 0; padding-top: 0; }
    .nw-img { grid-row: 1 / span 4; width: 96px; aspect-ratio: 4 / 5; margin: 0; }
    .nw-k { font-size: 8.5px; letter-spacing: .14em; }
    .nw-t { font-size: 21px; line-height: 1.15; }
    .nw-sf { font-size: 14.5px; -webkit-line-clamp: 2; }
    .nw-by :global(.avatar), .nw-dot { display: none; }
    .nw-by { flex-direction: column; align-items: flex-start; gap: 2px; }
    .nw-by .lab { font-size: 8.5px; }
  }
  @media (max-width: 700px) {
    .wt-hero { height: 460px; }
    .wt-in { bottom: 40px; }
    .blog { padding: 48px 24px 72px; }
    .latest { grid-template-columns: minmax(0, 1fr); gap: 22px; padding-bottom: 40px; }
    .latest-img { aspect-ratio: 5 / 6; }
    .latest-title { font-size: 30px !important; }
    .latest-sum { font-size: 17px !important; }
    .latest .btn { align-self: stretch; text-align: center; }
    .method-steps { grid-template-columns: 1fr; margin-top: 36px; }
    .method-steps li { padding: 26px 0; }
    .method-steps li + li { border-left: 0; border-top: 1px solid rgba(243, 236, 220, .14); }
    .method-steps li + li::before { content: '↓'; left: 50%; top: -12px; translate: -50% 0; padding: 0 8px; }
    .method-steps .num { font-size: 38px !important; }
    .method-k { font-size: 24px; }
    .method-d { font-size: 16px; }
    .method-lead { font-size: 18px; }
    .method-go { margin-top: 32px; text-align: center; }
    .wt-pull { min-height: 0; }
    .wt-pull-in { padding: 72px 24px; }
    .blog-2 { padding-top: 56px !important; }
    .wt-write { margin-top: 56px; padding: 30px 22px; grid-template-columns: 1fr; gap: 30px; }
    .wt-write-h { font-size: 28px !important; }
    .wt-write-p { font-size: 17px; }
    .wt-write-cta, .wt-write-cta .btn { align-self: stretch; text-align: center; width: 100%; }
    .wt-writers { padding-left: 0; padding-top: 24px; border-left: 0; border-top: 1px solid rgba(42, 32, 23, .15); }
    .list-head { flex-direction: column; align-items: stretch !important; gap: 18px !important; }
    .wt-search { min-width: 0; }
  }
  /* Phones: a shorter page. Four "Also new" (the rest are in the list below), the method as three tight rows,
     and the writers in one row you swipe. */
  @media (max-width: 700px) {
    .also-grid > .also-card:nth-child(n+5) { display: none; }
    .also-grid { grid-template-columns: 1fr; }
