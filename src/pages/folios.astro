---
// Folios — converted from the design file Folios.dc.html
// The page's shared look comes from src/styles/global.css.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
---
<BaseLayout title="Folios">
<section class="hero" style="height:760px"><img src="/images/faded-chapel-wall-with-a.jpg" srcset="/images/faded-chapel-wall-with-a-1200.jpg 1200w, /images/faded-chapel-wall-with-a.jpg 2680w" sizes="100vw" alt="Faded chapel wall with a Madonna niche" style="object-position:center 40%;filter:grayscale(1) contrast(1.12) brightness(.5)" class="mono" fetchpriority="high" /><div class="veil"></div><SiteNav />
<div class="hero-c" style="top:270px"><span class="eb">Archival print issues</span><h1 class="h1" style="margin-top:22px">Folios</h1><p class="it" style="margin:24px 0 0;max-width:620px;font-size:26px;line-height:1.4;color:#E6DFD0">The dispatches, the photographs and the work of the guild, bound and kept.</p></div></section>
<section class="sec paper"><div class="g3"><div style="display:flex;flex-direction:column;gap:16px"><div style="position:relative;aspect-ratio:3/4;background:#0B0D0A;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.35)"><img src="/images/folios-photo.jpg" srcset="/images/folios-photo-1200.jpg 1200w, /images/folios-photo.jpg 2200w" sizes="100vw" alt="" style="object-position:center;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55" loading="lazy" />
<div style="position:absolute;inset:18px;border:1px solid rgba(159,148,94,.7)"></div><div style="position:absolute;left:0;right:0;top:42px;display:flex;flex-direction:column;align-items:center;gap:10px;color:#F3ECDC"><span class="lab" style="font-size:9px">Overgrown Altar</span><span class="cg" style="font-size:96px;line-height:.9">I</span></div>
<span class="it" style="position:absolute;left:30px;right:30px;bottom:40px;text-align:center;font-size:26px;line-height:1.15;color:#F3ECDC">Built Without Tools of Pride</span></div>
<span class="lab" style="color:#62372D">Folio I</span><span class="h3" style="font-size:28px">Built Without Tools of Pride</span></div><div style="display:flex;flex-direction:column;gap:16px"><div style="position:relative;aspect-ratio:3/4;background:#0B0D0A;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.35)"><img src="/images/window-of-the-ascension-and.jpg" srcset="/images/window-of-the-ascension-and-1200.jpg 1200w, /images/window-of-the-ascension-and.jpg 1863w" sizes="100vw" alt="" style="object-position:center;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55" loading="lazy" />
<div style="position:absolute;inset:18px;border:1px solid rgba(159,148,94,.7)"></div><div style="position:absolute;left:0;right:0;top:42px;display:flex;flex-direction:column;align-items:center;gap:10px;color:#F3ECDC"><span class="lab" style="font-size:9px">Overgrown Altar</span><span class="cg" style="font-size:96px;line-height:.9">II</span></div>
<span class="it" style="position:absolute;left:30px;right:30px;bottom:40px;text-align:center;font-size:26px;line-height:1.15;color:#F3ECDC">The True Myth</span></div>
<span class="lab" style="color:#62372D">Folio II</span><span class="h3" style="font-size:28px">The True Myth</span></div><div style="display:flex;flex-direction:column;gap:16px"><div style="position:relative;aspect-ratio:3/4;background:#0B0D0A;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.35)"><img src="/images/folios-photo-2.jpg" srcset="/images/folios-photo-2-1200.jpg 1200w, /images/folios-photo-2.jpg 2576w" sizes="100vw" alt="" style="object-position:center;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55" loading="lazy" />
<div style="position:absolute;inset:18px;border:1px solid rgba(159,148,94,.7)"></div><div style="position:absolute;left:0;right:0;top:42px;display:flex;flex-direction:column;align-items:center;gap:10px;color:#F3ECDC"><span class="lab" style="font-size:9px">Overgrown Altar</span><span class="cg" style="font-size:96px;line-height:.9">III</span></div>
<span class="it" style="position:absolute;left:30px;right:30px;bottom:40px;text-align:center;font-size:26px;line-height:1.15;color:#F3ECDC">In Him All Things Hold Together</span></div>
<span class="lab" style="color:#62372D">Folio III</span><span class="h3" style="font-size:28px">In Him All Things Hold Together</span></div></div></section>
<section class="sec dark center"><span class="eb">Folio I</span><h2 class="h2" style="margin-top:16px">Reserve a copy</h2><p class="body mut" style="margin-top:18px;max-width:620px">Clothbound, around 160 pages, printed on uncoated archival paper in a numbered first edition. Price and release date announced to Dispatch readers first.</p><div style="margin-top:34px;display:flex;gap:14px;flex-wrap:wrap;justify-content:center"><span class="btn">Reserve Folio I</span><span class="ghost">Notify me of new folios</span></div></section>
</BaseLayout>
